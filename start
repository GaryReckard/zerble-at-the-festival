#!/bin/sh
set -eu

# Resolve from the launcher, so it also works when called from another folder.
cd "$(dirname "$0")"

if ! command -v npm >/dev/null 2>&1; then
  echo "Install Node.js 24, then run ./start again." >&2
  exit 1
fi

if [ ! -x node_modules/.bin/vite ]; then
  npm ci
fi

echo "Starting Zerble. Open the Local address printed below."
echo "Press Ctrl+C to stop the game server."
exec npm run dev -- --port 8747 "$@"
