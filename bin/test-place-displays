#!/usr/bin/env node
import {tickLocomotion} from '../src/models/personLocomotion.js';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {runInNewContext} from 'node:vm';
import {PeopleRuntime} from '../src/people/runtime.js';
import {PlaceDisplay} from '../src/people/placeDisplay.js';
const read=p=>readFileSync(new URL(p,import.meta.url),'utf8');
function extract(src,name){const a=src.indexOf('export function '+name+'(');let depth=0;for(let i=src.indexOf('{',a);i<src.length;i++){if(src[i]==='{')depth++;if(src[i]==='}'&&!--depth)return src.slice(a,i+1);}throw Error('Missing updater');}
const stage=extract(read('../src/chunks.js'),'updateStagePerformers'),cook=extract(read('../src/models/sugarShack.js'),'updateSugarShackCooks');
function fixture(old){
 let seed=1977,draws=0;const math=Object.assign(Object.create(Math),{random(){draws++;seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/2**32;}});
 const stages=[{group:{position:{y:0},rotation:{y:0,z:0},userData:{}},baseY:1,baseYaw:2,phase:.3}];
 const animation=[];stages.push({group:{userData:{animate:t=>animation.push(t)}},phase:1.7});
 const cooks=[{cook:{position:{x:0,z:0},rotation:{y:0}},waypoints:[{x:0,z:0,facing:1,holdMin:.1,holdMax:.4},{x:1,z:2,facing:2,holdMin:.1,holdMax:.3}],targetIdx:1,currentIdx:0,holdLeft:0,walkSpeed:2,chunkKey:'fixture'}];
 const compile=(s,name)=>runInNewContext(s.replace('export function','function')+';'+name,{tickLocomotion:node=>{if(node.userData)tickLocomotion(node,0);},stagePerformers:stages,sugarShackCooks:cooks,Math:math});
 const advanceStage=compile(old?read('../verification/people/2026-10-26/legacy-stage-displays.js'):stage,'updateStagePerformers');
 const advanceCook=compile(old?read('../verification/people/2026-10-26/legacy-cook-displays.js'):cook,'updateSugarShackCooks');
 return {stages,cooks,animation,advanceStage,advanceCook,get draws(){return draws;},snapshot(){return JSON.stringify({stages,cooks,animation,draws});}};
}
const old=fixture(true),current=fixture(false),runtime=new PeopleRuntime();
const stageDisplay=new PlaceDisplay({runtime,key:'stages',slot:'place-performers',advance:(_dt,frame)=>current.advanceStage(frame.displayTime),count:()=>current.stages.length});
const cookDisplay=new PlaceDisplay({runtime,key:'cooks',slot:'place-cooks',advance:dt=>current.advanceCook(dt),count:()=>current.cooks.length});
for(let frame=0;frame<1200;frame++){
 const dt=[.001,.02,.05][frame%3],displayTime=frame*.021;
 old.advanceStage(displayTime);old.advanceCook(dt);
 runtime.beginFrame(dt);runtime.run('place-performers',{displayTime});runtime.run('place-cooks',{});
 assert.equal(current.snapshot(),old.snapshot());
 if(frame===400){old.cooks.length=0;current.cooks.length=0;}
 if(frame===500){const again=fixture(false).cooks[0];old.cooks.push(structuredClone(again));current.cooks.push(structuredClone(again));}
}
const inspected=runtime.inspect();assert(inspected.every(r=>r.details.displayOnly&&r.details.population===0&&r.capabilities.length===0));
const count=current.stages.length+current.cooks.length,before=current.snapshot();
stageDisplay.dispose();stageDisplay.run(.02,{displayTime:123});assert.equal(current.snapshot(),before);
runtime.dispose();cookDisplay.run(.02,{});assert.equal(current.snapshot(),before);assert.equal(current.stages.length+current.cooks.length,count,'directory teardown does not dispose or erase borrowed place rigs');
assert(!Object.hasOwn(stageDisplay,'peopleHandles'));assert(!Object.hasOwn(cookDisplay,'activityClaims'));
const main=read('../src/main.js');assert(main.indexOf("people.run('place-performers'")<main.indexOf("people.run('late-activities',peopleFrame)"));assert(main.indexOf('updateStageLightShow(nowS')<main.indexOf("people.run('place-cooks'"));
console.log('PASS place displays: 1200 exact performer/cook frames including RNG and unload/revisit; no interactive identities/query/collision publication; borrowed ownership survives stopped directory; original interleaved barriers');
