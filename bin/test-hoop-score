for(const t of [NaN,Infinity,-Infinity])assert.throws(()=>sampleHoopScore(compileHoopScore(),t,createHoopSample()));
const broken=JSON.parse(JSON.stringify(compileHoopScore()));broken.segments[0].duration=-1;assert.throws(()=>validateHoopScore(broken));
