#!/usr/bin/env node
import assert from 'node:assert/strict';
import { setSeed } from '../src/worldgen/index.js';
import { heartInCell } from '../src/worldgen/hearts.js';
import { festivalPlan, spawnHeart, welcomeFoodCourt } from '../src/worldgen/festival.js';
import {sugarShackCourtEligible} from '../src/worldgen/sugarShacks.js';
import {FESTIVAL_TUNING as T,setFestivalTuning,MODEL_DIMS} from '../src/worldgen/tuning.js';
import {bumpWorldgen} from '../src/worldgen/constants.js';
import {heartsInBounds} from '../src/worldgen/hearts.js';
import { foodCourtShackFallback } from '../src/worldgen/placement.js';

let firstWelcomeSeed;
for (const seed of [1234, 3948869160, 9876, 42, 8675309]) {
  setSeed(seed);
  const home = spawnHeart();
  const welcome = welcomeFoodCourt();
  assert.ok(welcome, `seed ${seed} has a welcome court`);
  if (seed === 1234) firstWelcomeSeed = welcome.clusterSeed;
  assert.equal(welcomeFoodCourt(), welcome, 'selection is cached within a seed');
  const neighbours = [];
  for (let cz = home.cz - 1; cz <= home.cz + 1; cz++) {
    for (let cx = home.cx - 1; cx <= home.cx + 1; cx++) {
      const heart = heartInCell(cx, cz);
      if (heart) neighbours.push(...festivalPlan(heart).filter((d) => d.kind === 'food_court'));
    }
  }
  neighbours.sort((a, b) =>
    ((a.x - home.x) ** 2 + (a.z - home.z) ** 2) -
    ((b.x - home.x) ** 2 + (b.z - home.z) ** 2) || a.clusterSeed - b.clusterSeed);
  assert.equal(welcome.clusterSeed, neighbours[0].clusterSeed, `seed ${seed} picks the nearest surviving court`);
  assert.ok(Math.hypot(welcome.x - home.x, welcome.z - home.z) < 120, `seed ${seed} welcome court is close`);
}

const angles = [0, Math.PI / 2, Math.PI, Math.PI * 1.5];
const original = angles.slice();
const fallback = foodCourtShackFallback(0, 0, 25, angles, 0, (_x, z) => z < 0);
assert.ok(fallback && fallback.x < 0 && fallback.z < 0, 'blocked preferred side searches later gaps');
assert.deepEqual(angles, original, 'fallback leaves the original slot layout alone');
const shoulder = foodCourtShackFallback(0, 0, 25, angles, 0, (x, z) => x > 18 && z > 13 && z < 18);
assert.ok(shoulder && shoulder.x > 18 && shoulder.z > 13,
  'fallback checks safe shoulders when the center of a gap is blocked');
assert.equal(foodCourtShackFallback(0, 0, 25, angles, 0, () => false), null,
  'no Sugar Shack is placed in water, on a road, or against another stall');

setSeed(1234);
assert.equal(welcomeFoodCourt().clusterSeed, firstWelcomeSeed, 'changing seeds invalidates the selection cache');
console.log('PASS  welcome court selection and safe Sugar Shack fallback');


// Retain close-court fixtures to exercise named-vendor admission independently.
setFestivalTuning({FOOD_COURT_MIN_SPACING:0});bumpWorldgen();
let checked=0,retained=0;
for(const seed of [2641474229,1234,42,932033385,0]){
 setSeed(seed);
 const courts=heartsInBounds(-600,-600,600,900).flatMap(heart=>festivalPlan(heart).filter(d=>d.kind==='food_court'));
 const admitted=courts.filter(sugarShackCourtEligible);
 const radius=T.FOOD_COURT_SHACK_MIN_SPACING+2*(T.FOOD_COURT_RING_MULT*MODEL_DIMS.FOOD_TRUCK_SCALE+T.FOOD_COURT_SHACK_RING_PAD);
 for(let i=0;i<admitted.length;i++)for(const other of admitted.slice(i+1))assert(Math.hypot(admitted[i].x-other.x,admitted[i].z-other.z)>=radius,'even opposite ring edges retain the named-vendor minimum');
 const first=admitted.map(d=>d.clusterSeed).sort();
 setSeed(seed+1);setSeed(seed);
 assert.deepEqual(courts.slice().reverse().filter(sugarShackCourtEligible).map(d=>d.clusterSeed).sort(),first,'query order and seed roundtrip do not change selection');
 checked+=courts.length;retained+=admitted.length;
}
setSeed(2641474229);
const other=festivalPlan(heartInCell(0,3)).find(d=>d.kind==='food_court');
assert(!sugarShackCourtEligible(other));
const spacing=T.FOOD_COURT_SHACK_MIN_SPACING;
try{
 setFestivalTuning({FOOD_COURT_SHACK_MIN_SPACING:0});bumpWorldgen();
 assert(sugarShackCourtEligible(other),'tuning epoch invalidates the admission cache');
}finally{setFestivalTuning({FOOD_COURT_SHACK_MIN_SPACING:spacing});bumpWorldgen();}
assert(!sugarShackCourtEligible(other));
console.log(`PASS ${checked} final food courts across five seeds: ${retained} named vendors, conservative spacing, negative coordinates, seed/query order and tuning invalidation.`);
