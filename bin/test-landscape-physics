#!/usr/bin/env node
import assert from 'node:assert/strict';
import {Vector3,Quaternion} from 'three';
import {setSessionSeed} from '../src/rng.js';
import {setLandscapeVersion,landscapeCandidateInCell} from '../src/worldgen/landscapeCandidates.js';
import {setTerrainEnabled,sampleTerrain,terrainVertexHeight,terrainGenerationKey} from '../src/worldgen/terrain.js';
import {LandscapePhysicsSurfaces} from '../src/landscape/physicsSurfaces.js';
import {createRapierAdapter} from '../src/physics/rapierAdapter.js';
import {landscapeTileSupport,landscapePhysicsGround} from '../src/landscape/physicsTiles.js';
import {createSupportWorld} from '../src/landscape/support.js';
import {createTerrainResidency} from '../src/physics/terrainResidency.js';
import {coolerRecipe} from '../src/physics/recipes.js';
setSessionSeed(1977);setLandscapeVersion(2);setTerrainEnabled(true);
const candidate=landscapeCandidateInCell(-1,-1),bridge=candidate.bridge,b=bridge.bounds;
assert.ok(bridge);
let pins=0;
const owner={pin(){pins++;let active=true;return()=>{if(active){active=false;pins--;}};}};
const runtime={disposed:false,owners:new Map([[candidate.id,{candidate,water:owner,district:owner}]]),access:{query:()=>[{candidate}]}};
const origin={x:(b.minX+b.maxX)/2,z:(b.minZ+b.maxZ)/2};
const engine=await createRapierAdapter({capacities:{bodies:80,colliders:100,events:4096}});
const surfaces=new LandscapePhysicsSurfaces(runtime,engine,{origin});
const add=(id,p,extra={})=>assert.equal(engine.addBody({id,type:'dynamic',pose:{position:surfaces.toPhysics(p)},colliders:coolerRecipe(),ccd:true,...extra}).ok,true);
try {
  add('above',{...origin,y:bridge.height+3});add('below',{...origin,y:bridge.height-1.1});
  assert.equal(surfaces.track('above').ready,true);const shared=surfaces.counts().fixed;
  assert.equal(surfaces.track('below').ready,true);assert.equal(surfaces.counts().fixed,shared,'coincident props share actual terrain/deck bodies');
  assert.equal(pins,4,'each prop independently retains district and water ownership');
  assert.equal(surfaces.dispose(),false,'occupied support refuses ordinary teardown');
  const beforeSteps=engine.counts().steps;
  for(let i=0;i<360;i++){
    assert.equal(surfaces.prepare().ok,true);engine.step(1/60);assert.equal(engine.drainEvents().overflow,0);
  }
  assert.equal(engine.counts().steps,beforeSteps+360);
  const above=surfaces.toWorld(engine.readBody('above').pose.position),below=surfaces.toWorld(engine.readBody('below').pose.position);
  assert.ok(Math.abs(above.y-bridge.height)<.025,`above-deck cooler rests on slab (${above.y})`);
  assert.ok(Math.abs(below.y-sampleTerrain(below.x,below.z).height)<.04,'below-deck cooler rests on the native cut bed');
  assert.ok(below.y<bridge.height-1,'water cannot become an invisible floor');
  assert.ok(engine.readBody('above').sleeping,'sleeping props still retain support');assert.equal(pins,4);
  surfaces.release('below',{removeBody:true});assert.equal(pins,2);assert.equal(surfaces.counts().fixed,shared);
  surfaces.release('above',{removeBody:true});assert.equal(pins,0);assert.equal(engine.counts().bodies,0);
  // A tile corner requires four meshes. One-create slices must retain partial
  // progress rather than destroying the previous slice and starting forever.
  const corner={x:Math.round(origin.x/80)*80,z:Math.round(origin.z/80)*80};
  add('sliced',{...corner,y:100});assert.equal(surfaces.track('sliced').ready,true);
  engine.setPose('sliced',{position:surfaces.toPhysics({...corner,x:corner.x+320,y:100})});
  const stepsBeforeWait=engine.counts().steps,first=surfaces.step(1/60,{maxCreates:1});assert.equal(first.stepped,false);assert.equal(engine.counts().steps,stepsBeforeWait,'incomplete terrain never advances the engine');assert.equal(first.reason,'preparing');assert.equal(first.created,1);
  const retained=new Set(surfaces.fixed.keys());
  let result=first,slices=1;
  while(!result.ok){result=surfaces.prepare({maxCreates:1});assert.ok(++slices<=4);for(const id of retained)assert.ok(surfaces.fixed.has(id));}
  assert.equal(slices,4);
  const bodies=engine.counts().bodies,counts=surfaces.counts();
  engine.setVelocity('sliced',{linear:{x:1e9,y:0,z:0}});
  assert.equal(surfaces.prepare().reason,'origin-range','huge velocities reject before unbounded tile enumeration');
  assert.equal(engine.counts().bodies,bodies);assert.equal(surfaces.counts().fixed,counts.fixed);
  engine.setVelocity('sliced',{linear:{x:0,y:0,z:0}});
  engine.setPose('sliced',{position:surfaces.toPhysics({...origin,y:3})});runtime.owners.clear();
  assert.equal(surfaces.prepare().reason,'support-not-resident','canonical bridge cannot silently disappear from physics');
  runtime.owners.set(candidate.id,{candidate,water:owner,district:owner});
  assert.equal(surfaces.prepare({maxCreates:16}).ok,true);assert.equal(pins,2);
  engine.removeBody('sliced');add('sliced',{...origin,y:3});
  assert.equal(surfaces.step(1/60).reason,'body-replaced','reusing a logical id cannot inherit an old physical prop lease');
  assert.equal(surfaces.dispose({removeTracked:true}),true);assert.equal(pins,0);assert.equal(engine.counts().bodies,0);
  assert.equal(surfaces.dispose(),true);
}finally{surfaces.dispose({removeTracked:true});engine.dispose();}
// The default live engine uses its existing terrain residency, with deck solids
// sharing tile bodies and owner leases. No duplicate terrain provider is attached.
const liveEngine=await createRapierAdapter({capacities:{bodies:70,colliders:140,events:0}});
const liveRuntime={disposed:false,key:terrainGenerationKey(),supportWorld:createSupportWorld({sampleTerrain,decks:[bridge]}),owners:runtime.owners,access:{query:()=>[{candidate,state:{status:'ready'}}]}};
const liveTerrain=createTerrainResidency(liveEngine,{maxTiles:64,maxQueued:32,supportGeometry:(bounds,origin)=>landscapeTileSupport(liveRuntime,bounds,origin)});
try{
 const bounds={minX:origin.x-7,maxX:origin.x+7,minZ:origin.z-7,maxZ:origin.z+7};
 assert.equal(liveTerrain.request('deck-test',bounds).ok,true);
 // Missing visual support stays pending without exhausting retries or stepping.
 liveRuntime.owners=new Map();
 for(let i=0;i<5;i++)liveTerrain.pump({deadline:1,now:()=>0,maxCreations:32});
 assert.equal(liveTerrain.status('deck-test').state,'pending');assert.equal(pins,0);
 liveRuntime.owners=runtime.owners;
 liveTerrain.pump({deadline:1,now:()=>0,maxCreations:32});assert.equal(liveTerrain.status('deck-test').state,'ready');
 assert.ok(pins>0,'resident physics tiles retain their landscape owners');
 for(const [id,y]of [['live-above',bridge.height+3],['live-below',bridge.height-1.1]])assert.ok(liveEngine.addBody({id,type:'dynamic',pose:{position:{...origin,y}},colliders:coolerRecipe(),ccd:true}).ok);
 for(let i=0;i<360;i++)liveEngine.step(1/60);
 const above=liveEngine.readBody('live-above').pose.position,below=liveEngine.readBody('live-below').pose.position;
 assert.ok(Math.abs(above.y-bridge.height)<.03,`live tile deck floor ${above.y}`);
 assert.ok(Math.abs(below.y-sampleTerrain(below.x,below.z).height)<.05,'live tile retains the actual bed underneath');
 assert.equal(landscapePhysicsGround(liveRuntime,origin.x,origin.z,bridge.height+1).surfaceClass,'bridge','fallen people recover above the same deck as the solver');
 assert.equal(landscapePhysicsGround(liveRuntime,origin.x,origin.z,bridge.height-1).height,sampleTerrain(origin.x,origin.z).height,'below-deck recovery stays on the bed');
 const tiles=liveTerrain.stats().tiles;assert.equal(liveEngine.counts().bodies,tiles+2,'bridge colliders share existing terrain bodies');
 liveTerrain.release('deck-test');assert.equal(pins,0,'last tile lease releases both landscape owners');assert.equal(liveEngine.counts().bodies,2);
}finally{liveTerrain.dispose();liveEngine.dispose();}
// Capacity admission rolls back only its own newly created support and retains
// pre-existing bodies. Engine capacity remains an explicit retry/refusal.
const tiny=await createRapierAdapter({capacities:{bodies:2,colliders:2,events:0}}),limited=new LandscapePhysicsSurfaces(runtime,tiny,{origin});
try{
  assert.equal(tiny.addBody({id:'full',type:'dynamic',pose:{position:limited.toPhysics({...origin,y:3})},colliders:coolerRecipe()}).ok,true);
  assert.equal(limited.track('full').reason,'body-capacity');assert.equal(limited.counts().tracked,0);assert.equal(limited.counts().fixed,0);assert.equal(pins,0);assert.equal(tiny.counts().bodies,1);
}finally{limited.dispose();tiny.dispose();}
// Float32 geometry must be constructed relative to a nearby origin before
// storing vertices, preserving the exact 10m native lattice far from spawn.
const distantOrigin={x:9999990,z:-9999990},farEngine=await createRapierAdapter({capacities:{bodies:12,colliders:12,events:0}});
const farRuntime={disposed:false,owners:new Map(),access:{query:()=>[]}},far=new LandscapePhysicsSurfaces(farRuntime,farEngine,{origin:distantOrigin});
try{
 const p={x:distantOrigin.x+.125,z:distantOrigin.z+.25};p.y=sampleTerrain(p.x,p.z).height+2;
 assert.equal(farEngine.addBody({id:'far',type:'dynamic',pose:{position:far.toPhysics(p)},colliders:coolerRecipe()}).ok,true);
 assert.equal(far.track('far').ready,true);
 for(let i=0;i<240;i++){assert.equal(far.prepare().ok,true);farEngine.step(1/60);}
 const solved=far.toWorld(farEngine.readBody('far').pose.position);
 // A falling cooler can tip onto its side, so its model origin is not
 // necessarily at the floor. Test its actual rotated contact corners.
 const q=new Quaternion().copy(farEngine.readBody('far').pose.rotation),gaps=[];
 for(const x of [-.31,.31])for(const y of [0,.45])for(const z of [-.225,.225]){
   const corner=new Vector3(x,y,z).applyQuaternion(q).add(new Vector3(solved.x,solved.y,solved.z));
   gaps.push(corner.y-sampleTerrain(corner.x,corner.z).height);
 }
 assert.ok(Math.min(...gaps)>-.025&&Math.min(...gaps)<.025,`actual far-world contact gap ${Math.min(...gaps)}`);
 const tile=[...far.fixed.values()].find(s=>s.kind==='terrain');assert.ok(tile);
 assert.ok(Number.isFinite(terrainVertexHeight(tile.x*80,tile.z*80)));
 setLandscapeVersion(1);assert.equal(far.prepare().reason,'world-changed');
 assert.equal(far.dispose(),false);assert.equal(far.dispose({removeTracked:true}),true);assert.equal(farEngine.counts().bodies,0);
}finally{far.dispose({removeTracked:true});farEngine.dispose();setTerrainEnabled(false);setSessionSeed(0);}
console.log('PASS landscape physics: real cooler support above/below resident bridge, exact native bed, independent sleeping-owner leases, shared geometry, bounded incremental preparation, huge-velocity refusal, missing-owner and capacity rollback, nearby-origin precision at ±10 million, generation invalidation and exact engine teardown.');
