#!/usr/bin/env python3
"""Real OS ownership tests with inert Python children. Does not launch a browser."""
import contextlib,io,json,sys,tempfile
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'tooling'))
from performance_lab.supervisor import supervise,owned_alive
inert=[sys.executable,'-c','import subprocess,sys,time;subprocess.Popen([sys.executable,"-c","import time;time.sleep(30)"]);time.sleep(30)']
with tempfile.TemporaryDirectory(prefix='zerble-lab-lease-') as root:
 for name,code,expected in [('success','import pathlib,sys;pathlib.Path(sys.argv[1],"worker-result.json").write_text(\'{"ok":true}\')','collected'),('death','import os,signal;os.kill(os.getpid(),signal.SIGKILL)','failed'),('hang','import time;time.sleep(30)','failed')]:
  with contextlib.redirect_stdout(io.StringIO()):
   result=supervise(Path(root)/name,root,probe=True,deadline=1,browser_command=inert,worker_command=[sys.executable,'-c',code])
  assert result['state']==expected,result
  assert result['cleanup']['ok'],result
  assert result['cleanup']['checkedPids']
  assert owned_alive({p['pid']:p for p in result['owned']})==[]
 with contextlib.redirect_stdout(io.StringIO()):
  result=supervise(Path(root)/'browser-death',root,probe=True,deadline=2,browser_command=[sys.executable,'-c','import time;time.sleep(.25)'],worker_command=[sys.executable,'-c','import time;time.sleep(30)'])
 assert result['state']=='failed' and result['error']=='Owned Chrome exited during control',result
 assert result['cleanup']['ok'] and owned_alive({p['pid']:p for p in result['owned']})==[]
print('PASS supervisor: real descendant ownership, successful teardown, killed control worker and independent hung-worker deadline, exact-PID absence; no browser launched')
