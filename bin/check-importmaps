#!/usr/bin/env node
'use strict';

// Cache-buster declarations must cover every source module on all five pages.
// Declaring a URL does not import it; the 2D map remains independent of Three.js.
const fs = require('fs');
const path = require('path');
const PAGES = ['index.html', 'sandbox.html', 'hub-sandbox.html', 'terrain-sandbox.html', 'map-sandbox.html'];

function sourceModules(root) {
  const modules = new Set();
  function visit(dir, prefix = '') {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
      if (entry.name.startsWith('.')) continue;
      const relative = prefix + entry.name;
      if (entry.isDirectory()) visit(path.join(dir, entry.name), relative + '/');
      else if (entry.isFile() && entry.name.endsWith('.js')) modules.add(relative.slice(0, -3));
    }
  }
  visit(path.join(root, 'src'));
  return modules;
}

function declaredModules(html) {
  const modules = new Set();
  let arrays = 0;
  // models uses names relative to src/models; mods and wg use src-relative names.
  for (const name of ['mods', 'models', 'wg']) {
    const match = html.match(new RegExp('const\\s+' + name + '\\s*=\\s*\\[([\\s\\S]*?)\\]'));
    if (!match) continue;
    arrays++;
    // Comments can describe removed mappings and must not satisfy coverage.
    const tokens = /'([^']*)'|"([^"]*)"|\/\/[^\n]*|\/\*[\s\S]*?\*\//g;
    for (const token of match[1].matchAll(tokens)) {
      const value = token[1] ?? token[2];
      if (value !== undefined) modules.add((name === 'models' ? 'models/' : '') + value);
    }
  }
  return { modules, arrays };
}

function checkImportmaps(root) {
  const source = sourceModules(root);
  const problems = [];
  for (const page of PAGES) {
    const file = path.join(root, page);
    if (!fs.existsSync(file)) { problems.push(`${page}: MISSING file`); continue; }
    const { modules, arrays } = declaredModules(fs.readFileSync(file, 'utf8'));
    if (!arrays) { problems.push(`${page}: no mods/models/wg array found`); continue; }
    for (const module of source) {
      if (!modules.has(module)) problems.push(`${page}: missing '${module}'`);
    }
    for (const module of modules) {
      if (!source.has(module)) problems.push(`${page}: lists '${module}' but src/${module}.js does not exist`);
    }
  }
  return { problems, moduleCount: source.size, pageCount: PAGES.length };
}

if (require.main === module) {
  const result = checkImportmaps(path.resolve(__dirname, '..'));
  if (result.problems.length) {
    process.stderr.write('importmap drift:\n  ' + result.problems.join('\n  ') + '\n');
    process.exitCode = 1;
  } else process.stdout.write(`importmaps OK: ${result.moduleCount} source modules across ${result.pageCount} pages\n`);
}

module.exports = { checkImportmaps };
