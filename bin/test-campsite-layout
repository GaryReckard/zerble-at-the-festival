// Exercise real generated furniture against the production placement gate.
let acceptedMinimum=Infinity,acceptedMaximum=0;
for(let seed=1;seed<=100;seed++) {
  const entries=new Map(),byKind=new Map();let next=1;
  const registry={entries,byKind,add(entry){entry.id=next++;entries.set(entry.id,entry);if(!byKind.has(entry.kind))byKind.set(entry.kind,new Set());byKind.get(entry.kind).add(entry.id);return entry.id;},
    footprintsNear(x,z,r,fn){for(const entry of entries.values())if(entry.footprint)fn(entry);},
    collidersNear(x,z,r,fn){for(const entry of entries.values())if(entry.collider)fn(entry);}};
  const pitches=planCampNeighborhood(16,{seed,envelope:60});let accepted=0;
  for(const pitch of pitches) {
    let placed=false;
    for(const candidate of pitch.alternatives||[pitch]) {
      const camp=build(random(seed*17+accepted),pitch.size,{plan:pitch.recipe});
      camp.group.position.set(candidate.x,0,candidate.z);
      camp.group.rotation.y=candidate.facing-camp.entranceYaw;
      if(!canPlaceCampsite(registry,camp,'test-neighborhood'))continue;
      const ids=registerCampsite(registry,camp,{campNeighborhood:'test-neighborhood'});
      assert.equal(entries.get(ids[0]).campSeats.length,camp.seats.length,'accepted camps retain a reachable claim for every chair');
      placed=true;accepted++;break;
    }
    if(pitch.role==='host')assert(placed,'host must fit an empty neighborhood');
  }
  for(const entry of entries.values())for(const seat of entry.campSeats||[]) {
    const dx=seat.approachX-seat.x,dz=seat.approachZ-seat.z,len=dx*dx+dz*dz;
    for(const solid of entries.values()) {
      if(!solid.collider||solid===seat.collider)continue;
      const px=solid.position.x,pz=solid.position.z;
      const t=Math.max(0,Math.min(1,((px-seat.x)*dx+(pz-seat.z)*dz)/len));
      assert(Math.hypot(px-seat.x-t*dx,pz-seat.z-t*dz)>=solid.collider.radius+.35-1e-8,
        'complete household preserves every earlier and later chair route against all neighboring furniture');
    }
  }
  assert(accepted>=3,`compact neighborhood seed${seed} retains a useful group (${accepted})`);
  acceptedMinimum=Math.min(acceptedMinimum,accepted);acceptedMaximum=Math.max(acceptedMaximum,accepted);
}
console.log(`PASS 100 physical camp neighborhoods: ${acceptedMinimum}-${acceptedMaximum} camps, shared empty ground with solid/door/chair approach clearance.`);

const clipDoor=vm.runInNewContext(tentSource.replace('export function buildCampTent','function buildCampTent')+';clipDoorToShell');
const facetMesh={scale:{x:1,y:1,z:1},geometry:{attributes:{position:{array:[-1,0,1,1,0,.8,-1,2,.6,1,2,1.2]}},index:{array:[0,1,2,1,3,2]}}};
const clippedDoor=clipDoor(facetMesh,[[-.5,.3],[.5,.3],[.5,1.7],[-.5,1.7]]);
assert(clippedDoor.length>0);
for(let i=0;i<clippedDoor.length;i+=3){
  const x=clippedDoor[i],y=clippedDoor[i+1],z=clippedDoor[i+2]-.004;
  const front=x+y<=1? .9-.1*x-.2*y : .5+.3*x+.2*y;
  assert(Math.abs(z-front)<1e-8,'door vertices stay on the actual two differently tilted facets plus fixed cloth offset');
}
console.log('PASS tent doors: triangular split flaps, curved left-hinge D zippers, bowed dome mapping and exact faceted-shell clipping.');

// Exercise the real glow constructor so moving silhouettes cannot regress into
// per-frame shell clipping or hide the actual daytime door cloth.
class GlowGeometry {
  constructor(){this.attributes={};}
  setAttribute(name,attribute){this.attributes[name]=attribute;return this;}
  setDrawRange(start,count){this.drawRange={start,count};}
}
class GlowMaterial {
  constructor(){this.userData={};this.emissive={setHex(){}};}
  clone(){return new GlowMaterial();}
}
let silhouetteClips=0;
const glowConstructorSource=source.slice(source.indexOf('const _TENT_SILHOUETTE_MATERIAL='),source.indexOf('// Retain each chair'));
const makeGlow=vm.runInNewContext(glowConstructorSource+';addTentEveningGlow',{
  THREE:{Mesh,BufferGeometry:GlowGeometry,Float32BufferAttribute:class{constructor(array){this.array=array;}},MeshBasicMaterial:GlowMaterial},
  clipDoorToShell:(mesh,outline,offset)=>{silhouetteClips++;return [outline[0][0],outline[0][1],1+offset,outline[1][0],outline[1][1],1+offset,outline[2][0],outline[2][1],1+offset];},
});
const glowGroup=new Group(),doorCloth=new Mesh(null,new GlowMaterial());
glowGroup.add(new Mesh(null,new GlowMaterial()),doorCloth);
const glowHooks=[];
makeGlow({group:glowGroup,door:{mesh:doorCloth,surfaceMesh:{},surfaceZ:()=>1}},glowHooks,.5);
assert.equal(silhouetteClips,26,'thirteen two-part silhouette poses are prepared once');
animate(0,0,glowHooks,.25);
assert.equal(doorCloth.visible,true,'the actual zippered fabric door remains visible by day');
assert.equal(glowHooks[0].silhouette.visible,false);
for(let i=0;i<120;i++)animate(i/6,1,glowHooks,.65);
assert.equal(silhouetteClips,26,'animation reuses prepared poses without shell clipping');
assert(glowHooks[0].silhouette.geometry.drawRange.count>0);
assert.equal(glowHooks[0].silhouette.geometry.attributes.position.needsUpdate,true);
animate(21,1,glowHooks,.95);
assert.equal(doorCloth.visible,true);assert.equal(glowHooks[0].silhouette.visible,false);
assert.equal(glowHooks[0].material.emissiveIntensity,0);
console.log('PASS actual door glow: daytime cloth retained, thirteen cached silhouette poses, fixed buffer updates and late-night extinction.');

// Woodland pitch acceptance against real campsite geometry and pre-existing
// neighboring-chunk trunks, with the same pure clearance predicate as the game.
const {woodlandCampsNear,woodlandCampingClearance}=await import('../src/woodlandCamping.js');
const {setSessionSeed,mulberry32}=await import('../src/rng.js');
setSessionSeed(1977);
const woodlandDistricts=woodlandCampsNear({minX:-900,minZ:-900,maxX:900,maxZ:900});
let woodlandAccepted=0,woodlandPlanned=0;
for(const district of woodlandDistricts){
 const entries=new Map(),byKind=new Map();let next=1;
 const reg={entries,byKind,add(e){e.id=next++;entries.set(e.id,e);if(!byKind.has(e.kind))byKind.set(e.kind,new Set());byKind.get(e.kind).add(e.id);return e.id;},footprintsNear(x,z,r,fn){for(const e of entries.values())if(e.footprint)fn(e);},collidersNear(x,z,r,fn){for(const e of entries.values())if(e.collider)fn(e);}};
 for(let x=district.x-64;x<district.x+64;x+=8)for(let z=district.z-64;z<district.z+64;z+=8){
  if(!woodlandCampingClearance(x,z,woodlandDistricts,4))reg.add({kind:'forest_tree',position:{x,z},footprint:2,collider:{radius:1.3}});
 }
 let count=0;
 for(const p of district.pitches){
  const camp=build(mulberry32(p.seed),p.size,{plan:p.recipe});camp.group.position.set(p.worldx,0,p.worldz);camp.group.rotation.y=p.facing-camp.entranceYaw;
  const clear=canPlaceCampsite(reg,camp,district.id);
  if(p.role==='host')assert(clear,'pre-existing neighboring forest trunks cannot reject their planned shared host');
  if(!clear){if(process.env.WOODLAND_DIAG)console.log('rejected',district.id,p.archetype,'own',canPlaceCampsite({entries:new Map(),byKind:new Map(),footprintsNear(){},collidersNear(){}},camp,district.id));continue;}
  registerCampsite(reg,camp,{campNeighborhood:district.id});count++;
 }
 assert(count>=3,`woodland ${district.id} retains a shared host and useful sleeping group (${count})`);
 woodlandAccepted+=count;woodlandPlanned+=district.pitches.length;
}
assert(woodlandAccepted>=woodlandPlanned*.8,`physical camping retains most density-fitted woodland pitches (${woodlandAccepted}/${woodlandPlanned})`);
console.log(`PASS ${woodlandDistricts.length} woodland groups against actual camp geometry and earlier neighbor trunks: ${woodlandAccepted}/${woodlandPlanned} pitches.`);

// Seed 1977's second debug woodland destination is dry, but sits in the
// conservative bounding circle of the irregular lake south of its host.
const {lakesInBounds,lakeAt}=await import('../src/worldgen/water.js');
const lakeDistrict=woodlandDistricts.find(d=>d.id==='woodland:1,-2');
assert(lakeDistrict,'the reported second woodland destination exists');
const hostPitch=lakeDistrict.pitches.find(p=>p.role==='host');
const actualHost=build(mulberry32(hostPitch.seed),hostPitch.size,{plan:hostPitch.recipe});
actualHost.group.position.set(hostPitch.worldx,0,hostPitch.worldz);actualHost.group.rotation.y=hostPitch.facing-actualHost.entranceYaw;
const actualLake=lakesInBounds(100,-600,500,-100).find(l=>l.x===277&&l.z===-460);
assert(actualLake,'reported southern irregular lake exists');
const actualRadius=Math.max(...actualLake.outline.map(p=>Math.hypot(p.x-actualLake.x,p.z-actualLake.z)));
const hostDistance=Math.hypot(hostPitch.worldx-actualLake.x,hostPitch.worldz-actualLake.z);
assert(Math.abs(actualRadius-162.92636373527768)<1e-6);assert(Math.abs(hostDistance-164.97323199595965)<1e-6);
assert(!lakeAt(hostPitch.worldx,hostPitch.worldz));
for(let i=0;i<16;i++){const a=i*Math.PI/8;assert(!lakeAt(hostPitch.worldx+Math.cos(a)*actualHost.footprint,hostPitch.worldz+Math.sin(a)*actualHost.footprint),'every live preflight rim sample is dry');}
let fixtureShore=[];
const actualLakeGate={entries:new Map(),byKind:new Map(),footprintsNear(x,z,r,fn){fn({kind:'lake',position:{x:actualLake.x,z:actualLake.z},footprint:actualRadius});},collidersNear(x,z,r,fn){fixtureShore.forEach(fn);}};
assert.equal(canPlaceCampsite(actualLakeGate,actualHost,lakeDistrict.id),false,'actual unchecked fixture reproduces lost host');
assert.equal(canPlaceCampsite(actualLakeGate,actualHost,lakeDistrict.id,{waterChecked:true}),true,'actual dry host survives its broad lake-circle overlap');
const firstSolid=actualHost.childColliders[0],yaw=actualHost.group.rotation.y;
fixtureShore=[{kind:'lake_edge',position:{x:hostPitch.worldx+2*(firstSolid.x*Math.cos(yaw)+firstSolid.z*Math.sin(yaw)),z:hostPitch.worldz+2*(-firstSolid.x*Math.sin(yaw)+firstSolid.z*Math.cos(yaw))},collider:{radius:.5}}];
assert.equal(canPlaceCampsite(actualLakeGate,actualHost,lakeDistrict.id,{waterChecked:true}),false,'the real host still rejects an overlapping shoreline collider');
console.log('PASS seed1977 woodland: dry host at distance164.973 survives lake bounding radius162.926 only after exact water checks; shoreline solids still reject.');

// Shared-clearing infill exercises actual tent/chair builders and transforms,
// rather than treating whole campsite reservation circles as solid objects.
const clearingSource=readFileSync(new URL('../src/campClearing.js',import.meta.url),'utf8').replace(/^import .*;\n/gm,'').replace('export function populateCampClearing','function populateCampClearing');
const populate=vm.runInNewContext(clearingSource+';populateCampClearing',{terrainHeight:()=>0,mulberry32,planCampRecipe,CAMP_ARCHETYPES,buildCampsite:build,canPlaceCampsite});
let infillCount=0;
for(let seed=1;seed<=24;seed++){
 const entries=new Map(),byKind=new Map();let next=0;
 const reg={entries,byKind,add(e){e.id=++next;entries.set(e.id,e);if(!byKind.has(e.kind))byKind.set(e.kind,new Set());byKind.get(e.kind).add(e.id);return e.id;},footprintsNear(x,z,r,fn){for(const e of entries.values())if(e.footprint)fn(e);},collidersNear(x,z,r,fn){for(const e of entries.values())if(e.collider)fn(e);}};
 const host=build(mulberry32(seed),'small');host.group.rotation.y=seed*.31;
 const neighborhood='infill:'+seed;registerCampsite(reg,host,{campNeighborhood:neighborhood});
 const start=JSON.stringify(host.group.position),added=[];
 const camps=populate(reg,host,{seed,neighborhood,canUsePitch:()=>true,onAccept:camp=>{
   assert(canPlaceCampsite(reg,camp,neighborhood,{waterChecked:true}),'infill must preserve every existing solid and door/chair approach');
   registerCampsite(reg,camp,{campNeighborhood:neighborhood});added.push(camp);
 }});
 assert(camps.length>=3,`seed${seed}: a dry existing clearing supports a useful sleeping group (${camps.length})`);
 assert(camps.length<=8);assert.equal(camps.length,added.length);
 assert.equal(JSON.stringify(host.group.position),start,'infill does not move the established social center');
 for(const camp of camps){assert.equal(camp.tents.length,1);assert.equal(camp.seats.length,0);assert(Math.hypot(camp.group.position.x,camp.group.position.z)<=18);}
 infillCount+=camps.length;
}
console.log(`PASS actual clearing infill: ${infillCount} sleeping tents around24 retained social centers, bounded18m placement, no redundant chairs or solid/door/chair conflicts.`);
// Rejection paths must release private GPU resources without touching pools.
let allocations=0,privateDisposals=0,sharedDisposals=0;
const resource=shared=>({userData:{shared},dispose(){shared?sharedDisposals++:privateDisposals++;}});
const rejectedPopulate=vm.runInNewContext(clearingSource+';populateCampClearing',{terrainHeight:()=>0,mulberry32,planCampRecipe,CAMP_ARCHETYPES,canPlaceCampsite:()=>false,buildCampsite(){allocations++;return{footprint:7,group:{position:{set(){}},rotation:{},traverse(fn){fn({geometry:resource(false),material:resource(false)});fn({geometry:resource(true),material:resource(true)});}}};}});
const emptyHost={group:{position:{x:0,z:0},rotation:{y:0}}};
assert.throws(()=>rejectedPopulate({},emptyHost,{seed:1}),/callbacks/);
assert.equal(rejectedPopulate({},emptyHost,{seed:1,canUsePitch:()=>true,onAccept(){throw Error('rejected camp adopted');}}).length,0);
assert.equal(allocations,6,'only one model allocated per intended pitch, not per candidate');
assert.equal(privateDisposals,12);assert.equal(sharedDisposals,0);
console.log('PASS rejected infill releases private resources, preserves shared pools and bounds allocation retries.');
