class Group {
  constructor(){this.matrix=new NativeThree.Matrix4();this.matrixWorld=new NativeThree.Matrix4();this.children=[];this.position={x:0,y:0,z:0,set(x,y,z){Object.assign(this,{x,y,z});return this;},clone(){return {x:this.x,y:this.y,z:this.z,set(x,y,z){Object.assign(this,{x,y,z});return this;}};}};this.rotation={y:0};this.quaternion={setFromUnitVectors(){}};this.scale={x:1,y:1,z:1,setScalar(s){this.x=this.y=this.z=s;},set(x,y,z){Object.assign(this,{x,y,z});}};}
  updateMatrix(){this.matrix.compose(new NativeThree.Vector3(this.position.x,this.position.y,this.position.z),new NativeThree.Quaternion().setFromAxisAngle(new NativeThree.Vector3(0,1,0),this.rotation.y),new NativeThree.Vector3(this.scale.x,this.scale.y,this.scale.z));}
  updateWorldMatrix(){this.updateMatrix();this.matrixWorld.copy(this.matrix);}
  add(...nodes){for(const node of nodes){node.parent?.remove(node);this.children.push(node);node.parent=this;}}
  remove(node){const i=this.children.indexOf(node);if(i>=0)this.children.splice(i,1);node.parent=null;}
  // Layout fixture uses only yaw and an identity root at this assembly stage.
  // Native Three reparenting and instance transforms are checked separately.
  attach(node){const p=node.parent,a=p.rotation.y,x=node.position.x,z=node.position.z;
    node.position.set(p.position.x+Math.cos(a)*x+Math.sin(a)*z,node.position.y+p.position.y,p.position.z-Math.sin(a)*x+Math.cos(a)*z);
    node.rotation.y+=a;this.add(node);return this;}
}
const cfg={small:{radius:4,tents:1,ezUps:[0,1],torches:2,tapestries:1,chairs:[1,2]},medium:{radius:6,tents:2,ezUps:[1,1],torches:3,tapestries:[1,2],chairs:[2,3]},large:{radius:8,tents:3,ezUps:[1,2],torches:4,tapestries:2,chairs:[3,4]}};
class Geometry {
  constructor(...args){this.args=args;this.userData={};}
  setAttribute(name,value){this.attributes??={};this.attributes[name]=value;return this;}setIndex(){return this;}computeVertexNormals(){}dispose(){}
}
class Mesh extends Group {constructor(geometry,material){super();this.geometry=geometry;this.material=material;}}
const tentThree={Group,Mesh,BufferGeometry:Geometry,Float32BufferAttribute:Geometry,BoxGeometry:Geometry,PlaneGeometry:Geometry,CylinderGeometry:Geometry,ConeGeometry:Geometry,SphereGeometry:Geometry,MathUtils:{clamp:(v,a,b)=>Math.max(a,Math.min(b,v))}};
for(const key of ['BoxGeometry','PlaneGeometry','CylinderGeometry','ConeGeometry','SphereGeometry'])tentThree[key]=class extends Geometry{constructor(...args){super(...args);this.kind=key;}};
const tentSource=source.slice(source.indexOf('export function buildCampTent('),source.indexOf('// ---------- Camp chair'));
const makeTent=vm.runInNewContext(tentSource.replace('export function buildCampTent','function buildCampTent')+';buildCampTent',{THREE:tentThree,TENT_COLORS:tentColors,matFor:(hex)=>({hex,userData:{shared:true}}),addTentPoles:()=>{}});
for(let i=0;i<tentColors.length;i++){
  const values=[(i+.25)/tentColors.length,.4];let draws=0;
  const tent=makeTent(()=>values[draws++],{family:'ridge'});
  assert.equal(draws,2,'palette changes preserve the two historical tent RNG draws');
  assert.equal(tent.color,tentColors[i],'each indexed palette color reaches the built tent');
  assert.equal(tent.group.children[0].material.hex,tentColors[i],'shell material uses the selected palette color');
}
for(const [variation,roofColor] of [[0,0xd39a61],[.5,0x78986f],[1,0x7488b0]]){
  const tent=makeTent(()=>.4,{family:'cabin',variation});
  assert(tent.group.children.some(mesh=>mesh.material.hex===roofColor),`cabin rainfly uses the ${roofColor.toString(16)} pooled color bucket`);
}
class Vec {constructor(x=0,y=0,z=0){Object.assign(this,{x,y,z});}length(){return Math.hypot(this.x,this.y,this.z);}normalize(){const n=this.length();this.x/=n;this.y/=n;this.z/=n;return this;}}
const chairSource=readFileSync(new URL('../src/models/campChair.js',import.meta.url),'utf8').replace("import * as THREE from 'three';",'').replace('export const CAMP_CHAIR_STYLES','const CAMP_CHAIR_STYLES').replace('export function buildCampChair','function buildCampChair');
const makeChair=vm.runInNewContext(chairSource+';buildCampChair',{THREE:{...tentThree,Vector3:Vec,TorusGeometry:Geometry,DoubleSide:2,MeshStandardMaterial:class{constructor(options){Object.assign(this,options);this.userData={};}}}});
const canopySource=source.slice(source.indexOf('export function buildEzUp('),source.indexOf('// ---------- Tapestry'));
const makeCanopy=vm.runInNewContext(canopySource.replace('export function buildEzUp','function buildEzUp')+';buildEzUp',{
  THREE:{...tentThree,DoubleSide:2,MeshStandardMaterial:class{constructor(options){Object.assign(this,options);}}},
  EZUP_COLORS:[0x234523,0xc5b55c],matFor:()=>({userData:{shared:true}}),
});
for(const skirtDraw of [.4,.8]) {
  let draws=0;makeCanopy(()=>{draws++;return skirtDraw;});
  assert.equal(draws,2,'real canopies consume two caller draws with and without the skirt');
}
const builder=(rng)=>{rng();return {group:new Group()};};
const tapestryBuilder=rng=>{for(let i=0;i<4;i++)rng();return {group:new Group()};};
const context={THREE:{Group},PERF:{contextLights:false},SIZE_CONFIG:cfg,CAMPSITE_SCALE:2,
  buildChiminea:builder,buildCampTent:makeTent,planCampRecipe,discardCampProp:()=>{},buildEzUp:makeCanopy,buildCampChair:makeChair,buildTapestry:tapestryBuilder,CHAIR_COLORS:[0xc44a4a,0x3b7fbe,0x4f9c4f,0xd4c177,0xb86bc7,0x444b55],
