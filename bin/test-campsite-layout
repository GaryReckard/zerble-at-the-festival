  addCampKitchen:parent=>{const group=new Group();group.position.set(1.9,0,-.7);parent.add(group);return {cooler:{group,footprint:.42}};},addCanopyTwinkles:()=>{},addCampLanterns:()=>{},addTentEveningGlow:()=>{},batchCampChairs:(root,chairs)=>{for(const chair of chairs)chair.group.updateMatrix();},campsiteFootprint:size=>(cfg[size].radius+3)*2};
const fragment=source.slice(source.indexOf('function pickCount('),source.indexOf('// Shared unit geometry'))+source.slice(source.indexOf('export function buildCampsite('),source.indexOf('// ---------- Vendor backstage camp'));
const build=vm.runInNewContext(fragment.replace('export function buildCampsite','function buildCampsite')+';buildCampsite',context);
function random(seed){return()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};}
let examined=0;
const toLocal=(x,z,g)=>{const dx=x-g.position.x,dz=z-g.position.z,c=Math.cos(g.rotation.y),sn=Math.sin(g.rotation.y);return {x:dx*c-dz*sn,z:dx*sn+dz*c};};
const inside=(x,z,tent,padding=0)=>{const p=toLocal(x,z,tent.group);return tent.shelter.bounds.some(b=>b.radius!=null?Math.hypot(p.x-b.x,p.z-b.z)<b.radius+padding:Math.abs(p.x-b.x)<b.halfWidth+padding&&Math.abs(p.z-b.z)<b.halfDepth+padding);};
for(const family of ['ridge','dome','octagon','cabin','multiroom'])for(const variation of [0,.5,1]){
  let draws=0;const tent=makeTent(()=>{draws++;return .4;},{family,variation});
  assert.equal(draws,2,'all tent families preserve two legacy caller RNG draws');assert.equal(tent.family,family);
  assert(tent.shelter.capacity>=2);assert(tent.shelter.doorReach>tent.shelter.doorZ);
  assert.equal(tent.entrance.z,tent.shelter.doorReach);assert.equal(tent.footprint,tent.shelter.radius);
  assert(tent.group.children.length>=1,'each tent family builds real geometry');
  assert.equal(tent.door.kind,family==='ridge'?'split-triangle':'curved-d');
  assert.equal(tent.door.hinge,family==='ridge'?'centre':'left');
  assert(tent.door.mesh.geometry.attributes.position.args[0].length>8,'doors use shaped cloth geometry');
  if(family!=='ridge'){
    const left=tent.door.outline.filter(p=>Math.abs(p[0]+tent.door.width/2)<1e-9);
    assert(left.length>=2,'D doors preserve their straight left fabric hinge');
    assert(tent.door.outline.length>20,'D zipper curves are sampled beyond rectangle corners');
  }
  if(family==='dome'){
    const low=tent.door.surfaceZ(0,.1),high=tent.door.surfaceZ(0,tent.door.height);
    assert(low-high>.25,'dome door follows the bowed shell depth');
  }
  if(family==='cabin'||family==='multiroom')assert(!tent.group.children.some(mesh=>mesh.geometry.kind==='PlaneGeometry'),'cabin tents have no rectangular window/door overlays');

  for(const mesh of tent.group.children){
    const geo=mesh.geometry,pts=[],a=geo.args;
    if(geo.attributes?.position) {const vertices=geo.attributes.position.args[0];for(let i=0;i<vertices.length;i+=3)pts.push([vertices[i],vertices[i+2]]);}
    else if(geo.kind==='BoxGeometry')for(const x of [-a[0]/2,a[0]/2])for(const z of [-a[2]/2,a[2]/2])pts.push([x,z]);
    else if(geo.kind==='PlaneGeometry')pts.push([-a[0]/2,0],[a[0]/2,0]);
    else {const radius=geo.kind==='CylinderGeometry'?Math.max(a[0],a[1]):a[0];for(let i=0;i<64;i++)pts.push([Math.cos(i*Math.PI/32)*radius,Math.sin(i*Math.PI/32)*radius]);}
    for(const [x,z]of pts){const sx=x*mesh.scale.x,sz=z*mesh.scale.z,c=Math.cos(mesh.rotation.y),sn=Math.sin(mesh.rotation.y);assert(Math.hypot(mesh.position.x+sx*c+sz*sn,mesh.position.z-sx*sn+sz*c)<=tent.footprint+.001,`${family} full geometry fits actual radial footprint`);}
  }

}
for(const size of Object.keys(cfg))for(const role of ['standalone','host','satellite'])for(const archetype of CAMP_ARCHETYPES)for(let seed=1;seed<=50;seed++){
  const options={role,archetype,seed},recipe=planCampRecipe(size,options);
  const camp=build(random(seed),size,options),other=build(random(seed),size,options);
  assert.equal(camp.tents.length,recipe.tentFamilies.length);
  assert.equal(camp.footprint,recipe.footprint);
  const approaches=campSeatApproaches(camp);
  assert(approaches.every(Boolean),`${size}/${role}/${archetype}/seed${seed}: every visible chair has a usable approach`);
  for(let i=0;i<approaches.length;i++) {
    const seat=camp.seats[i],approach=approaches[i],sx=seat.x*2,sz=seat.z*2;
    const dx=approach.x-sx,dz=approach.z-sz,len=dx*dx+dz*dz;
    for(const prop of camp.childColliders) {
      if(prop.group===seat.group)continue;
      const px=prop.x*2,pz=prop.z*2,t=Math.max(0,Math.min(1,((px-sx)*dx+(pz-sz)*dz)/len));
      assert(Math.hypot(px-sx-t*dx,pz-sz-t*dz)>=prop.radius*2+.35-1e-8,
        'complete chair approach clears every other prop, including furniture in the same camp');
    }
  }
  const data=c=>JSON.stringify({seats:c.seats.map(({x,z,y,yaw})=>({x,z,y,yaw})),tents:c.tents.map(({x,z,entry,family})=>({x,z,entry,family}))});
  assert.equal(data(camp),data(other),'reload reconstructs the same furniture and entrances');
  for(const seat of camp.seats){
    for(const tent of camp.tents)assert(!inside(seat.x,seat.z,tent,.3),'seats stay outside actual family fabric');
    for(const p of camp.childColliders.filter(p=>p.kind==='camp_kitchen'||p.kind==='camp_cooler'))assert(Math.hypot(seat.x-p.x,seat.z-p.z)>p.radius+.28,'chairs do not overlap kitchen furniture');
  }
  for(let i=0;i<camp.seats.length;i++)for(let j=i+1;j<camp.seats.length;j++)assert(camp.seats[i].group===camp.seats[j].group||Math.hypot(camp.seats[i].x-camp.seats[j].x,camp.seats[i].z-camp.seats[j].z)>.72,'independent chairs remain disjoint');
  for(const p of camp.childColliders)assert(Math.hypot(p.x,p.z)+p.radius<=camp.footprint/2+.01,`${size}/${role}/${archetype}: prop collision bounds fit declared footprint`);
  for(let i=0;i<camp.tents.length;i++)for(let j=i+1;j<camp.tents.length;j++)assert(Math.hypot(camp.tents[i].x-camp.tents[j].x,camp.tents[i].z-camp.tents[j].z)>camp.tents[i].shelter.radius+camp.tents[j].shelter.radius+.1,`${size}/${role}/${archetype}/${seed}: neighboring ${camp.tents[i].family}/${camp.tents[j].family} shelter radial bounds separate`);
  for(const tent of camp.tents){assert((tent.entry.x-tent.x)*-tent.x+(tent.entry.z-tent.z)*-tent.z>0,'tent door faces the communal clearing');}
  const canopies=[...new Set(camp.childColliders.filter(p=>p.kind==='camp_post').map(p=>p.group))];
  for(const torch of camp.childColliders.filter(p=>p.kind==='camp_torch')) {
    for(const tent of camp.tents)assert(!inside(torch.x,torch.z,tent,.15),'torch clears actual family fabric');
    for(const canopy of canopies){const p=toLocal(torch.x,torch.z,canopy);assert(Math.abs(p.x)>1.6||Math.abs(p.z)>1.6,'torch clears full canopy roof and posts');}
  }
  const screens=[...new Set(camp.childColliders.filter(p=>p.kind==='camp_tapestry').map(p=>p.group))],endpoints=[];
  for(const screen of screens){
    const yaw=screen.rotation.y,c=Math.cos(yaw),sn=Math.sin(yaw);
    for(let j=0;j<=20;j++){
      const along=(j/20-.5)*2.6,x=screen.position.x+along*c,z=screen.position.z-along*sn;
      assert(Math.hypot(x,z)<=camp.footprint/2,'full tapestry fabric stays in declared footprint');
      for(const tent of camp.tents)assert(!inside(x,z,tent,.1),`${size}/${role}/${archetype}/${seed} ${tent.family}: screen (${x},${z}) clears family fabric`);
    }
    if(Math.hypot(screen.position.x,screen.position.z)>cfg[size].radius+1.5)endpoints.push([-1.3,1.3].map(along=>({x:screen.position.x+along*c,z:screen.position.z-along*sn})));
  }
  if(endpoints.length===2)assert(Math.min(...endpoints[0].flatMap(a=>endpoints[1].map(b=>Math.hypot(a.x-b.x,a.z-b.z))))>=.5,'privacy gaps preserve one world metre of clearance');
  if(role==='satellite'){assert.equal(canopies.length,0);assert(!camp.childColliders.some(p=>p.kind==='campfire'||p.kind==='camp_kitchen'),'satellites use host shared spaces');}
  examined++;
}
console.log(`PASS ${examined} deterministic campsite layouts across all archetypes and roles: family fabric bounds, footprint, furniture, privacy and torch clearance.`);
console.log('Scope: shipped assembler, tent and chair builders with rendering writes stubbed; browser verification covers GPU appearance and integration.');

// Count real shelter/furniture builder calls and canvas allocations, independently
// of elapsed time. The remaining primitive builders retain identical stubs.
function instrumentAssembler(assemblerSource) {
  const counts={tents:0,tapestries:0,canvases:0,canopies:0,chairs:0};
  const tapSource=source.slice(source.indexOf('export function buildTapestry('),source.indexOf('// ---------- Campsite assembler'));
  const makeTapestry=vm.runInNewContext(tapSource.replace('export function buildTapestry','function buildTapestry')+';buildTapestry',{
    THREE:{...tentThree,DoubleSide:2,SRGBColorSpace:'srgb',RepeatWrapping:'repeat',
      CanvasTexture:class {constructor(image){this.image=image;}dispose(){}},
      MeshStandardMaterial:class {constructor(options){Object.assign(this,options);}addEventListener(){}},
    },POLE_MAT:{},TAPESTRY_COLORS:[[0x112233,0x445566],[0x778899,0xaabbcc]],
    document:{createElement(){counts.canvases++;return {getContext:()=>({fillRect(){},beginPath(){},moveTo(){},lineTo(){},closePath(){},fill(){}})};}},
  });
  let draws=0;
  makeTapestry(()=>{draws++;return .4;});
  assert.equal(draws,4,'the real tapestry builder consumes width, height, palette and pattern draws');
  counts.canvases=0;
  const assembler=assemblerSource.slice(assemblerSource.indexOf('function pickCount('),assemblerSource.indexOf('// Shared unit geometry'))+
    assemblerSource.slice(assemblerSource.indexOf('export function buildCampsite('),assemblerSource.indexOf('// ---------- Vendor backstage camp'));
  const measured=vm.runInNewContext(assembler.replace('export function buildCampsite','function buildCampsite')+';buildCampsite',{
    ...context,
    buildCampTent(...args){counts.tents++;return makeTent(...args);},
    buildTapestry(...args){counts.tapestries++;return makeTapestry(...args);},
    buildEzUp(...args){counts.canopies++;return makeCanopy(...args);},
    buildCampChair(...args){counts.chairs++;return makeChair(...args);},
  });
  return {build:measured,counts,reset(){for(const key of Object.keys(counts))counts[key]=0;}};
}
const measuredAssembler=instrumentAssembler(source);
let constructionCases=0;
for(const size of Object.keys(cfg))for(const role of ['standalone','host','satellite'])for(const archetype of CAMP_ARCHETYPES)for(let seed=1;seed<=10;seed++) {
  measuredAssembler.reset();
  const options={role,archetype,seed},recipe=planCampRecipe(size,options);
  const camp=measuredAssembler.build(random(seed),size,options),counts=measuredAssembler.counts;
  assert.equal(counts.tents,recipe.tentFamilies.length,'only retained tent slots invoke the real tent builder');
  const screens=new Set(camp.childColliders.filter(p=>p.kind==='camp_tapestry').map(p=>p.group));
  assert.equal(counts.tapestries,screens.size,'only retained screens invoke the real tapestry builder');
  assert.equal(counts.canvases,screens.size,'every allocated canvas belongs to a retained screen');
  const canopies=new Set(camp.childColliders.filter(p=>p.kind==='camp_post').map(p=>p.group));
  assert.equal(counts.canopies,canopies.size,'only retained canopies invoke the real canopy builder');
  if(recipe.canopyLimit===0) {
    const chairs=camp.childColliders.filter(p=>p.kind==='camp_chair'||p.kind==='camp_loveseat');
    assert.equal(counts.chairs,chairs.length,'omitted canopies construct no discarded chairs');
  }
  if(role==='satellite') {
    assert.equal(counts.canvases,0,'shared satellites allocate no tapestry canvas');
    assert.equal(counts.canopies,0,'shared satellites allocate no canopy');
  }
  constructionCases++;
}
console.log(`PASS construction counts: ${constructionCases} camps build only retained tents/screens/canopies; omitted canopies construct no discarded chairs.`);

if(process.argv[2]) {
  const oldAssembler=instrumentAssembler(readFileSync(process.argv[2],'utf8'));
  const layout=camp=>JSON.stringify({footprint:camp.footprint,entranceYaw:camp.entranceYaw,
    seats:camp.seats.map(({x,z,y,yaw,seatIndex,furniture})=>({x,z,y,yaw,seatIndex,furniture})),
    tents:camp.tents.map(({x,z,yaw,entry,family,capacity,shelter})=>({x,z,yaw,entry,family,capacity,shelter})),
    colliders:camp.childColliders.map(({kind,x,z,radius,group})=>({kind,x,z,radius,pose:group&&[group.position.x,group.position.y,group.position.z,group.rotation.y]})),
  });
  const before={tents:0,tapestries:0,canvases:0,canopies:0,chairs:0},after={...before};let comparisons=0;
  for(const size of Object.keys(cfg))for(const role of ['standalone','host','satellite'])for(const archetype of CAMP_ARCHETYPES)for(let seed=1;seed<=50;seed++) {
    let oldCount=0,newCount=0;
    const a=random(seed),b=random(seed),options={role,archetype,seed};
    oldAssembler.reset();measuredAssembler.reset();
    const oldCamp=oldAssembler.build(()=>{oldCount++;return a();},size,options);
    const newCamp=measuredAssembler.build(()=>{newCount++;return b();},size,options);
    assert.equal(newCount,oldCount,'caller RNG consumption remains unchanged');
    assert.equal(a(),b(),'caller RNG resumes at the identical next value');
    assert.equal(layout(newCamp),layout(oldCamp),'all seats, tent entrances, capacities, colliders and retained prop poses match the baseline');
    for(const key of Object.keys(before)){before[key]+=oldAssembler.counts[key];after[key]+=measuredAssembler.counts[key];}
    comparisons++;
  }
  console.log(`PASS baseline comparison: ${comparisons} camps preserve RNG and layout metadata; constructors before ${JSON.stringify(before)}, after ${JSON.stringify(after)}.`);
  console.log('Scope: real tent/tapestry/canopy/chair builders with canvas drawing and remaining rendering primitives stubbed identically; counts establish construction savings, not GPU or device timing.');
}

// Execute the shipped chair wrapper with actual Three matrices and bindings.
const batchFragment=source.slice(source.indexOf('function batchCampChairs('),source.indexOf('export function buildCampsite('));
const batch=vm.runInNewContext(batchFragment+';batchCampChairs',{batchPropGroups});
const geometry=new NativeThree.BoxGeometry(),material=new NativeThree.MeshBasicMaterial();
geometry.userData.shared=material.userData.shared=true;
const chairFixture=()=>{const group=new NativeThree.Group();for(let i=0;i<3;i++)group.add(new NativeThree.Mesh(geometry,material));return {group};};
const anchors=[chairFixture(),chairFixture()],root=new NativeThree.Group();
anchors.forEach(({group})=>root.add(group));
const chairBatch=batch(root,anchors);
assert.equal(chairBatch.meshes.length,1,'matching chair parts collapse to one draw');
assert.equal(chairBatch.meshes[0].count,6,'all original part transforms survive batching');
assert(chairBatch.meshes[0].instanceMatrix.version>0,'batched transforms upload');
assert.equal(chairBatch.meshes[0].geometry,geometry,'batch reuses shared geometry');
assert.equal(chairBatch.meshes[0].material,material,'batch reuses shared material');
assert(anchors.every(({group,renderBinding})=>group.children.length===0&&renderBinding.group===group),'seat anchors retain their part bindings without duplicate meshes');
chairBatch.dispose();geometry.dispose();material.dispose();
console.log('PASS chair batching: shared resources, metadata anchors, all transforms retained and instance upload flagged.');

const animateSource=source.slice(source.indexOf('export function updateCampsiteProps(')).replace('export function','function');
const smoothstep=(v,a,b)=>{const n=Math.max(0,Math.min(1,(v-a)/(b-a)));return n*n*(3-2*n);};
const animate=vm.runInNewContext(animateSource+';updateCampsiteProps',{THREE:{MathUtils:{smoothstep,clamp:(v,a,b)=>Math.max(a,Math.min(b,v))}}});
const flame={visible:true,scale:{y:1}},color={value:0,setHex(v){this.value=v;}};
const fire={phase:.5,emberMat:{emissiveIntensity:1,color},fireFlame:flame};
animate(1,0,[fire],.25);
assert.equal(fire.emberMat.emissiveIntensity,0);assert.equal(color.value,0x30251e);assert.equal(flame.visible,false);
animate(1,1,[fire],.7);assert(fire.emberMat.emissiveIntensity>1);assert.equal(flame.visible,true);
animate(1,1,[fire],.95);assert.equal(fire.emberMat.emissiveIntensity,0);assert.equal(flame.visible,false);
console.log('PASS fire schedule: cold daytime charcoal, evening flames and extinguished late-night fire.');

{
const panel={visible:true},silhouette={visible:true,position:{x:0}},material={emissiveIntensity:0},fabric={emissiveIntensity:0};
const glow={kind:'tentGlow',panel,silhouette,material,fabric,phase:.5,bedtime:.82};
const lantern={kind:'campLantern',material:{emissiveIntensity:0}};
animate(10,0,[glow,lantern],.25);assert.equal(panel.visible,false);assert.equal(silhouette.visible,false);assert.equal(material.emissiveIntensity,0);assert.equal(fabric.emissiveIntensity,0);assert.equal(lantern.material.emissiveIntensity,0);
animate(10,1,[glow,lantern],.65);assert.equal(panel.visible,true);assert.equal(silhouette.visible,true);assert(material.emissiveIntensity>0);assert(fabric.emissiveIntensity>0);assert(lantern.material.emissiveIntensity>0);
const before=silhouette.position.x;animate(11,1,[glow],.65);assert.notEqual(before,silhouette.position.x,'silhouette moves gently while camper is awake');
animate(12,1,[glow],.95);assert.equal(panel.visible,false);assert.equal(silhouette.visible,false);assert.equal(fabric.emissiveIntensity,0);
console.log('PASS lantern/tent lighting: noon cold, evening internally lit fabric and motion, late-night tents dark.');

