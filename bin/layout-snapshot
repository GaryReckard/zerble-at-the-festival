#!/usr/bin/env node
/*
 * bin/layout-snapshot — capture, normalize, and diff "built-truth" layout
 * snapshots of the procedural festival (worldgen-layout-harness task 1.2).
 *
 * WHY a snapshot tool: the determinism goldens cover the *plan* (festival.js);
 * NOTHING covers the *built* world (chunks.js builders → registry). The hoist
 * (group 2) and every future grammar commit are gated on "the built world did
 * not change" — which means we need the built world as comparable data. This
 * script is that comparison's deterministic half.
 *
 * THE ARCHITECTURE (read this before expecting it to "just boot the game"):
 * the registry is populated by GAME code running in a BROWSER (chunks.js needs
 * THREE + a live scene). A pure-node CLI cannot boot it — there is no headless
 * browser in this no-build repo. So capture is split:
 *
 *   1. BROWSER half (the agent / a human, via the preview-MCP recipe printed by
 *      `--recipe`): boot `?worldgen=1&seed=S&perf=high`, __dbg.start(), let the
 *      world settle (loaded-chunk count stable, NO driving), then
 *      `__dbg.dumpRegistry()` → save the raw array to verification/raw/<seed>.json.
 *   2. NODE half (this script): read that raw array, NORMALIZE it (drop the two
 *      moving kinds, round coords to 1e-4, sort by kind+x+z), and write the
 *      canonical snapshot to verification/snapshots/<seed>.json. Plus `--diff`.
 *
 * That split is deliberate and honest, not a shortcut: only the browser can
 * produce built truth, and only deterministic normalization makes two captures
 * byte-comparable. `--recipe`/`--seeds` make the browser half copy-paste cheap
 * (a tedious gate is a skipped gate).
 *
 * MOVERS EXCLUDED: `lurleen` and `hula_hoop` hold live, per-frame-mutated
 * positions (registry.js:16 "drifting hula-hoopers", lurleen.js:133). They are
 * ACTORS, not layout — including them would make two captures taken a few frames
 * apart differ forever, so the twice-capture self-diff control (task 1.3) could
 * never be empty. They are dropped during normalize. Everything static (stages,
 * trucks, booths, pottys, camps, trees, arches, lakes, roads/path_nodes) stays.
 *
 * No dependencies; CommonJS so it runs as an extensionless bin script without a
 * package.json "type":"module". Precedent: bin/readme-sync.
 */
'use strict';

const fs = require('fs');
const path = require('path');
const { execFileSync, spawnSync } = require('child_process');

const ROOT = path.resolve(__dirname, '..');
const RAW_DIR = path.join(ROOT, 'verification', 'raw');
const SNAP_DIR = path.join(ROOT, 'verification', 'snapshots');

// Kinds whose position is mutated every frame — actors, not built layout.
// Keep this list tiny and explicit; adding to it is a layout-vs-actor decision.
const MOVING_KINDS = new Set(['lurleen', 'hula_hoop']);

// The seeds the change captures against (task 1.5). 0xf7ef2a3c is the round-2
// playtest seed; +1 is the "fresh" third. Kept here so --seeds with no list
// reproduces the canonical set.
const DEFAULT_SEEDS = ['1234', '0xf7ef2a3c', '0xf7ef2a3d'];

function die(msg, code = 1) { process.stderr.write(msg + '\n'); process.exit(code); }
function ensureDir(d) { fs.mkdirSync(d, { recursive: true }); }

// Round a coordinate/radius to 1e-4 and squash -0 → 0 (JSON-stable). null passes
// through (absent collider/attractor fields).
function round4(v) {
  if (v == null) return null;
  return (Math.round(v * 1e4) / 1e4) + 0;
}

// Turn a raw dumpRegistry() array into the canonical, comparable entry list.
function normalizeEntries(raw) {
  return raw
    .filter((e) => !MOVING_KINDS.has(e.kind))
    .map((e) => ({
      kind: e.kind,
      x: round4(e.x),
      z: round4(e.z),
      footprint: round4(e.footprint != null ? e.footprint : 0),
      colliderR: round4(e.colliderR),
      damage: e.damage != null ? e.damage : null,
      attractorR: round4(e.attractorR),
      attractorW: round4(e.attractorW),
      chunkKey: e.chunkKey != null ? e.chunkKey : null,
    }))
    .sort((a, b) =>
      (a.kind < b.kind ? -1 : a.kind > b.kind ? 1 : 0) ||
      (a.x - b.x) || (a.z - b.z) ||
      (a.footprint - b.footprint) ||
      ((a.chunkKey || '') < (b.chunkKey || '') ? -1 : (a.chunkKey || '') > (b.chunkKey || '') ? 1 : 0));
}

// Returns { entries, drawCounts } from a raw capture. Accepts a bare
// dumpRegistry() array (drawCounts absent → null) OR a combined object
// { entries:[...], drawCounts:{...} } (the recipe's preferred form, so the
// canary travels with the positions). A previously-written snapshot also works.
function readRawObj(parsed, label) {
  const entries = Array.isArray(parsed) ? parsed : parsed.entries;
  if (!Array.isArray(entries)) die(`raw capture has no entry array: ${label}`);
  const drawCounts = (!Array.isArray(parsed) && parsed.drawCounts) ? parsed.drawCounts : null;
  return { entries, drawCounts };
}

function readRaw(rawPath) {
  if (!fs.existsSync(rawPath)) {
    die(`raw capture not found: ${path.relative(ROOT, rawPath)}\n` +
        `Capture it first — run:  bin/layout-snapshot --recipe ${path.basename(rawPath, '.json')}`);
  }
  let parsed;
  try { parsed = JSON.parse(fs.readFileSync(rawPath, 'utf8')); }
  catch (e) { die(`raw capture is not valid JSON (${path.relative(ROOT, rawPath)}): ${e.message}`); }
  return readRawObj(parsed, path.relative(ROOT, rawPath));
}

// Sort a draw-counts object's keys so two captures serialize identically.
function normalizeDrawCounts(dc) {
  if (!dc) return null;
  const out = {};
  for (const k of Object.keys(dc).sort()) out[k] = dc[k];
  return out;
}

// `bin/layout-snapshot <seed> [outfile] [--raw f] [--tier t] [--window w] [--stdin]`
function cmdCapture(args) {
  const seed = args.positional[0];
  if (!seed) die('usage: bin/layout-snapshot <seed> [outfile] [--raw f] [--tier high] [--window name] [--stdin]');
  const tier = args.flags.tier || 'high';
  const win = args.flags.window || 'settled';
  let raw;
  if (args.flags.stdin) {
    raw = readRawObj(JSON.parse(fs.readFileSync(0, 'utf8')), 'stdin');
  } else {
    const rawPath = args.flags.raw ? path.resolve(args.flags.raw) : path.join(RAW_DIR, `${seed}.json`);
    raw = readRaw(rawPath);
  }
  const entries = normalizeEntries(raw.entries);
  const dropped = raw.entries.length - entries.length;
  const drawCounts = normalizeDrawCounts(raw.drawCounts);
  const snapshot = {
    seed: String(seed),
    tier,
    worldgen: true,
    window: win,
    entryCount: entries.length,
    moversExcluded: dropped,          // lurleen + hula_hoop count, for transparency
    clusterCount: drawCounts ? Object.keys(drawCounts).length : null,
    drawCounts,                       // per-cluster rng draw canary (task 1.4)
    entries,
  };
  const outPath = args.positional[1]
    ? path.resolve(args.positional[1])
    : path.join(SNAP_DIR, `${seed}.json`);
  ensureDir(path.dirname(outPath));
  // Trailing newline; 2-space indent — git-diff friendly, deterministic.
  fs.writeFileSync(outPath, JSON.stringify(snapshot, null, 2) + '\n');
  process.stdout.write(
    `wrote ${path.relative(ROOT, outPath)}  (${entries.length} layout entries, ${dropped} movers dropped, tier=${tier})\n`);
}

// ── Live capture via agent-browser (the genuine one-command path) ──────────
// A capture owns exactly one uniquely named browser session. Every invocation
// is bounded, and the outer finally block closes the session plus proves that
// no daemon/GPU worker created after the baseline survived. Never call die()
// from this layer: process.exit would bypass that cleanup.
const DEFAULT_AB_TIMEOUT_MS = 12_000;
const AUTOMATION_PROCESS_RE = /(agent-browser\/bin\/\.\.\/dist\/daemon\.js|chrome-headless-shell)/;

function sleepSync(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

function automationProcesses() {
  const res = spawnSync('ps', ['-axo', 'pid=,ppid=,command='], {
    encoding: 'utf8', timeout: 3000, maxBuffer: 8 * 1024 * 1024,
  });
  if (res.error || res.status !== 0) {
    const detail = (res.stderr || res.error?.message || `exit ${res.status}`).trim();
    throw new Error(`could not enumerate browser processes${detail ? `: ${detail}` : ''}`);
  }
  const found = new Map();
  for (const line of res.stdout.split('\n')) {
    if (!AUTOMATION_PROCESS_RE.test(line)) continue;
    const m = line.match(/^\s*(\d+)\s+(\d+)\s+(.+)$/);
    if (m) found.set(Number(m[1]), { pid: Number(m[1]), ppid: Number(m[2]), command: m[3] });
  }
  return found;
}

function newAutomationProcesses(baseline) {
  return [...automationProcesses().values()].filter((p) => !baseline.has(p.pid));
}

function runAgentBrowser(session, args, label, options = {}) {
  const timeout = options.timeoutMs || DEFAULT_AB_TIMEOUT_MS;
  const res = spawnSync('agent-browser', ['--session', session, ...args], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
    timeout,
    killSignal: 'SIGTERM',
    maxBuffer: 64 * 1024 * 1024,
  });
  const timedOut = res.error && res.error.code === 'ETIMEDOUT';
  if (timedOut && options.allowTimeout) {
    process.stderr.write(`[capture] ${label} exceeded ${timeout}ms; probing the named session directly\n`);
    return '';
  }
  if (res.error || res.status !== 0) {
    const detail = (res.stderr || res.stdout || res.error?.message || `exit ${res.status}`).trim();
    const suffix = timedOut ? ` timed out after ${timeout}ms` : ' failed';
    throw new Error(`agent-browser ${label}${suffix}${detail ? `: ${detail}` : ''}`);
  }
  return res.stdout;
}

function parseAgentBrowserValue(output, label) {
  let value;
  try { value = JSON.parse(output.trim()); }
  catch (e) { throw new Error(`could not parse agent-browser ${label} output: ${e.message}`); }
  if (value && typeof value === 'object' && value.data && Object.prototype.hasOwnProperty.call(value.data, 'result')) {
    value = value.data.result;
  }
  if (typeof value === 'string') {
    try { value = JSON.parse(value); } catch (_) { /* a genuine string result */ }
  }
  return value;
}

function evalAgentBrowser(session, js, label, timeoutMs) {
  const out = runAgentBrowser(session, ['--json', 'eval', js], label, { timeoutMs });
  return parseAgentBrowserValue(out, label);
}

function closeCaptureSession(session, baseline) {
  let closeFailure = null;
  try {
    runAgentBrowser(session, ['close'], 'close', { timeoutMs: 5000 });
  } catch (e) {
    closeFailure = e;
  }

  let survivors = [];
  for (let i = 0; i < 20; i++) {
    survivors = newAutomationProcesses(baseline);
    if (survivors.length === 0) break;
    sleepSync(100);
  }
  if (survivors.length) {
    for (const p of survivors) {
      try { process.kill(p.pid, 'SIGTERM'); } catch (_) { /* already exited */ }
    }
    sleepSync(500);
    survivors = newAutomationProcesses(baseline);
    for (const p of survivors) {
      try { process.kill(p.pid, 'SIGKILL'); } catch (_) { /* already exited */ }
    }
    sleepSync(200);
    const afterKill = newAutomationProcesses(baseline);
    const forced = survivors.map((p) => p.pid).join(', ');
    if (afterKill.length) {
      throw new Error(`capture cleanup could not remove PIDs ${afterKill.map((p) => p.pid).join(', ')}`);
    }
    throw new Error(`capture cleanup had to force-terminate orphan PIDs ${forced}`);
  }
  if (closeFailure) throw closeFailure;
}

function abAvailable() {
  try { execFileSync('which', ['agent-browser'], { stdio: 'ignore' }); return true; }
  catch (_) { return false; }
}

// `bin/layout-snapshot capture <seed> [outfile] [--bounds a,b,c,d] [--tier t] [--window w] [--port p]`
function cmdCaptureLive(args) {
  const seed = args.positional[0];
  if (!seed) die('usage: bin/layout-snapshot capture <seed> [outfile] [--bounds minX,minZ,maxX,maxZ] [--tier high] [--window w] [--port 8765]');
  if (!abAvailable()) {
    die('agent-browser not on PATH — install it, or use the manual recipe:\n' +
        `  bin/layout-snapshot --recipe ${seed}`);
  }
  const port = args.flags.port || '8765';
  const tier = args.flags.tier || 'high';
  if (!['low', 'mid', 'high'].includes(tier)) die('--tier must be low, mid, or high');
  const win = args.flags.window || (args.flags.bounds ? 'window' : 'full');
  let B = 'undefined';
  if (args.flags.bounds) {
    const n = args.flags.bounds.split(',').map(Number);
    if (n.length !== 4 || n.some(Number.isNaN)) die('--bounds must be minX,minZ,maxX,maxZ (four numbers)');
    B = `{minX:${n[0]},minZ:${n[1]},maxX:${n[2]},maxZ:${n[3]}}`;
  }
  const url = `http://127.0.0.1:${port}/?worldgen=1&seed=${encodeURIComponent(seed)}&perf=${tier}&layoutCapture=1`;
  const session = `zerble-layout-${process.pid}-${Date.now()}`;
  const baseline = automationProcesses();
  const commandTimeoutMs = Number(args.flags.commandTimeout || DEFAULT_AB_TIMEOUT_MS);
  if (!Number.isFinite(commandTimeoutMs) || commandTimeoutMs < 250) die('--command-timeout must be at least 250ms');
  const settleMs = Number(args.flags.settleMs || 5000);
  if (!Number.isFinite(settleMs) || settleMs < 1000) die('--settle-ms must be at least 1000ms');

  let at = null;
  let captureError = null;
  let cleanupError = null;
  let raw = null;
  try {
    process.stderr.write(`[capture] session ${session}\n`);
    runAgentBrowser(session, ['open', 'about:blank'], 'bootstrap', { timeoutMs: commandTimeoutMs });
    runAgentBrowser(session, ['set', 'viewport', '320', '180'], 'viewport', { timeoutMs: commandTimeoutMs });
    process.stderr.write(`[capture] open ${url}\n`);
    runAgentBrowser(session, ['open', url], 'open', { timeoutMs: commandTimeoutMs, allowTimeout: true });

    let ready = false;
    for (let i = 0; i < 40; i++) {
      try {
        ready = evalAgentBrowser(session, "!!(window.__dbg && window.__game && window.__game.layoutCaptureMode)", 'readiness', commandTimeoutMs) === true;
      } catch (_) { /* page may still be loading after the open wait timed out */ }
      if (ready) break;
      sleepSync(250);
    }
    if (!ready) throw new Error('window.__dbg capture mode did not become ready; confirm the no-cache dev server is running on 127.0.0.1');

    const startRes = evalAgentBrowser(session, 'window.__dbg.start()', 'start', commandTimeoutMs);
    if (startRes !== 'started' && startRes !== 'already running') throw new Error(`unexpected __dbg.start() result: ${String(startRes)}`);

    if (args.flags.forceTimeout) {
      runAgentBrowser(session, ['eval', '(() => { const end = Date.now() + 60000; while (Date.now() < end) {} })()'], 'forced-timeout', { timeoutMs: 500 });
    }

    // Teleport to the window center BEFORE settling (a debug jump, NOT driving —
    // protocol-compliant). Keep windows <= +/-150m so one high-tier load ring
    // fills them fully from one jump.
    if (args.flags.at) {
      const a = args.flags.at.split(',').map(Number);
      if (a.length !== 2 || a.some(Number.isNaN)) throw new Error('--at must be x,z (two numbers)');
      at = { x: a[0], z: a[1] };
      process.stderr.write(`[capture] teleport (${at.x}, ${at.z})\n`);
      evalAgentBrowser(session, `window.__dbg.teleport(${at.x}, ${at.z})`, 'teleport', commandTimeoutMs);
    }

    // Settle on the exact window being captured. Four stable reads after a
    // minimum warm-up avoid both the old unbounded-count climb and a transient
    // one-read plateau between chunk starts.
    let prev = -1, stableReads = 0, count = 0;
    const startedAt = Date.now();
    const MAX_POLLS = 80;
    for (let i = 0; i < MAX_POLLS; i++) {
      sleepSync(250);
      count = Number(evalAgentBrowser(session, `window.__dbg.dumpRegistry(${B}).length`, 'count', commandTimeoutMs)) || 0;
      if (count > 0 && count === prev) stableReads++;
      else stableReads = 0;
      prev = count;
      if (Date.now() - startedAt >= settleMs && stableReads >= 8) {
        process.stderr.write(`[capture] settled at ${count} entries\n`);
        break;
      }
      if (i === MAX_POLLS - 1) process.stderr.write(`[capture] WARNING: not fully settled after ${MAX_POLLS} polls (last=${count}); capturing anyway\n`);
    }

    const dumpJs = `({entries: window.__dbg.dumpRegistry(${B}), drawCounts: window.__dbg.dumpDrawCounts(${B})})`;
    raw = readRawObj(evalAgentBrowser(session, dumpJs, 'dump', commandTimeoutMs), 'agent-browser capture');
  } catch (e) {
    captureError = e;
  } finally {
    try { closeCaptureSession(session, baseline); }
    catch (e) { cleanupError = e; }
  }

  if (captureError || cleanupError) {
    const failures = [captureError, cleanupError].filter(Boolean).map((e) => e.message).join('\ncleanup: ');
    die(`layout capture failed: ${failures}\nFall back to: bin/layout-snapshot --recipe ${seed}`);
  }

  const entries = normalizeEntries(raw.entries);
  const drawCounts = normalizeDrawCounts(raw.drawCounts);
  const snapshot = {
    seed: String(seed), tier, worldgen: true, window: win,
    bounds: args.flags.bounds || null,   // the clip rect, for reproducible re-capture
    at,                                   // teleport target (null = captured at spawn hub)
    entryCount: entries.length,
    moversExcluded: raw.entries.length - entries.length,
    clusterCount: drawCounts ? Object.keys(drawCounts).length : null,
    drawCounts, entries,
  };
  const outPath = args.positional[1] ? path.resolve(args.positional[1]) : path.join(SNAP_DIR, `${seed}.json`);
  ensureDir(path.dirname(outPath));
  fs.writeFileSync(outPath, JSON.stringify(snapshot, null, 2) + '\n');
  process.stdout.write(
    `wrote ${path.relative(ROOT, outPath)}  (${entries.length} layout entries, ${snapshot.moversExcluded} movers dropped, ${snapshot.clusterCount} clusters, tier=${tier})\n`);
}

function loadSnapshot(p) {
  const abs = path.resolve(p);
  if (!fs.existsSync(abs)) die(`snapshot not found: ${p}`);
  return JSON.parse(fs.readFileSync(abs, 'utf8'));
}

// `bin/layout-snapshot --diff <a> <b>` — exit 0 if the LAYOUT is identical,
// 1 otherwise. Compares the normalized entry list and (when present) the
// per-cluster draw-count canary. Metadata (window label, capturedAt) is NOT
// compared — only built truth.
function cmdDiff(args) {
  const [pa, pb] = args.positional;
  if (!pa || !pb) die('usage: bin/layout-snapshot --diff <a.json> <b.json>');
  const A = loadSnapshot(pa), B = loadSnapshot(pb);
  const out = [];
  if (A.tier !== B.tier) out.push(`! tier mismatch: ${A.tier} vs ${B.tier} (snapshots are only comparable at the same pinned tier)`);

  const ea = A.entries || [], eb = B.entries || [];
  const keyOf = (e) => `${e.kind}|${e.x}|${e.z}|${e.footprint}|${e.colliderR}|${e.damage}|${e.attractorR}|${e.attractorW}|${e.chunkKey}`;
  const setA = new Map(), setB = new Map();
  for (const e of ea) setA.set(keyOf(e), (setA.get(keyOf(e)) || 0) + 1);
  for (const e of eb) setB.set(keyOf(e), (setB.get(keyOf(e)) || 0) + 1);
  const onlyA = [], onlyB = [];
  for (const [k, n] of setA) { const m = setB.get(k) || 0; if (n > m) onlyA.push(`${k}  ×${n - m}`); }
  for (const [k, n] of setB) { const m = setA.get(k) || 0; if (n > m) onlyB.push(`${k}  ×${n - m}`); }

  if (ea.length !== eb.length) out.push(`! entry count: ${ea.length} (${path.basename(pa)}) vs ${eb.length} (${path.basename(pb)})`);
  const LIM = 25;
  if (onlyA.length) out.push(`! only in ${path.basename(pa)} (${onlyA.length}):\n    ` + onlyA.slice(0, LIM).join('\n    ') + (onlyA.length > LIM ? `\n    …+${onlyA.length - LIM} more` : ''));
  if (onlyB.length) out.push(`! only in ${path.basename(pb)} (${onlyB.length}):\n    ` + onlyB.slice(0, LIM).join('\n    ') + (onlyB.length > LIM ? `\n    …+${onlyB.length - LIM} more` : ''));

  // Draw-count canary (task 1.4): compare when both carry it.
  if (A.drawCounts && B.drawCounts) {
    const dc = JSON.stringify(A.drawCounts) !== JSON.stringify(B.drawCounts);
    if (dc) out.push('! per-cluster draw counts differ (canary) — positions matched but a draw was added/dropped/reordered');
  }

  if (out.length === 0) {
    process.stdout.write(`EMPTY — layouts identical (${ea.length} entries, tier=${A.tier})\n`);
    process.exit(0);
  }
  process.stdout.write(`DIFF — ${path.basename(pa)} vs ${path.basename(pb)}\n` + out.join('\n') + '\n');
  process.exit(1);
}

function recipeFor(seed, win) {
  const window = win || 'spawn';
  return [
    `# ── capture seed ${seed} (window: ${window}) ────────────────────────────`,
    `# 1. preview_eval:  window.location.href = 'http://127.0.0.1:8765/?worldgen=1&seed=${seed}&perf=high'`,
    `# 2. preview_eval:  window.__dbg.start()`,
    `# 3. settle ~3s, NO driving — then confirm the registry is stable (the entry`,
    `#    count is a faithful proxy for "all chunks in this window have loaded"):`,
    `#    preview_eval:  window.__dbg.dumpRegistry().length`,
    `#    (run twice ~1s apart; capture only once the number stops climbing)`,
    `# 4. preview_eval (entries + canary together, so draw counts travel with positions):`,
    `#    JSON.stringify({entries: window.__dbg.dumpRegistry(B), drawCounts: window.__dbg.dumpDrawCounts(B)})`,
    `#    (B = your bounds object, or omit B for the whole world)`,
    `#    save that string to  verification/raw/${seed}.json`,
    `# 5. normalize:  bin/layout-snapshot ${seed}`,
    ``,
  ].join('\n');
}

function cmdRecipe(args) {
  const seed = args.positional[0];
  if (!seed) die('usage: bin/layout-snapshot --recipe <seed> [window]');
  process.stdout.write(recipeFor(seed, args.positional[1]));
}

// `--seeds [list]` — print the full capture+normalize+diff playbook for each
// seed so the multi-seed ritual is one command's worth of copy-paste.
function cmdSeeds(args) {
  const list = args.positional.length ? args.positional[0].split(',') : DEFAULT_SEEDS;
  process.stdout.write(`# layout-snapshot multi-seed playbook (${list.length} seeds)\n`);
  process.stdout.write(`# capture protocol: ?worldgen=1&perf=high, crowd on, no driving.\n\n`);
  for (const s of list) process.stdout.write(recipeFor(s.trim()));
  process.stdout.write(`# twice-capture self-diff control (task 1.3) — for each seed, capture a\n`);
  process.stdout.write(`# SECOND time into verification/raw/<seed>.b.json, then:\n`);
  for (const s of list) {
    const seed = s.trim();
    process.stdout.write(`#   bin/layout-snapshot ${seed} verification/snapshots/${seed}.b.json --raw verification/raw/${seed}.b.json\n`);
    process.stdout.write(`#   bin/layout-snapshot --diff verification/snapshots/${seed}.json verification/snapshots/${seed}.b.json   # must print EMPTY\n`);
  }
}

function printHelp() {
  process.stdout.write([
    'bin/layout-snapshot — built-truth layout capture/normalize/diff',
    '',
    '  bin/layout-snapshot capture <seed> [outfile]   ONE COMMAND: boot+settle+dump+normalize+write',
    '      (drives a headless browser via agent-browser; needs the dev server on :8765)',
    '      --bounds minX,minZ,maxX,maxZ   clip to a hub window (else full world)',
    '      --tier <t> (default high)  --window <w>  --port <p> (default 8765)',
    '      --command-timeout <ms> (default 12000; every browser command is bounded)',
    '      --settle-ms <ms> (default 5000; require eight stable window reads afterward)',
    '',
    '  bin/layout-snapshot <seed> [outfile]      normalize verification/raw/<seed>.json → snapshot',
    '      --raw <file>    raw capture path (default verification/raw/<seed>.json)',
    '      --stdin         read the raw dumpRegistry() array from stdin instead',
    '      --tier <t>      pinned tier label (default high)',
    '      --window <w>    window label stored in the snapshot (default settled)',
    '  bin/layout-snapshot --diff <a> <b>         exit 0 if layouts identical, 1 + report otherwise',
    '  bin/layout-snapshot --recipe <seed> [win]  print the preview-MCP capture recipe',
    '  bin/layout-snapshot --seeds [csv]          print the multi-seed capture+diff playbook',
    '  bin/layout-snapshot --help',
    '',
    'Built truth lives in the browser; this tool is the deterministic node half.',
    'See the file header and DEBUGGING.md "Layout snapshots" for the full recipe.',
    '',
  ].join('\n'));
}

function parseArgs(argv) {
  const positional = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--stdin') flags.stdin = true;
    else if (a === '--force-timeout') flags.forceTimeout = true;
    else if (a === '--raw' || a === '--tier' || a === '--window' || a === '--bounds' || a === '--port' || a === '--at' || a === '--command-timeout' || a === '--settle-ms') {
      const key = a.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());
      flags[key] = argv[++i];
    }
    else positional.push(a);
  }
  return { positional, flags };
}

function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === '--help' || argv[0] === '-h') return printHelp();
  const mode = argv[0];
  const rest = parseArgs(argv.slice(1));
  if (mode === '--diff') return cmdDiff(rest);
  if (mode === '--recipe') return cmdRecipe(rest);
  if (mode === '--seeds') return cmdSeeds(rest);
  if (mode === 'capture') return cmdCaptureLive(rest);
  // default: normalize an already-captured raw — mode is actually the seed
  return cmdCapture(parseArgs(argv));
}

main();
