#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import vm from 'node:vm';
import {worldHash,mulberry32,getSessionSeed} from '../src/rng.js';
const source=readFileSync(new URL('../src/lurleen.js',import.meta.url),'utf8').replace(/^import .*;\n/gm,'').replace(/export \{ createHeartGeometry \};/,'').replace('export class Lurleen','class Lurleen');
class V{
 constructor(x=0,y=0,z=0){this.set(x,y,z);}set(x,y,z){Object.assign(this,{x,y,z});return this;}copy(p){return this.set(p.x,p.y,p.z);}clone(){return new V(this.x,this.y,this.z);}
 applyMatrix4(root){const r=root.rotation,cr=Math.cos(r.z),sr=Math.sin(r.z),cp=Math.cos(r.x),sp=Math.sin(r.x),ch=Math.cos(r.y),sh=Math.sin(r.y);
 const x=cr*this.x-sr*this.y,y=sr*this.x+cr*this.y,z=this.z,yy=cp*y-sp*z,zz=sp*y+cp*z;return this.set(ch*x+sh*zz+root.position.x,yy+root.position.y,-sh*x+ch*zz+root.position.z);}
}
class Node{constructor(){this.position=new V();this.rotation={x:0,y:0,z:0,set(x,y,z,order){Object.assign(this,{x,y,z,order});}};this.matrixWorld=this;this.children=[];}add(n){this.children.push(n);}updateMatrixWorld(){}}
const near=(a,b,t=1e-8)=>assert(Math.abs(a-b)<t,`${a} != ${b}`);
function fixture(height){
 let draws=0;const random=Object.create(Math);random.random=()=>{draws++;return .4;};const registry={add(e){this.entry=e;return 1;}};
 const context=vm.createContext({THREE:{Group:Node,Vector3:V,MathUtils:{clamp:(n,a,b)=>Math.max(a,Math.min(b,n)),lerp:(a,b,t)=>a+(b-a)*t}},Math:random,registry,worldHash,mulberry32,getSessionSeed,terrainHeight:height,isPointInLake:()=>false,projectOutOfLake:()=>null});
 vm.runInContext(source+';this.Type=Lurleen;',context);const Type=context.Type;
 Type.prototype._buildBody=function(){this._wheels=[[-1.03,-1],[1.03,-1],[-1.03,1],[1.03,1]].map(([x,z])=>{const mesh=new Node();mesh.position.set(x,.53,z);this.root.add(mesh);return{mesh,baseY:.53,front:z<0};});};
 for(const method of ['_buildWindshield','_buildLips','_buildEyes','_buildHair','_buildRearPlatform','_buildRearEquipment','_updateRearEffects','_updateHearts','_emitHearts','_burstHearts'])Type.prototype[method]=function(){};
 const l=new Type(new Node());for(const k of ['_eyeMaterial','_lipMaterial','_lipOutlineMaterial','_hairLightMaterial'])l[k]={};l._hairMaterials=[];l.autoRehome=false;
 return{l,registry,draws:()=>draws};
}
const slope=(x,z)=>4+.12*x-.08*z,flat=()=>0;
function contacts(l,height){
 near(l.root.position.y,l.position.y);assert(l.terrainContactError<1e-7,'wheel support converges');
 for(const w of l._wheels){const p=w.mesh.position.clone().applyMatrix4(l.root.matrixWorld),rest=w.baseY+(l.actorTime==null?0:Math.sin(l.actorTime*10+w.mesh.position.x)*.02);near(p.y,height(p.x,p.z)+rest,1e-7);}
}
const a=fixture(flat),b=fixture(slope);contacts(b.l,slope);
for(const f of [a,b]){f.l.setSpawnAt(5,-7);f.l.wanderTimer=1000;f.l.wanderTarget.set(20,0,-30);}
contacts(b.l,slope);near(b.l.position.y,slope(5,-7));assert.equal(a.draws(),b.draws());
for(const state of ['wandering','aware','following'])for(const heading of [-6.293,0,.9,2.4]){
 for(const f of [a,b]){f.l.state=state;f.l.heading=heading;f.l.awareTimer=100;f.l.wanderTimer=100;}
 for(let i=0;i<20;i++){
  const target=state==='wandering'?new V(1000,0,1000):new V(a.l.position.x+20,0,a.l.position.z+15);
  a.l.update(1/60,target,.7,0);b.l.update(1/60,target,.7,0);
  near(a.l.position.x,b.l.position.x);near(a.l.position.z,b.l.position.z);near(a.l.speed,b.l.speed);near(a.l.heading,b.l.heading);contacts(b.l,slope);
  near(a.l.position.y,0);for(const w of a.l._wheels)near(w.mesh.position.y,w.baseY+Math.sin(a.l.actorTime*10+w.mesh.position.x)*.02);
 }
}
assert.equal(a.draws(),b.draws(),'terrain fitting never consumes or reorders behavioral RNG');
assert.equal(b.registry.entry.position,b.l.position,'the authoritative collider retains the original mutable position');
for(const f of [a,b]){f.l.autoRehome=true;f.l._everMet=false;f.l._rehomeTimer=-1;f.l.update(.01,new V(2000,0,2000),1,0);}
contacts(b.l,slope);near(a.l.position.x,b.l.position.x);near(a.l.position.z,b.l.position.z);assert.equal(a.draws(),b.draws());
b.l.position.set(8,0,12);const draws=b.draws();b.l.groundOnTerrain();contacts(b.l,slope);assert.equal(b.draws(),draws,'rescue repositioning grounds immediately without extra random draws');
const main=readFileSync(new URL('../src/main.js',import.meta.url),'utf8');assert(/lurleen\.position\.set\([\s\S]{0,180}lurleen\.groundOnTerrain\(\)/.test(main),'the production rescue calls immediate grounding');
console.log('PASS Lurleen terrain: constructor/spawn, 240 moving state/heading frames, four wheel contacts, flat-world jiggle, unchanged X/Z/speed/heading/RNG, original collider position, early-return rehome and rescue.');
