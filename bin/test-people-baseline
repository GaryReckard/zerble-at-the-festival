#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {PeopleBaseline,captureRenderInventory,withBaselineRandom} from '../src/people/baseline.js';
let time=0;
const baseline=new PeopleBaseline({warmup:1,samples:2,now:()=>time});
const parent={move(v){time+=2;return v+1;}},object=Object.create(parent);
baseline.start({seed:1977});baseline.watch(object,'move');
for(let i=0;i<3;i++){
 time=i*20;baseline.begin();assert.equal(object.move(i),i+1);baseline.count('candidates',7);
 time+=3;baseline.end(()=>({hidden:false}));
}
assert.equal(baseline.active,false);assert.equal(Object.hasOwn(object,'move'),false,'inherited method restored without shadow');
let report=baseline.report();assert(report.complete);assert.equal(report.frames.length,2);
assert.equal(report.operations.move.calls,2,'warmup excluded');assert.equal(report.workMs.p50,5);assert.equal(report.wallMs.p95,20);
assert.equal(report.frames[0].counts.candidates,7);report.frames.length=0;assert.equal(baseline.report().frames.length,2);
baseline.start({});const old=object.move;baseline.watch(object,'move');object.move=()=>42;baseline.stop();assert.equal(object.move(),42,'concurrent replacement survives cleanup');
object.move=old;const throwing={run(){throw Error('expected');}};baseline.start({});baseline.watch(throwing,'run');assert.throws(()=>throwing.run(),/expected/);baseline.stop();assert.equal(throwing.run.name,'run');
assert.throws(()=>new PeopleBaseline({samples:0}),RangeError);
console.log('PASS people baseline: warmup, bounded samples, distributions, copied reports, exact probe restoration, concurrent replacement and exception cleanup.');

for(const path of process.argv.slice(2)) {
 const data=JSON.parse(readFileSync(path,'utf8'));
 assert(data.complete);assert.equal(data.frames.length,180);assert.equal(data.warmup,120);
 assert.equal(data.metadata.seed,1977);assert.equal(data.metadata.qualityPinned,0);
 assert.equal(data.metadata.probesRestored,true);
 assert(data.frames.every(f=>f.quality===0));
 for(const field of ['canvasW','canvasH','targetW','targetH'])assert(data.frames.every(f=>f[field]>0&&f[field]===data.frames[0][field]),field+' stable');
 assert(data.frames.some(f=>f.counts.matrixWrites>0));
 assert(data.frames.some(f=>f.counts.collisionCandidates>0));
 assert.equal(data.frames.reduce((sum,f)=>sum+(f.counts.successfulSpawnProbes??0),0),3);
 assert(data.operations['crowd.spawn'].calls>=3);assert(data.operations['crowd.removeNpc'].calls>=3);
 assert.equal(data.workMs.n,180);assert(data.workMs.p50<=data.workMs.p95);
 console.log(`PASS baseline artifact ${path}: pinned quality and dimensions, frame/operation measurements, three successful spawn/remove probes and restored instrumentation.`);
}

const texture={isTexture:true},material={type:'MeshBasicMaterial',map:texture};
const geometry={index:{count:6},groups:[{},{}]},mesh={isMesh:true,geometry,material:[material,{type:'MeshLambertMaterial'}],castShadow:true,children:[]};
const instanced={isMesh:true,isInstancedMesh:true,count:4,geometry,material,children:[]};
const actor={visible:false,children:[instanced]},scene={children:[mesh,actor]};
const inventory=captureRenderInventory(scene,{actors:actor});
assert.equal(inventory.buckets.world.potentialDraws,2);assert.equal(inventory.buckets.world.potentialTriangles,2);assert.equal(inventory.buckets.world.shadowDraws,2);
assert.equal(inventory.buckets.actors.potentialDraws,1);assert.equal(inventory.buckets.actors.potentialTriangles,8);assert.equal(inventory.buckets.actors.visibleMeshes,0);
assert.deepEqual(inventory.resources,{geometries:1,materials:2,materialTextures:1});
inventory.buckets.actors.meshes=100;assert.equal(captureRenderInventory(scene,{actors:actor}).buckets.actors.meshes,1);
console.log('PASS scene inventory: named population roots, packed instance capacity, multi-material draw groups, shared resource deduplication and visibility-independent topology');

const ordinaryRandom=Math.random;
const randomValues=()=>[Math.random(),Math.random(),Math.random()];
assert.deepEqual(withBaselineRandom(randomValues,42,true),withBaselineRandom(randomValues,42,true));
assert.equal(Math.random,ordinaryRandom);assert.throws(()=>withBaselineRandom(()=>{throw Error('construction failed');},42,true));assert.equal(Math.random,ordinaryRandom);
assert.equal(withBaselineRandom(()=>Math.random,42,false),ordinaryRandom);
console.log('PASS comparison cohort: isolated construction salts, inert default and exact RNG restoration on success/failure');
