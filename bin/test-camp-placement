#!/usr/bin/env node
import assert from 'node:assert/strict';
import fs from 'node:fs';
import { mulberry32 } from '../src/rng.js';
import { planCampNeighborhood } from '../src/campPlanning.js';
import { FESTIVAL_TUNING } from '../src/worldgen/tuning.js';
const source=fs.readFileSync(new URL('../src/chunks.js',import.meta.url),'utf8');
const village=source.slice(source.indexOf('function buildCampVillageAt('),source.indexOf('// The sandbox exercises'));
const extract=Function('FESTIVAL_TUNING','campsiteFootprint','isPointInLake','registry','THREE','CLUSTER_GUARD_SKIP','placeSingleCampsite','planCampNeighborhood',`${village}; return buildCampVillageAt;`);
const fp=size=>({small:14,medium:18,large:22}[size]);
let minimum=Infinity,maximum=0,compactCount=0;
for(let seed=0;seed<1000;seed++)for(const target of [5,7,8,12,20,22]){
 const camps=[];
 const registry={closestBuilding(p,r){return camps.some(c=>Math.hypot(c.x-p.x,c.z-p.z)<c.r+r);}};
 const place=(ctx,x,z,size,yaw,options)=>{const r=options.footprint;camps.push({x,z,r,yaw,size,options});return {};};
 const build=extract(FESTIVAL_TUNING,fp,()=>false,registry,{Vector3:class{constructor(x,y,z){Object.assign(this,{x,y,z});}}},new Set(),place,planCampNeighborhood);
 build({rng:mulberry32(seed)},100,200,target);
 assert.ok(camps.length >= (target>=12?6:4),`seed ${seed} target ${target} remains a mixed cluster`);
 const tents=camps.reduce((n,c)=>n+({small:1,medium:2,large:3}[c.size]),0);
 assert.ok(tents >= (target>=12 ? 10 : 5), 'village growth supplies useful tent capacity');
 assert.equal(camps[0].options.role,'host');
 assert.ok(camps.slice(1).every(c=>c.options.role==='satellite' && !c.options.plan.fire && !c.options.plan.kitchen),'satellites share the host living space');
 for(const camp of camps) assert.ok(Math.hypot(camp.x-100,camp.z-200)+camp.r<=FESTIVAL_TUNING.KIND_FOOTPRINT.camp_village,'whole camp stays within planner reservation');
 assert.ok(camps.every(c=>c.options.campNeighborhood===camps[0].options.campNeighborhood),'production builder tags shared reservations for exact physical clearance');
 if(camps[0].size==='small'){compactCount++;assert(camps.slice(1).some(c=>Math.hypot(c.x-camps[0].x,c.z-camps[0].z)<c.r+camps[0].r),'compact neighborhood shares empty ground');}
 minimum=Math.min(minimum,camps.length);maximum=Math.max(maximum,camps.length);
}
console.log(`PASS 6000 production village layouts: ${minimum}-${maximum} sites, planner bounds and shared frontages (physical clearance tested by test-campsite-layout)`);

let attempts=0;
const blockedHost=extract(FESTIVAL_TUNING,fp,()=>false,{}, {},new Set(),()=>{attempts++;return null;},planCampNeighborhood);
blockedHost({rng:mulberry32(1)},0,0,16);
assert.equal(attempts,1,'satellites must not appear without their shared host');
console.log('PASS blocked host suppresses dependent satellite pitches');

console.log(`Observed compact neighborhoods: ${compactCount}/6000`);
assert(compactCount>4000&&compactCount<5500,'production mixes compact merged frontages and roomier neighborhoods');

// Execute the real forest planner, including its path/body/clearing filters.
// A filtered host cannot leave dependent sleeping-only satellites behind.
const forestSource=fs.readFileSync(new URL('../src/forests.js',import.meta.url),'utf8');
const forestPlanning=forestSource.slice(forestSource.indexOf('function computeInteriorCampsitePositions('),forestSource.indexOf('function roleFromOffset('));
const forestCorridor=forestSource.slice(forestSource.indexOf('function pointInPathCorridor('),forestSource.indexOf('// ---------- Forest edge colliders'));
const planForest=Function('planCampNeighborhood','mulberry32','campsiteFootprint',`${forestPlanning}\n${forestCorridor};return computeInteriorCampsitePositions;`)(planCampNeighborhood,mulberry32,fp);
let forestPitches=0;
for(let seed=0;seed<500;seed++) {
  const forest={seed,centerX:0,centerZ:0,bodyRadius:105,pathDirIdx:0,backPathDirIdx:null,interiorContent:'campsite'};
  const planned=planForest(forest);
  assert.deepEqual(planned,planForest(forest),'forest filtering remains deterministic');
  for(const neighborhood of new Set(planned.map(p=>p.neighborhood))) {
    const household=planned.filter(p=>p.neighborhood===neighborhood);
    assert.equal(household[0].role,'host',`forest seed ${seed}, household ${neighborhood} retains its shared host`);
    assert.equal(household.filter(p=>p.role==='host').length,1);
  }
  forestPitches+=planned.length;
}
assert(forestPitches>0,'host gating must still build valid forest households');

// Repeat the constraint after physical preflight, which can reject a planned
// host because actual tree/neighbor geometry is unavailable to the pure plan.
const forestBuild=forestSource.slice(forestSource.indexOf('function buildInteriorCampsites('),forestSource.indexOf('function buildForestCampsite('));
const registered=[],built=[];
let preflightCalls=0;
const buildInterior=Function('mulberry32','hash2','buildCampsite','canPlaceCampsite','registry','pushCampsiteAnimatables','registerCampsite',
  `${forestBuild};return buildInteriorCampsites;`)(mulberry32,(x,z)=>x+z,
  (rng,size,options)=>{built.push(options.role);return {group:{position:{set(){}},rotation:{},traverse(){}},role:options.role};},
  ()=>++preflightCalls!==1,{},()=>{},(registry,camp,options)=>registered.push({role:camp.role,owner:options.chunkKey}));
buildInterior({key:'forest-owner',group:{add(){}}},{seed:12,interiorCampsitePositions:[
  {x:0,z:0,size:'small',facing:0,role:'host',neighborhood:0},
  {x:10,z:0,size:'small',facing:0,role:'satellite',neighborhood:0},
  {x:50,z:0,size:'small',facing:0,role:'host',neighborhood:1},
  {x:60,z:0,size:'small',facing:0,role:'satellite',neighborhood:1},
]});
assert.deepEqual(built,['host','host','satellite'],'physical host rejection skips only its own dependent household');
assert.deepEqual(registered.map(c=>c.role),['host','satellite'],'another valid household still builds');
assert(registered.every(c=>c.owner==='forest-owner'),'all forest household pieces retain their center-chunk owner');
console.log(`PASS 500 real forest plans (${forestPitches} pitches): host filtering, deterministic groups, runtime rejection and center-chunk ownership`);
