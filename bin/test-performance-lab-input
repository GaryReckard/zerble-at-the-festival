#!/usr/bin/env node
import assert from 'node:assert/strict';
const events={};globalThis.window={addEventListener:(n,f)=>events[n]=f};
const {Input}=await import('../src/input.js');const {Touch}=await import('../src/touch.js');
const key=(name,key)=>events[name]({key,preventDefault(){}});
key('keydown','w');assert.equal(Input.throttle,1);
let aborted=0;const command={throttle:.5,steer:-.3,boost:true,brake:true};
const release=Input.acquireDiagnostic(command,()=>aborted++);
assert.throws(()=>Input.acquireDiagnostic({}),/already owned/);
for(const k of ['w','a','Shift','ArrowLeft','v','m'])key('keydown',k);
Object.assign(Touch.state,{steer:1,throttle:-1,camYawDelta:1,camPitchDelta:1});
assert.equal(Input.throttle,.5);assert.equal(Input.steer,-.3);assert.equal(Input.boost,true);assert.equal(Input.brake,true);
assert.equal(Input.camYaw,0);assert.equal(Input.camPitch,0);assert.deepEqual(Input.consumeCamDeltas(),{yaw:0,pitch:0});assert.equal(Input.consumeZoom(),1);
assert.equal(Input.consumePressed('V'),false);assert.equal(Input.isDown('G'),false);key('keydown','Escape');assert.equal(aborted,1);
release();release();assert.equal(Input.throttle,0);assert.equal(Input.consumePressed('V'),false);assert.equal(Input.brake,false);
key('keyup','w');key('keydown','w');assert.equal(Input.throttle,1);key('keyup','w');assert.equal(Input.throttle,0);
const releaseNew=Input.acquireDiagnostic({throttle:0});key('keydown','w');releaseNew();
events.keydown({key:'w',repeat:true,preventDefault(){}});
assert.equal(Input.throttle,0,'a key first pressed during diagnostics cannot leak auto-repeat after release');
assert.equal(Input.consumePressed('W'),false);
key('keyup','w');key('keydown','w');assert.equal(Input.throttle,1);key('keyup','w');
const releaseUp=Input.acquireDiagnostic({throttle:0});key('keydown','w');key('keyup','w');releaseUp();
key('keydown','w');assert.equal(Input.throttle,1,'keyup during diagnostics permits the next genuine press');key('keyup','w');
const {FrameBuffer,routeControl}=await import('../src/performanceLab/scenarios.js');
const b=new FrameBuffer(2);assert(b.push(16,8,0,0,0));assert(b.push(30,20,1,.01,10));assert.equal(b.push(100,80,2,0,0),false);assert(b.overflow);assert.deepEqual(b.export(),[[16,8,0,0,0],[30,20,1,.01,10]]);
assert(Math.abs(routeControl({x:0,z:0},0,[0,-100],10).steer)<1e-12);assert(routeControl({x:0,z:0},0,[-100,0],10).steer>0);
console.log('PASS performance-lab input: live-axis/edge/touch/camera/zoom exclusion, abort, held restoration, ordinary keyboard, exact bounded frame export and normal-controller waypoint signs');

const {observeLoaded,segmentDistance}=await import('../src/performanceLab/scenarios.js');
const loaded=new Map(),observed=[];const restore=observeLoaded(loaded,(kind,key)=>observed.push([kind,key]));
loaded.set('a',{});loaded.set('a',{});loaded.delete('missing');loaded.delete('a');restore();
assert.deepEqual(observed,[['load','a'],['unload','a']]);assert.equal(Object.hasOwn(loaded,'set'),false);assert.equal(Object.hasOwn(loaded,'delete'),false);
assert.equal(segmentDistance({x:20,z:50},[0,0],[0,100]),20);
const {roadGuidance}=await import('../src/performanceLab/scenarios.js');
const straight=roadGuidance({x:0,z:0},0,[[0,0],[0,-100],[0,-200]],0,10);
assert(straight.control.boost&&straight.control.throttle===1&&!straight.control.brake);
const corner=roadGuidance({x:0,z:-92},0,[[0,0],[0,-100],[100,-100]],0,24);
assert(corner.control.brake&&!corner.control.boost&&corner.control.throttle===0);
const advanced=roadGuidance({x:0,z:-101},0,[[0,0],[0,-100],[100,-100]],0,6);
assert.equal(advanced.index,1);assert(advanced.control.steer<0);assert(Number.isFinite(advanced.control.steer));
assert.equal(roadGuidance({x:30,z:-50},0,[[0,0],[0,-100]],0,10).corridor,30);
console.log('PASS road policy: straight acceleration/boost, anticipatory braking, passed-waypoint progression, steering signs and real-polyline corridor distance');
