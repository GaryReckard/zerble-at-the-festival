#!/usr/bin/env node
import assert from 'node:assert/strict';
import { register } from 'node:module';
register('./node-three-shim.mjs', import.meta.url);
const { Registry } = await import('../src/registry.js');
const { resolveNearbyFacility, isGenericFacility, registerHammockDropoff } = await import('../src/quests/facilityArrival.js');
const { gatherDestinations } = await import('../src/quests/worldSource.js');
const markersOnly = new Registry();
registerHammockDropoff(markersOnly, 0, 0, 0, 'decorative');
assert.equal(markersOnly.closestGenerationBuilding({x:0,z:0}, 100), null);
let collisions = 0, footprints = 0;
markersOnly.collidersNear(0,0,100,()=>collisions++);
markersOnly.footprintsNear(0,0,100,()=>footprints++);
assert.equal(collisions,0); assert.equal(footprints,0);
const registry = new Registry();
const player = { x: 0, z: 0 };
const quest = { kind: 'hammock', x: 200, z: 200, radius: 25, startDist: 300, timeLeft: 55 };
const original = structuredClone(quest);
assert.equal(resolveNearbyFacility(quest, player, registry), null);
assert.equal(resolveNearbyFacility(quest, player, null), null);
assert.equal(resolveNearbyFacility(null, player, registry), null);
assert.equal(isGenericFacility({kind:'camp_village'}), false);
const add = (kind,x,z=0) => registry.add({kind,position:{x,y:0,z},footprint:1,chunkKey:'built'});
add('porta_potty', 0);
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'wrong facility cannot complete');
const far = add('hammock', 26);
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'outside radius');
const edge = add('hammock', 25);
assert.deepEqual(resolveNearbyFacility(quest, player, registry), {x:25,z:0,radius:25});
registry.remove(edge);
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'removed original is not a phantom destination');
const before = registry.closestGenerationBuilding(player, 3);
let randomCalls = 0;
const random = Math.random;
Math.random = () => { randomCalls++; throw new Error('marker consumed RNG'); };
let marker;
try { marker = registerHammockDropoff(registry, 2, 4, 0, 'trees'); }
finally { Math.random = random; }
assert.equal(randomCalls, 0);
assert.deepEqual(resolveNearbyFacility(quest, player, registry), {x:2,z:0,radius:25});
assert.deepEqual(registry.closestGenerationBuilding(player, 3), before, 'marker does not alter placement admission');
const entry = registry.entries.get(marker);
assert.equal(entry.footprint,0);
for (const field of ['collider','attractor','hammock']) assert.equal(entry[field],undefined);
registry.remove(far);
assert(gatherDestinations(player,{registry,worldgen:false}).some(c=>c.kind==='hammock'&&c.x===2), 'decorative hammock is an offer target');
registry.removeChunk('trees');
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'unloaded decorative hammock no longer matches');
assert.deepEqual(quest, original, 'alternatives preserve original route, reward distance and deadline');
assert.equal(resolveNearbyFacility({kind:'main_stage'},player,registry),null);
assert.deepEqual(resolveNearbyFacility({kind:'porta_potty'}, {x:16,z:0}, registry),{x:0,z:0,radius:16});
assert.equal(resolveNearbyFacility({kind:'porta_potty'}, {x:16.01,z:0}, registry),null);
console.log('quest facilities: built alternatives, boundaries, lifecycle, nonblocking markers and RNG independence OK');
