#!/usr/bin/env node
import assert from 'node:assert/strict';
import { register } from 'node:module';
register('./node-three-shim.mjs', import.meta.url);
const { Registry } = await import('../src/registry.js');
const { resolveNearbyFacility, isGenericFacility, registerTreeHammock } = await import('../src/quests/facilityArrival.js');
const { gatherDestinations } = await import('../src/quests/worldSource.js');
const { buildTreeHammock } = await import('../src/models/hammock.js');
const model = buildTreeHammock(-2, 0, 2, 0, () => .3, .5, 1);
const groundAt = (x, z) => 4 + x * .1 + z * .2;
const markersOnly = new Registry();
registerTreeHammock(markersOnly, model, 4, 'decorative', groundAt);
assert.equal(markersOnly.closestGenerationBuilding({x:0,z:0}, 100), null);
let collisions = 0, footprints = 0;
markersOnly.collidersNear(0,0,100,()=>collisions++);
markersOnly.footprintsNear(0,0,100,()=>footprints++);
assert.equal(collisions,0); assert.equal(footprints,0);
const registry = new Registry();
const player = { x: 0, z: 0 };
const quest = { kind: 'hammock', x: 200, z: 200, radius: 25, startDist: 300, timeLeft: 55 };
const original = structuredClone(quest);
assert.equal(resolveNearbyFacility(quest, player, registry), null);
assert.equal(resolveNearbyFacility(quest, player, null), null);
assert.equal(resolveNearbyFacility(null, player, registry), null);
assert.equal(isGenericFacility({kind:'camp_village'}), false);
const add = (kind,x,z=0) => registry.add({kind,position:{x,y:0,z},footprint:1,chunkKey:'built', ...(kind==='hammock' ? {hammock:{occupied:false}} : kind==='porta_potty' ? {potty:{occupied:false}} : {})});
const potty = add('porta_potty', 0);
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'wrong facility cannot complete');
const far = add('hammock', 26);
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'outside radius');
const edge = add('hammock', 25);
assert.deepEqual(resolveNearbyFacility(quest, player, registry), {x:25,z:0,radius:25,entryId:edge,approach:{x:25,y:0,z:0}});
registry.remove(edge);
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'removed original is not a phantom destination');
const before = registry.closestGenerationBuilding(player, 3);
let randomCalls = 0;
const random = Math.random;
Math.random = () => { randomCalls++; throw new Error('marker consumed RNG'); };
let marker;
try { marker = registerTreeHammock(registry, model, 4, 'trees', groundAt); }
finally { Math.random = random; }
assert.equal(randomCalls, 0);
const resolved = resolveNearbyFacility(quest, player, registry);
assert.equal(resolved.entryId, marker);
assert.equal(resolved.x, model.seatPos.x);
assert.deepEqual(resolved.approach, registry.entries.get(marker).hammock.approaches[0]);
assert.deepEqual(registry.closestGenerationBuilding(player, 3), before, 'marker does not alter placement admission');
const entry = registry.entries.get(marker);
assert.equal(entry.footprint,0);
for (const field of ['collider','attractor']) assert.equal(entry[field],undefined);
registry.remove(far);
assert(gatherDestinations(player,{registry,worldgen:false}).some(c=>c.kind==='hammock'&&c.x===model.seatPos.x), 'decorative hammock is an offer target');
assert.equal(entry.kind, 'hammock');
assert.equal(entry.hammock.seatPos.y, model.seatPos.y + 4);
assert.equal(entry.hammock.yaw, 0);
assert.equal(entry.hammock.approaches.length, 2);
for (const a of entry.hammock.approaches) assert.equal(a.y, groundAt(a.x, a.z));
assert.equal(resolveNearbyFacility(quest, player, registry, () => null), null, 'owner rejects reserved/unreachable seats');
const alternative = add('hammock', 10);
const admitted = resolveNearbyFacility(quest, player, registry, e => e.id === alternative ? e.position : null);
assert.equal(admitted.entryId, alternative, 'a rejected nearest seat does not hide an accepted farther seat');
registry.remove(alternative);
const chosen = entry.hammock.approaches[1];
assert.equal(resolveNearbyFacility(quest, player, registry, e => e === entry ? chosen : null).approach, chosen);
entry.hammock.occupied = true;
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'occupied hammock cannot complete');
assert(!gatherDestinations(player,{registry,worldgen:false}).some(c=>c.kind==='hammock'), 'occupied hammock is not offered');
entry.hammock.occupied = false;
registry.removeChunk('trees');
assert.equal(resolveNearbyFacility(quest, player, registry), null, 'unloaded decorative hammock no longer matches');
assert.deepEqual(quest, original, 'alternatives preserve original route, reward distance and deadline');
assert.equal(resolveNearbyFacility({kind:'main_stage'},player,registry),null);
assert.deepEqual(resolveNearbyFacility({kind:'porta_potty'}, {x:16,z:0}, registry),{x:0,z:0,radius:16,entryId:potty,approach:{x:0,y:0,z:0}});
assert.equal(resolveNearbyFacility({kind:'porta_potty'}, {x:16.01,z:0}, registry),null);
console.log('quest facilities: built alternatives, boundaries, lifecycle, nonblocking real seats, owner admission and RNG independence OK');

registry.entries.get(potty).potty.occupied = true;
assert.equal(resolveNearbyFacility({kind:'porta_potty'},player,registry),null, 'occupied potty cannot complete');
