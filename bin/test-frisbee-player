#!/usr/bin/env node

import { register } from 'node:module';
register('./node-three-shim.mjs', import.meta.url);

const {
  buildFrisbeePlayer,
  tickFrisbeePlayer,
} = await import('../src/models/frisbeePlayer.js');

function assert(condition, message) {
  if (!condition) {
    process.stderr.write(`FAIL: ${message}\n`);
    process.exit(1);
  }
}

const player = buildFrisbeePlayer(() => 0.25);
const { left, right } = player.userData.armRigs;

function settle(action, amount) {
  for (let i = 0; i < 20; i++) tickFrisbeePlayer(player, 0.1, action, amount);
}

assert(left && right, 'the frisbee player should expose both arm rigs');
assert(left.elbow && right.elbow, 'each frisbee arm should have an elbow joint');
assert(Math.abs(left.shoulder.rotation.z) < 0.2 && Math.abs(right.shoulder.rotation.z) < 0.2,
  'both arms should start hanging near vertical');

settle('catch', 1);
assert(right.shoulder.rotation.z > Math.PI / 2,
  'the catch pose should raise the right arm up and outward');
assert(Math.abs(left.shoulder.rotation.z) < 0.2,
  'the non-catching arm should stay relaxed');

settle('throw', 0.52);
assert(Math.abs(right.elbow.rotation.z + Math.PI / 2) < 0.08,
  'the throw windup should bend the elbow about 90 degrees across the body');
assert(Math.abs(left.elbow.rotation.z) < 0.05,
  'the non-throwing elbow should remain straight and relaxed');

settle('throw', 1);
assert(Math.abs(right.elbow.rotation.z) < 0.1,
  'the throwing elbow should straighten through release');
assert(right.shoulder.rotation.x > 1.1,
  'the release should angle the straight throwing arm forward');

settle('relaxed', 0);
assert(Math.abs(right.shoulder.rotation.z) < 0.2 && Math.abs(right.elbow.rotation.z) < 0.05,
  'the throwing arm should return to the hanging relaxed pose');

process.stdout.write('PASS  frisbee player has relaxed, one-arm catch, windup, and release poses\n');
