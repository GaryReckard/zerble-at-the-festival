#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {Vector3} from 'three';
import {setSessionSeed} from '../src/rng.js';
import {nearestRoad,roadsInBounds,shapesClearOfRoads} from '../src/worldgen/roads.js';
import {heartsInBounds} from '../src/worldgen/hearts.js';
import {festivalPlan} from '../src/worldgen/festival.js';
import {clusterShapes} from '../src/worldgen/tuning.js';
import {setLandscapeVersion} from '../src/worldgen/landscapeCandidates.js';
const source=readFileSync(new URL('../src/chunks.js',import.meta.url),'utf8');
const code=source.slice(source.indexOf('function _pottyRowRight('),source.indexOf('function buildPottyBank(',source.indexOf('function _pottyRowRight(')));
const guard=Function('registry','THREE','terrainHeight','CLUSTER_GUARD_SKIP','isPointInLake','landscapeClearance','roadsInBounds','shapesClearOfRoads','PAVED_ROAD_WIDTH','POTTY_FOOTPRINT','POTTY_SPACING',code+';return pottyRowClear;');
const make=(roads=roadsInBounds,clearance=()=>false)=>guard({closestGenerationBuilding:()=>null},{Vector3},()=>0,new Set(),()=>false,clearance,roads,shapesClearOfRoads,9,1.3,2.5);
for(const version of [1,2]){
 setSessionSeed(3232217193);setLandscapeVersion(version);
 const clear=make(),x=1497.87,z=868.42;
 assert.ok(nearestRoad(x,z).dist<.1,'reported marker lies on the real seeded arterial');
 assert.equal(clear(x,z,-3.04565148,2),false,'the reported on-road bank is rejected');
 let posts=0;
 for(const heart of heartsInBounds(800,200,2200,1600))for(const post of festivalPlan(heart))if(post.kind==='welfare_post'){
   assert.ok(shapesClearOfRoads(clusterShapes(post.kind,post.scale,post.x,post.z,post.yaw),roadsInBounds(post.x-30,post.z-30,post.x+30,post.z+30)),`full seeded welfare envelope clears roads at ${post.x},${post.z}`);posts++;
 }
 assert.ok(posts>0,'road checks retain usable seeded welfare posts');
}
const roadAt=(x,width=9)=>({width,points:[{x,z:-20},{x,z:20}]});
assert.equal(make(()=>[roadAt(6.4)])(0,0,0,1),true,'a full unit and margin fit beyond the road edge');
assert.equal(make(()=>[roadAt(6.2)])(0,0,0,1),false,'a clear center cannot admit an overlapping footprint');
assert.equal(make(()=>[roadAt(5.5,7),roadAt(-5.6,9)])(0,0,0,1),false,'a farther wide road still excludes the footprint when the closest narrow road clears');
let calls=0;assert.equal(make(()=>[roadAt(++calls===2?0:10)])(0,0,0,3),false,'check each unit, including the middle of a wide row');
assert.equal(make(()=>[],()=>true)(0,0,0,1),false,'canonical landscape routes remain reserved');
setLandscapeVersion(1);setSessionSeed(0);
console.log('PASS seeded welfare envelopes and every built potty footprint clear arterial and landscape driving paths.');
