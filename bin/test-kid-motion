#!/usr/bin/env node

import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import vm from 'node:vm';

const source = readFileSync(new URL('../src/obstacles.js', import.meta.url), 'utf8');
const start = source.indexOf('  update(dt, bubbles, zerble, smiles) {', source.indexOf('export class KidGaggle {'));
const end = source.indexOf('\n}\n', start);
assert(start >= 0 && end > start, 'find the production KidGaggle.update method');
const nudgeStart = source.indexOf('function nudgeKidFromNeighbors(');
const nudgeEnd = source.indexOf('\n}\n', nudgeStart) + 2;
assert(nudgeStart >= 0 && nudgeEnd > nudgeStart, 'find the production kid separation nudge');

class Vector {
  constructor(x = 0, y = 0, z = 0) { this.set(x, y, z); }
  set(x, y, z) { Object.assign(this, { x, y, z }); return this; }
  copy(p) { return this.set(p.x, p.y, p.z); }
  clone() { return new Vector(this.x, this.y, this.z); }
  distanceTo(p) { return Math.hypot(this.x - p.x, this.y - p.y, this.z - p.z); }
}

const poses = [];
const testConstraints = { hardCollider: null, lakeRadius: 0 };
const nudgeKidFromNeighbors = vm.runInNewContext(`(${source.slice(nudgeStart, nudgeEnd).replace('function nudgeKidFromNeighbors', 'function')})`, {
  KID_SOFT_SEPARATION: 1.4,
});
const update = vm.runInNewContext(`({${source.slice(start, end)}}).update`, {
  Math: Object.assign(Object.create(Math), { random: () => 0.5 }),
  terrainHeight: () => 0,
  KID_HARD_SEPARATION: 0.82,
  nudgeKidFromNeighbors,
  isPointInLake: (x, z) => testConstraints.lakeRadius > 0 && x * x + z * z < testConstraints.lakeRadius ** 2,
  projectOutOfLake: (x, z, margin) => {
    const distance = Math.hypot(x, z) || 1;
    const radius = testConstraints.lakeRadius + margin;
    return { x: x / distance * radius, z: z / distance * radius };
  },
  StarPower: { isActive: () => false },
  laneDodgeTest: () => false,
  pushOutOfHardColliders: (object, kidRadius) => {
    const collider = testConstraints.hardCollider;
    if (!collider) return;
    const dx = object.position.x - collider.x, dz = object.position.z - collider.z;
    const distance = Math.hypot(dx, dz);
    const minimum = collider.radius + kidRadius;
    if (distance >= minimum) return;
    const direction = distance > 1e-8 ? 1 / distance : 1;
    object.position.x = collider.x + (distance > 1e-8 ? dx * direction : 1) * minimum;
    object.position.z = collider.z + (distance > 1e-8 ? dz * direction : 0) * minimum;
  },
  tickKid: (kid, dt, options) => poses.push({ yaw: options.targetYaw, excited: options.excited }),
});
const kid = (x = 0, z = 0) => ({
  position: new Vector(x, 0, z),
  userData: {
    center: new Vector(x, 0, z), heading: -Math.PI / 2, displayedYaw: -Math.PI / 2,
    turnTimer: 10, speed: 4, chaseHoldTimer: 0, chaseDirX: 0, chaseDirZ: 0,
    scatterTimer: 0, fleeUrgency: 1, happiness: 0, smileTimeCooldown: 0, lastSmilePos: null,
  },
});
const setup = (k) => ({ kids: [k], colliders: [{ position: new Vector() }] });
const pool = (points) => ({ forEachAlive(fn) { for (const pos of points) fn({ pos }); } });
const step = (g, points, dt = 1 / 60, zerble = null) => update.call(g, dt, pool(points), zerble, null);
const parkedCart = {
  position: new Vector(0, 0, 0), nozzleWorld: new Vector(0, 0, 2),
  forwardWorld: new Vector(0, 0, -1), speed: 0,
};

// A bubble at arm's reach should not make a child alternately sprint and wander.
{
  const k = kid(0.6, 0), g = setup(k), bubble = new Vector(0, 1, 0);
  for (let n = 0; n < 60; n++) {
    step(g, [bubble]);
    assert(Math.hypot(k.position.x - bubble.x, k.position.z - bubble.z) <= 0.71,
      `kid stays at the grab radius of a stationary bubble on frame ${n}`);
  }
}

// A whole gaggle chasing one point must not collapse into one shared position,
// including the degenerate case where their starting coordinates coincide.
{
  const kids = Array.from({ length: 64 }, () => kid(0, 0));
  const g = {
    kids,
    colliders: kids.map(() => ({ position: new Vector() })),
  };
  const bubble = new Vector(0, 1, 0);
  for (let n = 0; n < 30; n++) {
    step(g, [bubble]);
    for (let i = 0; i < kids.length; i++) {
      assert.equal(g.colliders[i].position.x, kids[i].position.x,
        `kid collider follows its final separated position on frame ${n}`);
      for (let j = i + 1; j < kids.length; j++) {
        const d = Math.hypot(kids[i].position.x - kids[j].position.x, kids[i].position.z - kids[j].position.z);
        assert(d >= 0.819, `kids ${i} and ${j} keep personal space on frame ${n} (${d.toFixed(3)}m)`);
      }
    }
  }
}

// Pair correction must retain the existing hard-world and lake constraints.
for (const scenario of ['hard collider', 'lake shore']) {
  const kids = [kid(1.4, 0), kid(1.4, 0)];
  for (const k of kids) k.userData.speed = 0;
  const g = { kids, colliders: kids.map(() => ({ position: new Vector() })) };
  if (scenario === 'hard collider') testConstraints.hardCollider = { x: 0, z: 0, radius: 1 };
  else testConstraints.lakeRadius = 5;
  if (scenario === 'lake shore') for (const k of kids) k.position.x = 5.3;
  step(g, []);
  for (const k of kids) {
    if (scenario === 'hard collider') {
      assert(Math.hypot(k.position.x, k.position.z) >= 1.399,
        'kid pair separation does not push a child into a hard collider');
    } else {
      assert(Math.hypot(k.position.x, k.position.z) >= 5,
        'kid pair separation does not leave a child inside a lake');
    }
  }
  assert(Math.hypot(kids[0].position.x - kids[1].position.x, kids[0].position.z - kids[1].position.z) >= 0.819,
    `world constraint correction preserves kid spacing beside the ${scenario}`);
  testConstraints.hardCollider = null;
  testConstraints.lakeRadius = 0;
}

// A tracked bubble remains the target when two candidates trade nearest place by centimeters.
{
  const k = kid(0, 0), g = setup(k);
  const left = new Vector(-4, 1, 0), right = new Vector(4, 1, 0);
  step(g, [left, right]);
  const first = k.userData.chaseTarget;
  assert.equal(first, left, 'first equidistant bubble becomes the tracked target');
  for (let n = 0; n < 20; n++) {
    left.x = -4 - (n % 2 ? 0.1 : 0);
    right.x = 4 + (n % 2 ? 0 : 0.1);
    step(g, [left, right]);
  }
  assert.equal(k.userData.chaseTarget, first, 'small nearest-distance changes do not flip targets');
  assert(k.position.x < -1, 'kid keeps moving toward its committed target');
  right.x = k.position.x + 0.9;
  step(g, [left, right]);
  assert.equal(k.userData.chaseTarget, right, 'kid switches when another bubble is substantially closer');
}

// Even a long frame cannot carry the kid through a bubble and reverse its heading.
{
  const k = kid(-0.9, 0), g = setup(k), bubble = new Vector(0, 1, 0);
  step(g, [bubble], 0.25);
  assert(Math.abs(k.position.x + 0.7) < 1e-8, 'chase step clamps at the grab radius');
  assert(k.userData.heading > 1.5 && k.userData.heading < 1.7, 'heading still faces the bubble');
}

// Reaching the edge of a gaggle should always turn toward the center, including +Z.
{
  const k = kid(0, 12.1), g = setup(k);
  k.userData.center.set(0, 0, 0);
  k.userData.heading = Math.PI;
  step(g, []);
  assert(Math.cos(k.userData.heading) > 0.9, 'outer +Z kid aims back toward -Z');
}

// Keep the established faster-than-adult pace, independent of frame size.
for (const dt of [1 / 30, 1 / 60, 1 / 120]) {
  const k = kid(0, 0), g = setup(k);
  k.userData.heading = Math.PI / 2;
  k.userData.center.x = 100;
  for (let n = 0; n < Math.round(0.5 / dt); n++) step(g, [], dt);
  assert(Math.abs(k.position.x - 2) < 1e-8, `wander speed stays 4 m/s at dt=${dt}`);

  const runner = kid(-4, 0), chase = setup(runner), bubble = new Vector(0, 1, 0);
  for (let n = 0; n < Math.round(0.5 / dt); n++) step(chase, [bubble], dt, parkedCart);
  assert(Math.abs(runner.position.x + 1.9) < 1e-8,
    `bubble sprint stays 4.2 m/s beside a stationary cart at dt=${dt}`);
  assert.equal(runner.userData.scatterTimer, 0, 'stationary cart does not trigger lane dodge');
}

// Once the bubble is gone, the child resumes ordinary movement.
{
  const k = kid(-1, 0), g = setup(k), bubble = new Vector(0, 1, 0);
  step(g, [bubble]);
  assert.equal(k.userData.chaseTarget, bubble);
  step(g, []);
  assert.equal(k.userData.chaseTarget, null);
  assert.equal(poses.at(-1).excited, false);
}

// The display yaw takes the shortest path across the -PI/+PI seam.
{
  const modelSource = readFileSync(new URL('../src/models/kid.js', import.meta.url), 'utf8');
  const tickStart = modelSource.indexOf('export function tickKid(');
  assert(tickStart >= 0, 'find the production visual animation');
  const tick = vm.runInNewContext(`(${modelSource.slice(tickStart).replace('export function', 'function')})`, {
    Math, performance: { now: () => 0 },
  });
  const model = {
    userData: { displayedYaw: Math.PI - 0.02, bouncePhase: 0 },
    rotation: { y: 0 }, children: [{ position: { y: 0 } }],
  };
  tick(model, 1 / 60, { targetYaw: -Math.PI + 0.02 });
  assert(model.rotation.y > Math.PI - 0.02 && model.rotation.y < Math.PI + 0.02,
    'display yaw crosses the seam by the short arc');
}

process.stdout.write('PASS  kid target commitment, grab radius, personal space, state changes, center steering, angle wrap and speed at 30/60/120 fps\n');
