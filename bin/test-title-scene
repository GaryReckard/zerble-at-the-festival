#!/usr/bin/env node
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import vm from 'node:vm';

const context = vm.createContext({});
const source = readFileSync(new URL('../src/titleScene.js', import.meta.url), 'utf8').replaceAll('export function ', 'function ');
vm.runInContext(source + '\nglobalThis.scene = { titleFraming, initTitleScene };', context);
const { titleFraming, initTitleScene } = context.scene;
const screens = [[1280,720],[1440,900],[1440,1080],[2560,1080],[3840,1080],[1024,1366],[844,390]];
for (const [width,height] of screens) {
  const { scale,centerX,centerY } = titleFraming(width,height);
  const left=centerX-width/(2*scale),right=centerX+width/(2*scale),top=centerY-height/(2*scale),bottom=centerY+height/(2*scale);
  const name=`${width}×${height}`;
  assert(left>=-300-.001&&right<=1580+.001&&top>=-160-.001&&bottom<=880+.001, `${name}: viewport stays inside the extended painting with motion overscan`);
  assert(left<=640&&right>=1080&&top<=240&&bottom>=680, `${name}: the original gate and vehicle remain in frame`);
}
assert.equal(titleFraming(1280,720).scale,1,'Standard landscape retains the original artwork scale');

const children=[],properties={},events=new Map(),viewportEvents=new Map();
const title={style:{setProperty(key,value){properties[key]=value;}}};
const bubbles={appendChild(el){children.push(el);},replaceChildren(){children.length=0;}};
const doc={getElementById:id=>id==='title-card'?title:bubbles,createElement:()=>({style:{setProperty(key,value){this[key]=value;}}})};
const win={innerWidth:1280,innerHeight:720,addEventListener:(key,fn)=>events.set(key,fn),removeEventListener:key=>events.delete(key),
  visualViewport:{addEventListener:(key,fn)=>viewportEvents.set(key,fn),removeEventListener:key=>viewportEvents.delete(key)}};
const dispose=initTitleScene(doc,win);
assert.equal(children.length,24,'The original two-pass plume has 24 sprites');
assert.equal(children.map(b=>b.width).join(','),'30,16,26,34,22,28,32,18,24,20,30,14,30,16,26,34,22,28,32,18,24,20,30,14','Original varied sprite sizes are restored');
for (let i=0;i<12;i++) {
  const a=children[i],b=children[i+12],duration=parseFloat(a.style['--bubble-duration']);
  assert.equal(parseFloat(a.style['--bubble-delay'])-parseFloat(b.style['--bubble-delay']),duration/2,'The second pass fills the first pass’s gaps');
  assert.equal(a.width,a.height);
  assert.notEqual(a.style.marginLeft,b.style.marginLeft,'Each pass has independent deterministic lateral jitter');
}
const before=properties['--title-fit'];win.innerWidth=1440;win.innerHeight=1080;events.get('resize')();
assert.notEqual(properties['--title-fit'],before,'The live resize handler reframes after rotation');
dispose();assert.equal(children.length,0);assert.equal(events.size,0);assert.equal(viewportEvents.size,0);
console.log('PASS title: landscape/tablet/ultrawide coverage with motion overscan and intact hero framing, original 24-sprite sizes and stagger, resize and cleanup');
