#!/usr/bin/env node
import assert from 'node:assert/strict';
import {createRapierAdapter} from '../src/physics/rapierAdapter.js';

const pose=(x=0,y=0,z=0,angle=0)=>({position:{x,y,z},rotation:{x:0,y:0,z:Math.sin(angle/2),w:Math.cos(angle/2)}});
const world=await createRapierAdapter({gravity:{x:0,y:0,z:0},capacities:{bodies:8,colliders:512}});
const add=(id,colliders)=>{
 const r=world.addBody({id,type:'dynamic',pose:pose(),colliders});assert.equal(r.ok,true);return r;
};
const moving=(body,from,to=from)=>({...body,from,to});
try {
 const ball=add('person',[{shape:'ball',radius:.2}]);
 const rod=add('chair',[{shape:'cuboid',halfExtents:{x:2,y:.05,z:.05}}]);
 world.setBodyEnabled('person',false);
 const before=world.readBody('person'),counts=world.counts();
 // The entire projectile crosses the person between two non-overlapping poses.
 const fast=world.sweepBodies(moving(rod,pose(-4),pose(4)),moving(ball,pose()));
 assert.equal(fast.ok,true);assert(fast.hit);assert(Math.abs(fast.hit.fraction-.225)<.002);
 assert(fast.hit.normal.x>.99);assert(Math.abs(fast.hit.pointB.x+.2)<.003);
 assert.equal(world.sweepBodies(moving(rod,pose(-4,1),pose(4,1)),moving(ball,pose())).hit,null);
 const quiet=world.sweepBodies(moving(rod,pose(),pose(.001)),moving(ball,pose()),{minClosingTravel:.02});
 assert.equal(quiet.hit,null);assert.equal(quiet.testedPairs,0,'sub-threshold surface motion skips WASM distance queries');
 // Rotation alone crosses the target, although both endpoint poses miss.
 const rotation=world.sweepBodies(moving(rod,pose(0,0,0,-Math.PI/4),pose(0,0,0,Math.PI/4)),moving(ball,pose(1.6)));
 assert.equal(rotation.ok,true);assert(rotation.hit);assert(rotation.hit.fraction>0&&rotation.hit.fraction<.5);
 assert.equal(world.sweepBodies(moving(rod,pose(0,0,0,-Math.PI/4),pose(0,0,0,Math.PI/4)),moving(ball,pose(2.3))).hit,null);
 // Relative motion matters; common world translation cannot manufacture contact.
 assert.equal(world.sweepBodies(moving(rod,pose(),pose(20)),moving(ball,pose(4),pose(24))).hit,null);
 assert(world.sweepBodies(moving(rod,pose()),moving(ball,pose(4),pose(-4))).hit);
 const compound=add('offset',[{shape:'ball',radius:.1,position:{x:2,y:0,z:0}},{shape:'ball',radius:.1,position:{x:-2,y:0,z:0}}]);
 const offset=world.sweepBodies(moving(compound,pose(0,0,0,-Math.PI/4),pose(0,0,0,Math.PI/4)),moving(ball,pose(2)));
 assert.equal(offset.ok,true);assert(offset.hit);assert.equal(offset.hit.colliderA,0);
 const sensor=add('sensor',[{shape:'ball',radius:5,sensor:true}]);
 assert.equal(world.sweepBodies(moving(sensor,pose()),moving(ball,pose())).hit,null);
 // q and -q describe the same orientation, not a full revolution.
 const opposite=pose();for(const key of ['x','y','z','w'])opposite.rotation[key]*=-1;
 assert.equal(world.sweepBodies(moving(rod,pose(),opposite),moving(ball,pose(0,1))).hit,null);
 const exhausted=world.sweepBodies(moving(rod,pose(-4),pose(4)),moving(ball,pose()),{maxTests:1});
 assert.equal(exhausted.ok,false);assert.equal(exhausted.reason,'query-capacity');assert.equal(exhausted.hit,null);
 assert.equal(world.sweepBodies(moving(rod,pose()),moving(ball,pose()),{maxTests:0}).reason,'query-capacity');
 assert.throws(()=>world.sweepBodies(moving(rod,pose()),moving(ball,pose()),{maxTests:513}));
 assert.throws(()=>world.sweepBodies(moving(rod,pose(NaN)),moving(ball,pose())));
 assert.deepEqual(world.readBody('person'),before,'queries never enable, move, or wake the reserved person');
 assert.equal(world.counts().steps,counts.steps,'query never advances the engine');
 // Effective mass predicts the measured contact-point response, including
 // rotation. Reserved bodies can be evaluated at their future activation pose.
 for(const at of [pose(3,2,1,.7),pose(-2,1,3,-1.1)]) {
  const point={x:at.position.x+.4,y:at.position.y+.6,z:at.position.z+.3},normal={x:1,y:0,z:0};
  const predicted=world.readPointResponse(rod.id,rod.generation,point,normal,at);
  world.setPose(rod.id,at);world.setVelocity(rod.id,{linear:{x:0,y:0,z:0},angular:{x:0,y:0,z:0}});
  world.applyImpulse(rod.id,normal,point);
  const measured=world.readPointResponse(rod.id,rod.generation,point,normal);
  assert(Math.abs(measured.velocity.x-predicted.inverseMass)<1e-5*Math.max(1,predicted.inverseMass),'transformed inertia matches actual off-center impulse '+JSON.stringify({at,predicted,measured}));
 }
 world.removeBody('person');add('person',[{shape:'ball',radius:.2}]);
 assert.equal(world.sweepBodies(moving(rod,pose()),moving(ball,pose())).reason,'stale-body');
 console.log('PASS real-engine body sweeps: fast crossing, rotation-only hit, nearby misses, moving targets, local offsets, sensors, disabled reserves, stale generations and bounded failure.');
}finally{world.dispose();}
