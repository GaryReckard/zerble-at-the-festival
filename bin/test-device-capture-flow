#!/usr/bin/env node

import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import vm from 'node:vm';
import { PLAYTEST_SCENARIOS } from '../src/perfTelemetry.js';

const source = readFileSync(new URL('../src/debug.js', import.meta.url), 'utf8');
const lifecycle = source.slice(source.indexOf('function captureElapsedSeconds()'), source.indexOf('function deviceRendererInfo()'));
const upload = source.slice(source.indexOf('async function uploadDeviceCapture('), source.indexOf('function renderPerfStatus()'));
assert(lifecycle.startsWith('function captureElapsedSeconds()') && upload.startsWith('async function uploadDeviceCapture('));

function setup(scenario) {
  let now = 0;
  const samples = [];
  const driveLocks = [];
  const uploads = [];
  const deferred = [];
  const state = {
    deviceCaptureStarted: true, deviceCaptureStartedAt: 0, deviceCaptureFinished: false,
    deviceCapturePausedMs: 0, deviceCaptureHiddenAt: 0,
    deviceCapturePhaseIndex: -1, deviceCapturePhaseStartedS: 0,
    deviceCapturePhaseEvents: [], deviceCaptureErrors: [], deviceCaptureVisibility: [],
    deviceCaptureQualityLocked: false, deviceCaptureQualityWasEnabled: true,
    deviceCaptureResult: '', deviceCaptureUploadQueue: Promise.resolve(),
    deviceCaptureFinalReport: null, perfPhase: '',
    hooks: {
      Trip: { state: 'idle', triggerDynamic() { this.state = 'fading_in'; }, scrub(value) { this.state = value == null ? 'idle' : 'scrub'; } },
      setCaptureDriveLocked(locked) { driveLocks.push(locked); },
    },
  };
  const document = { hidden: false };
  const context = vm.createContext({
    state, document, DEVICE_SCENARIO: scenario, PLAYTEST_SCENARIOS,
    PEAK_CENTER: 0.5, Date: { now: () => now },
    window: { clearInterval() {}, setTimeout() {} },
    samplePerf: () => samples.push(state.perfPhase),
    updateDeviceCaptureControl() {}, setPerfRecording() {},
    aqSetEnabled() {}, buildDeviceCaptureReport: (reason) => ({ reason, count: samples.length }),
    deviceCaptureUrl: () => '/__capture/test',
    fetch: (_url, request) => {
      uploads.push(JSON.parse(request.body));
      return new Promise((resolve, reject) => deferred.push({ resolve, reject }));
    },
    navigator: {}, console: { error() {} }, Blob,
  });
  vm.runInContext(lifecycle + '\n' + upload, context);
  return {
    state, document, samples, uploads, deferred, driveLocks,
    setNow(value) { now = value; },
    call(name, ...args) { return vm.runInContext(name, context)(...args); },
  };
}

const flow = setup('trip');
flow.call('advanceDeviceScenario');
assert.equal(flow.state.perfPhase, 'settle');
flow.setNow(20_000);
flow.call('advanceDeviceScenario');
assert.deepEqual(flow.samples, ['settle']);
assert.equal(flow.state.perfPhase, 'baseline');
flow.setNow(45_000);
flow.call('advanceDeviceScenario');
assert.equal(flow.state.perfPhase, 'fade-in');
flow.setNow(57_000);
flow.call('advanceDeviceScenario');
assert.equal(flow.state.perfPhase, 'fade-in', 'slow simulation keeps the capture in fade-in');
flow.state.hooks.Trip.state = 'sustaining';
flow.call('advanceDeviceScenario');
assert.equal(flow.state.perfPhase, 'active');
assert.equal(flow.samples.at(-1), 'fade-in', 'outgoing frames flush under their original phase');
flow.setNow(77_000);
flow.call('advanceDeviceScenario');
assert.equal(flow.samples.at(-1), 'active');
assert.equal(flow.state.perfPhase, 'peak');
flow.setNow(97_000);
flow.call('advanceDeviceScenario');
assert.equal(flow.state.perfPhase, 'after');
flow.setNow(117_000);
flow.call('advanceDeviceScenario');
assert.equal(flow.state.deviceCaptureFinished, true);
assert.equal(flow.samples.length, 6, 'each outgoing phase flushes exactly once');
assert.equal(flow.samples.at(-1), 'after');
assert.equal(flow.driveLocks.at(-1), false, 'Trip unlocks controls on completion');
await Promise.resolve();
flow.deferred[0].resolve({ ok: true });
await flow.state.deviceCaptureUploadQueue;

const driving = setup('drive');
driving.call('advanceDeviceScenario');
assert.deepEqual(driving.driveLocks, [true], 'settling parks the cart');
driving.setNow(20_000);
driving.call('advanceDeviceScenario');
assert.equal(driving.driveLocks.at(-1), true, 'baseline keeps controls paused');
driving.setNow(45_000);
driving.call('advanceDeviceScenario');
assert.equal(driving.driveLocks.at(-1), false, 'drive phase returns control');
driving.setNow(135_000);
driving.call('advanceDeviceScenario');
assert.equal(driving.driveLocks.at(-1), true, 'recovery phase parks immediately');
driving.setNow(155_000);
driving.call('advanceDeviceScenario');
assert.equal(driving.driveLocks.at(-1), false, 'completion releases control');

const parked = setup('parked');
parked.call('advanceDeviceScenario');
parked.setNow(20_000);
parked.call('advanceDeviceScenario');
assert.equal(parked.state.perfPhase, 'parked');
assert.deepEqual(parked.driveLocks, [true, true], 'short comparison never allows driving');
parked.setNow(60_000);
parked.call('advanceDeviceScenario');
assert.equal(parked.state.deviceCaptureFinished, true);
assert.equal(parked.driveLocks.at(-1), false, 'short comparison releases controls');

const free = setup(null);
free.document.hidden = true;
free.setNow(5000);
free.call('captureVisibilityChange');
free.document.hidden = false;
free.setNow(9000);
free.call('captureVisibilityChange');
assert.equal(free.state.deviceCaptureFinished, false, 'free recording survives tab resume');
assert.equal(free.state.deviceCapturePausedMs, 4000);

const race = setup('drive');
const periodic = race.call('uploadDeviceCapture', 'periodic', false);
await Promise.resolve();
const manual = race.call('uploadDeviceCapture', 'manual', false);
race.state.deviceCaptureFinished = true;
race.state.deviceCaptureResult = 'pending';
race.state.deviceCaptureFinalReport = { reason: 'complete', count: 42 };
const complete = race.call('uploadDeviceCapture', 'complete', false);
assert.equal(race.uploads.length, 1, 'only the first request starts while pending');
race.deferred[0].resolve({ ok: true });
await periodic;
await Promise.resolve();
assert.equal(race.uploads.length, 2, 'manual request starts after periodic completes');
assert.equal(race.state.deviceCaptureResult, 'pending', 'periodic acknowledgement cannot save final report');
race.deferred[1].resolve({ ok: true });
await manual;
await Promise.resolve();
assert.equal(race.uploads.length, 3);
assert.equal(race.state.deviceCaptureResult, 'pending', 'manual acknowledgement cannot save final report');
race.deferred[2].resolve({ ok: true });
await complete;
assert.equal(race.state.deviceCaptureResult, 'sent');
assert.deepEqual(race.uploads.at(-1), { reason: 'complete', count: 42 });
const retry = race.call('uploadDeviceCapture', 'manual', false);
await Promise.resolve();
assert.deepEqual(race.uploads.at(-1), { reason: 'complete', count: 42 }, 'retry resends frozen metadata');
race.deferred[3].resolve({ ok: true });
await retry;

const failure = setup('drive');
failure.state.deviceCaptureFinished = true;
failure.state.deviceCaptureFinalReport = { reason: 'complete', count: 7 };
const firstFinal = failure.call('uploadDeviceCapture', 'complete', false);
await Promise.resolve();
failure.deferred[0].reject(new Error('offline'));
assert.equal(await firstFinal, false);
assert.equal(failure.state.deviceCaptureResult, 'failed');
const finalRetry = failure.call('uploadDeviceCapture', 'manual', false);
await Promise.resolve();
assert.deepEqual(failure.uploads[1], failure.uploads[0]);
failure.deferred[1].resolve({ ok: true });
assert.equal(await finalRetry, true);
assert.equal(failure.state.deviceCaptureResult, 'sent');

// Exercise the actual serializer, not a fixture carrying the expected labels.
const reportSource = source.slice(source.indexOf('function buildDeviceCaptureReport('), source.indexOf('function deviceCaptureUrl('));
for (const policy of ['auto', 'baseline']) {
  const context = vm.createContext({
    state: { hooks: {}, perfSamples: [], frameTelemetry: { events: [] }, deviceCaptureStartedAt: 1,
      deviceCapturePhaseEvents: [], deviceCaptureMarks: [], deviceCaptureVisibility: [], deviceCaptureErrors: [],
      deviceCaptureQualityLocked: policy === 'baseline' },
    DEVICE_CAPTURE_PARAMS: new URLSearchParams(`?perfCapture=1&perfScenario=parked&perfQuality=${policy}&captureToken=secret`),
    DEVICE_SCENARIO: 'parked', CAPTURE_QUALITY_POLICY: policy,
    chunkGenStats: { stages: {}, count: 0 }, captureElapsedSeconds: () => 60,
    PERF: { name: 'low', crowdMax: 180, shadows: false, chunkLoadRadius: 1, chunkUnloadRadius: 2, bubblePoolMax: 200 },
    DETECTED_TIER: 'low', getSessionSeed: () => 3948869160,
    getLevelName: () => 'baseline', getLevel: () => 0, getBasePixelRatio: () => 1.25,
    aqIsEnabled: () => policy === 'auto', navigator: {},
    window: { screen: {} }, deviceRendererInfo: () => null, loadMarkers: () => [],
  });
  vm.runInContext(reportSource, context);
  const report = vm.runInContext('buildDeviceCaptureReport("complete")', context);
  assert.equal(report.session.qualityPolicy, policy);
  assert.equal(report.session.qualityLockedFromFirstFrame, policy === 'baseline');
  assert.equal(report.session.governorEnabled, policy === 'auto');
  assert.equal(report.session.basePixelRatio, 1.25);
  assert.equal(report.session.tierPolicy.bubbles, 'cheap');
  assert.equal(report.session.params.captureToken, undefined, 'policy metadata must not leak upload tokens');
}

process.stdout.write('PASS  capture phase ownership, parked controls, slow Trip, free resume, upload serialization, and frozen retry\n');
