#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import vm from 'node:vm';
import * as THREE from 'three';
import {batchPropGroups} from '../src/propRendering.js';
import {createActivePropRendering} from '../src/physics/activePropRendering.js';

// Run the actual production builder with native Three geometry/transforms.
const source = readFileSync(new URL('../src/models/campsite.js', import.meta.url), 'utf8');
const cache = new Map();
const matFor = color => {
  if (!cache.has(color)) {
    const material = new THREE.MeshStandardMaterial({color});
    material.userData.shared = true;
    cache.set(color, material);
  }
  return cache.get(color);
};
const fragment = source.slice(source.indexOf('const _CAMP_BOX ='), source.indexOf('const _CAMP_BULB ='));
const {buildCampCooler:build,addCampKitchen} = vm.runInNewContext(fragment.replace('export function ', 'function ') + ';({buildCampCooler,addCampKitchen})', {THREE, matFor});
const geometries = new Set(), colors = new Set();
let triangles = 0;
for (let variant = 0; variant < 40; variant++) {
  const cooler = build(variant);
  assert.equal(cooler.group.children.length, 4, 'four independently transformable draw batches per cooler');
  colors.add(cooler.color);
  triangles = 0;
  cooler.group.updateMatrixWorld(true);
  const bounds = new THREE.Box3().setFromObject(cooler.group);
  assert(Math.abs(bounds.min.y) < 1e-6, 'base rests on the ground');
  assert(bounds.max.y > .44 && bounds.max.y < .46, 'lower cooler proportions retain an insulated lid');
  for (const mesh of cooler.group.children) {
    assert.equal(mesh.geometry.userData.shared, true);
    assert.equal(mesh.material.userData.shared, true);
    assert.equal(mesh.castShadow, false);
    if(mesh.isInstancedMesh) assert(mesh.instanceMatrix.version > 0, 'instance transforms uploaded');
    const transform = mesh.matrix.clone();
    for (let i = 0; i < (mesh.count ?? 1); i++) {
      if(mesh.isInstancedMesh) mesh.getMatrixAt(i, transform);
      const positions = mesh.geometry.attributes.position;
      for(let vertex=0;vertex<positions.count;vertex++) {
        const point = new THREE.Vector3().fromBufferAttribute(positions,vertex).applyMatrix4(transform);
        assert(Math.hypot(point.x,point.z) <= cooler.footprint, 'every vertex fits the collision reservation');
      }
    }
    geometries.add(mesh.geometry);
    triangles += (mesh.geometry.index?.count ?? mesh.geometry.attributes.position.count) / 3 * (mesh.count ?? 1);
  }
  assert.equal(build(variant).color, cooler.color, 'finish is deterministic');
}
assert.equal(geometries.size, 4, 'all variants reuse the four part geometries');
assert.equal(colors.size, 4);
assert.equal(cache.size, 6, 'four body finishes and two hardware materials');
assert(triangles <= 1850, 'molded detail stays within the per-cooler geometry budget');
// A downward ray must reach a well floor below the surrounding lid surface.
const cooler = build();
cooler.group.updateMatrixWorld(true);
const ray = new THREE.Raycaster(new THREE.Vector3(0,1,0),new THREE.Vector3(0,-1,0));
const top = ray.intersectObject(cooler.group,true)[0].point.y;
for(const x of [-.15,.15]) {
  ray.ray.origin.set(x,1,0);
  const floor = ray.intersectObject(cooler.group,true)[0].point.y;
  assert(Math.abs(top-.445)<1e-6);
  assert(Math.abs(floor-.415)<1e-6, 'two real 3cm-deep cup wells, without a surface covering them');
  const rimHeights=[];
  for(let i=0;i<16;i++) {
    const angle=i*Math.PI*2/16+.1;
    ray.ray.origin.set(x+.06*Math.cos(angle),1,.06*Math.sin(angle));
    rimHeights.push(ray.intersectObject(cooler.group,true)[0].point.y);
  }
  assert(Math.max(...rimHeights)-Math.min(...rimHeights)<1e-6, 'beveled cup rim has no closing-seam spike');
}
for(const x of [-.15,.15]){
 const underneath=new THREE.Raycaster(new THREE.Vector3(x,.38,0),new THREE.Vector3(0,1,0));
 assert(Math.abs(underneath.intersectObject(cooler.group.getObjectByName('cooler_lid'))[0].point.y-.409)<1e-6,'cup wells are sealed from below');
}
const shell = cooler.group.getObjectByName('cooler_body');
const sideRay = new THREE.Raycaster(new THREE.Vector3(1,.07,0),new THREE.Vector3(-1,0,0));
const lowerWidth = sideRay.intersectObject(shell)[0].point.x;
sideRay.ray.origin.y = .32;
assert(sideRay.intersectObject(shell)[0].point.x > lowerWidth+.02, 'molded shell tapers toward the base');
console.log(`PASS camp coolers: 40 native Three builds, grounded collision bounds, two raycast-verified cup recesses, deterministic finishes, shared resources, 4 draws / ${triangles} triangles, no shadow casters.`);

const kitchen = new THREE.Group();
addCampKitchen(kitchen,2);
const installed = kitchen.getObjectByName('camp_cooler');
assert(installed, 'actual kitchen builder installs the production cooler');
assert.deepEqual(installed.position.toArray(),[1.9,0,-.7]);
assert.equal(installed.children[0].material.color.getHex(),build(2).color);
console.log('PASS actual kitchen integration: cooler present at the reserved location with the requested finish.');

// Body details remain fixed, while wells stay on the actual rotating lid.
const bodyParts=cooler.group.children.filter(m=>m!==cooler.lid.mesh);
const closed=bodyParts.map(m=>m.matrixWorld.clone());
const out={position:{},axis:{}};
for(const socket of cooler.cupWells){
 assert.equal(socket.capacity,1);assert.equal(socket.depth,.03);assert.equal(socket.radius,.063);
 assert(cooler.sampleCupWell(socket.id,out));
 assert(Math.abs(out.position.y-.415)<1e-8);assert.equal(out.axis.y,1);
}
cooler.lid.setAngle(Math.PI/2);cooler.group.updateMatrixWorld(true);
bodyParts.forEach((m,i)=>assert(m.matrixWorld.equals(closed[i]),'opening does not rotate handles, badge, drain or shell'));
for(const socket of cooler.cupWells){
 assert(cooler.sampleCupWell(socket.id,out));assert(Math.abs(out.axis.y)<1e-6);assert(out.axis.z<-.999);
 assert(Math.abs(out.position.y-(.372+.223))<1e-6,'well follows the lid hinge');
}
ray.ray.origin.set(0,1,0);const interior=ray.intersectObject(cooler.group,true)[0].point.y;
assert(interior<.1&&interior>.03,'opening reveals the interior floor rather than a solid shell cap');
assert.equal(cooler.lid.setAngle(-5),0);assert.equal(cooler.lid.setAngle(5),1.85);
assert.throws(()=>cooler.lid.setAngle(NaN));
cooler.lid.setAngle(.7);cooler.group.position.set(3,2,-4);cooler.group.rotation.y=.4;cooler.group.scale.setScalar(2);
for(const socket of cooler.cupWells){
 cooler.sampleCupWell(socket.id,out);
 const origin=new THREE.Vector3(out.position.x,out.position.y,out.position.z).addScaledVector(new THREE.Vector3(out.axis.x,out.axis.y,out.axis.z),.1);
 const probe=new THREE.Raycaster(origin,new THREE.Vector3(-out.axis.x,-out.axis.y,-out.axis.z));
 const hit=probe.intersectObject(cooler.lid.mesh)[0];assert(hit);assert(hit.point.distanceTo(new THREE.Vector3(out.position.x,out.position.y,out.position.z))<1e-5,'transformed socket matches raycast cup floor');
}
console.log('PASS cooler articulation: fixed body trim, bounded hinge, open cavity and raycast-verified world cup sockets under rotation and scale.');

cooler.group.clear();assert.equal(cooler.sampleCupWell('left',out),false,'detached source cannot publish a false world socket');assert.throws(()=>cooler.lid.setAngle(.5),/render binding/);

// The production lid remains addressable after batching and source teardown.
const sourceRoot=new THREE.Group(),adopted=build(1),neighbor=build(2);
sourceRoot.add(adopted.group,neighbor.group);neighbor.group.position.x=2;
sourceRoot.position.set(3,2,-4);sourceRoot.rotation.y=.4;sourceRoot.scale.setScalar(2);
sourceRoot.updateWorldMatrix(true,true);
const initialWorld=adopted.group.matrixWorld.clone(),neighborWorld=neighbor.group.matrixWorld.clone();
const batch=batchPropGroups(sourceRoot,[adopted.group,neighbor.group]);
assert.deepEqual(batch.bindings[0].describe().map(p=>p.partId),['body','hardware','trim','lid']);
const pool=createActivePropRendering({maxBuckets:8,maxSlots:16,slotsPerBucket:2});
const parent=new THREE.Group();parent.position.set(-7,1,3);parent.rotation.z=.2;parent.scale.set(1.2,.8,1.5);parent.add(pool.root);
const active=pool.acquire('cooler',batch.bindings[0].describe(),initialWorld).binding;
const other=pool.acquire('neighbor',batch.bindings[1].describe(),neighborWorld).binding;
const nearMatrix=(a,b)=>assert(a.elements.every((v,i)=>Math.abs(v-b.elements[i])<2e-5));
const sampled=new THREE.Matrix4(),actual=new THREE.Matrix4(),desired=new THREE.Matrix4().makeRotationX(-1.2);desired.setPosition(0,.372,-.223);
const counts=pool.stats();pool.flush();
// A renderer clears submitted ranges; model that acknowledgement before the next frame.
for(const mesh of pool.root.children)mesh.instanceMatrix.clearUpdateRanges();
const bodyBefore=active.describe().filter(p=>p.partId!=='lid').map(p=>p.localMatrix);
batch.dispose();assert.equal(adopted.lid.setAngle(1.2,active),1.2);
assert(active.samplePartWorldMatrix('lid',sampled));nearMatrix(sampled,new THREE.Matrix4().multiplyMatrices(initialWorld,desired));
assert.equal(pool.flush().matrixBytes,64,'only one existing lid instance needs publication');
assert.equal(pool.stats().allocatedSlots,counts.allocatedSlots);
assert.equal(pool.stats().buckets,counts.buckets);
active.describe().filter(p=>p.partId!=='lid').forEach((p,i)=>nearMatrix(p.localMatrix,bodyBefore[i]));
const otherLid=other.describe().find(p=>p.partId==='lid');otherLid.mesh.getMatrixAt(otherLid.slot,actual);otherLid.mesh.updateWorldMatrix(true,false);
nearMatrix(new THREE.Matrix4().multiplyMatrices(otherLid.mesh.matrixWorld,actual),new THREE.Matrix4().multiplyMatrices(neighborWorld,otherLid.localMatrix));
for(const socket of adopted.cupWells){
 const socketOut={position:{},axis:{}};assert(adopted.sampleCupWell(socket.id,socketOut,active));
 const position=new THREE.Vector3().copy(socketOut.position),axis=new THREE.Vector3().copy(socketOut.axis);
 assert(position.distanceTo(new THREE.Vector3(socket.position.x,socket.position.y,socket.position.z).applyMatrix4(sampled))<1e-8);
 const lidPart=active.describe().find(p=>p.partId==='lid');lidPart.mesh.updateWorldMatrix(true,false);
 const hit=new THREE.Raycaster(position.clone().addScaledVector(axis,.1),axis.clone().negate()).intersectObject(lidPart.mesh).find(h=>h.instanceId===lidPart.slot);
 assert(hit);assert(hit.point.distanceTo(position)<1e-5,'adopted moving well still matches rendered floor');
}
assert(active.setPartMatrix('lid',desired));assert.equal(pool.flush().matrixBytes,0);
assert.equal(active.setPartMatrix('missing',desired),false);assert.equal(active.samplePartWorldMatrix('missing',sampled),false);
const invalid=desired.clone();invalid.elements[12]=Infinity;assert.throws(()=>active.setPartMatrix('lid',invalid),/finite/i);
active.samplePartWorldMatrix('lid',sampled);nearMatrix(sampled,new THREE.Matrix4().multiplyMatrices(initialWorld,desired));
const descriptions=active.describe();descriptions[1].partId=descriptions[0].partId;
assert.throws(()=>pool.acquire('bad',descriptions,initialWorld),/unique/);assert.equal(pool.stats().allocatedSlots,counts.allocatedSlots);
active.release();assert.equal(adopted.sampleCupWell('left',out,active),false);assert.throws(()=>adopted.lid.setAngle(.4,active),/no longer live/);assert.equal(adopted.lid.angle,1.2);assert.equal(active.setPartMatrix('lid',desired),false);assert.equal(active.samplePartWorldMatrix('lid',sampled),false);
other.release();pool.dispose();assert.equal(pool.stats().allocatedSlots,0);
const badRoot=new THREE.Group(),bad=build();badRoot.add(bad.group);bad.group.children[1].userData.physicalPart='body';
assert.throws(()=>batchPropGroups(badRoot,[bad.group]),/unique/);assert.equal(bad.group.children.length,4);
console.log('PASS adopted cooler articulation: named parts, source disposal, one-slot updates, isolated neighbor, transformed cup-floor raycasts, invalid input atomicity and stale binding rejection.');
