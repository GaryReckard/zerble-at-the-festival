#!/usr/bin/env node
import assert from 'node:assert/strict';
import {createWorldTimings,WORLD_SECTIONS} from '../src/worldTimings.js';
import {FrameTelemetry} from '../src/perfTelemetry.js';
let now=0;const timer=createWorldTimings(()=>now);timer.reset();timer.begin(0);
for(const name of WORLD_SECTIONS){now+=10;timer.mark(name);}
assert.equal(Object.values(timer.parts).reduce((a,b)=>a+b,0),100,'partition has no double counting');
const start=timer.stamp();now+=4;timer.nested('samples',start);assert.equal(timer.ground.samples,4);
assert.equal(timer.clockReads,12);timer.reset();assert(Object.values(timer.parts).every(v=>v===0));assert.equal(timer.ground.samples,0);
const t=new FrameTelemetry({maxEvents:2});
for(let i=0;i<30;i++){
  timer.parts.landscape=i===0?999:60+i;
  t.record({ts:i,wallMs:65,workMs:timer.parts.landscape+1,worldMs:timer.parts.landscape,renderMs:1,worldParts:timer.parts,worldGround:timer.ground,worldClockReads:10});
}
timer.parts.landscape=0;
assert.equal(t.events.length,2);assert.equal(t.droppedEvents,28);
assert.equal(t.worldEvents.length,24);assert.equal(t.worldEvents[0].worldParts.landscape,999,'earliest largest spike survives chronological eviction and mutable reuse');
const window=t.takeWindow();assert.equal(window.worldPartsMax.landscape,999);assert.equal(t.takeWindow(),null);
t.record({ts:31,wallMs:16,workMs:5,worldMs:1,renderMs:1,worldParts:timer.parts});assert.equal(t.takeWindow().worldPartsMax.landscape,0,'window maxima reset');
t.reset();assert.equal(t.worldEvents.length,0);assert.equal(t.events.length,0);
const ordinary=new FrameTelemetry();ordinary.record({ts:0,wallMs:16,workMs:4,worldMs:1,renderMs:1});assert(!('worldPartsMax' in ordinary.takeWindow()),'ordinary telemetry format remains unchanged without detailed parts');
console.log('PASS world attribution: disjoint top-level sections, separately nested ground, reset/read accounting, immutable event snapshots and bounded worst-stall retention');
