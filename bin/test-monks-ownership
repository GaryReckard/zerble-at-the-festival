#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {runInNewContext} from 'node:vm';
import {mulberry32} from '../src/rng.js';
import {makePeopleCrowd} from './test-support/peopleCrowd.js';
import {Vector,Node} from './test-support/sceneObjects.mjs';
import {disposeSceneResources} from '../src/people/sceneResources.js';
import {loadGroupParticipation} from './test-support/groupParticipation.mjs';
Vector.prototype.sub=function(p){this.x-=p.x;this.y-=p.y;this.z-=p.z;return this;};
Vector.prototype.divideScalar=function(n){return this.multiplyScalar(1/n);};
Vector.prototype.toArray=function(){return [this.x,this.y,this.z];};
function model(){const g=new Node();g.rotation.set=function(x,y,z){Object.assign(this,{x,y,z});};g.scale={setScalar(v){this.value=v;}};g.userData.pose=(...args)=>g.lastPose=args;return g;}
const strip=code=>code.replace(/^import\s[\s\S]*?;\s*$/gm,'').replace(/export class /g,'class ');
function fixture(path,{spawnParty=true,buildMonk=model}={}){
 const crowd=makePeopleCrowd({capacity:40});crowd.group=new Node();crowd.free=Array.from({length:40},(_,i)=>39-i);crowd.bubblesEmpty=false;
 const spawn=crowd.spawn;crowd.spawn=function(options){const n=spawn.call(this,options);if(n)Object.assign(n,{scale:1,energy:1,dance:.3});return n;};
 const display=loadGroupParticipation((x,z)=>17+.03*x-.02*z);
 crowd._writeMatrices=n=>{if(n._groupBinding)display.publishGroupBinding(n);else if(n.avatar)n.party.renderNpc(n);};
 const Class=runInNewContext(strip(readFileSync(new URL(path,import.meta.url),'utf8'))+';MonkParty',{THREE:{Group:Node,Vector3:Vector},disposeSceneResources,mulberry32,getSessionSeed:()=>1977,terrainHeight:(x,z)=>17+.03*x-.02*z,buildMonk,registry:{collidersNear(){},attractors:()=>[]},lakeAt:()=>false,sampleWagonRoute(){}});
 const party=new Class(crowd);if(spawnParty)assert(party.spawn(new Vector(),5));return {crowd,party};
}
const legacyPath='../verification/people/2026-10-26/legacy-monks-controller.js';
const old=fixture(legacyPath),baseline=process.argv.includes('--baseline'),now=baseline?fixture(legacyPath):fixture('../src/monks.js');
const vehicle={position:new Vector(0,0,40),speed:2,seatSlots:Array.from({length:6},(_,i)=>({name:'seat'+i,occupied:false}))};
const snapshot=({crowd,party})=>({members:crowd.npcs.map(n=>[n.idx,n.pos.x,n.pos.y,n.pos.z,n.target.x,n.target.z,n.state,n.stateTimer,n.scale,n.energy,n.dance,n.seatSlot?.name,n.rideTimer]),status:JSON.parse(JSON.stringify(party.status()))});
for(let frame=0;frame<400;frame++){
 for(const f of [old,now]){
  if(frame===80)f.crowd.npcs[0].state='using_potty';
  if(frame===120)f.crowd.npcs[0].state='idle';
  f.party.update(.05,vehicle);
  // The same population-side input between intent ticks makes differences in
  // destinations and state proposals visible without mirroring Crowd's AI.
  for(const n of f.crowd.npcs){if(n.state==='walking'){n.pos.x+=(n.target.x-n.pos.x)*.03;n.pos.z+=(n.target.z-n.pos.z)*.03;}n.stateTimer-=.05;}
 }
 assert.deepEqual(snapshot(now),snapshot(old));
 const rigs=f=>Array.from(f.party.members,m=>m.avatar);
 for(const f of [old,now])for(const n of f.crowd.npcs)f.crowd._writeMatrices(n);
 const poses=f=>rigs(f).map(g=>[...g.position.toArray(),g.rotation.y,g.scale.value,...g.lastPose.slice(0,4)]);
 assert.deepEqual(poses(now),poses(old));
 if(!baseline)for(const g of rigs(now)){assert.equal(g.lastPose.length,6);assert(g.lastPose.slice(4).every(Number.isFinite),'group publication adds finite shared stride/arm channels');}
}
for(const f of [old,now]){
 vehicle.position.set(0,0,0);vehicle.speed=0;
 for(const n of f.crowd.npcs){n.pos.set(0,0,0);n.state='idle';}
 vehicle.seatSlots.forEach(s=>s.occupied=false);
 assert(f.party.reserve(vehicle));assert(f.crowd.npcs.every(n=>n.state==='boarding'));
 const members=[...f.party.members];for(const member of members)f.party.arrive(baseline||f===old?member:member.handle,f.party.reservation);
 assert(f.crowd.npcs.every(n=>n.state==='riding'));f.party.leave();assert(vehicle.seatSlots.every(s=>!s.occupied));
}
assert.deepEqual(snapshot(now),snapshot(old));
for(const f of [old,now]){f.party.clear();f.party.clear();assert.equal(f.crowd.npcs.length,0);f.party.dispose();}
console.log('PASS monks: 400 exact group intent/profile/state frames, protected member activity, shared boarding/arrival/leave, collective cleanup and salted RNG.');

if(!baseline){
 const currentPath='../src/monks.js';
 {
  const {crowd,party}=fixture(currentPath);party.clock=10;
  const cart={position:new Vector(),speed:0,seatSlots:Array.from({length:6},(_,i)=>({name:'seat'+i,occupied:false}))};
  crowd.npcs.forEach(n=>n.pos.set(0,0,0));
  const handles=party.members.map(m=>m.handle),slots=cart.seatSlots;
  slots[0].occupied=true;slots[1].occupied=true;
  assert.equal(party.reserve(cart),false);assert(crowd.npcs.every(n=>!n.seatSlot));
  slots.forEach(s=>s.occupied=false);
  slots[2].occupied=true;
  assert.equal(party.people.reserve(handles,cart,slots.slice(0,5)),null,'contention rejects the entire reservation before any write');
  assert.equal(slots.filter(s=>s.occupied).length,1);slots[2].occupied=false;
  assert(party.reserve(cart));const oldReservation=party.reservation;
  party.leave();party.cooldown=0;
  assert(party.reserve(cart));const fresh=party.reservation;
  assert.equal(party.arrive(handles[0],oldReservation),false,'an old arrival cannot mark a new boarding attempt ready');
  assert.equal(party.ready.size,0);
  assert.equal(party.people.leave(oldReservation,party.members,new Vector()),false,'old release cannot free replacement seats');
  assert(slots.slice(0,5).every(s=>s.occupied));
  const removed=handles[0],avatar=party.members[0].avatar;
  crowd.removePerson(removed);
  assert.equal(party.members.length,4);assert.equal(avatar.parent,null);assert.equal(slots[0].occupied,false);
  assert.equal(party.people.proposeWalk(removed,90,0,90),false);
  assert.equal(party.people.hasSeat(removed,fresh),false);
  party.leave();party.clear();assert(slots.every(s=>!s.occupied));
  assert(party.spawn(new Vector(),5),'cleared reservation does not block a later group');
  assert.equal(party.people.proposeWalk(removed,90,0,90),false,'reused population slots do not revive the former group identity');
  const member=party.members[0],npc=crowd.peopleHandles.resolve(member.handle);
  const claim=crowd.claimActivity(member.handle,{owner:'exclusive'});assert(claim);
  const target=npc.target.clone();assert.equal(party.people.proposeWalk(member.handle,90,0,90),false);assert.deepEqual(npc.target,target);
  crowd.setActivityBinding(claim,true);assert.equal(member.avatar.visible,false);
  crowd.endPersonActivity(claim);assert.equal(member.avatar.visible,true);
  const stale=member.handle;
  crowd.peopleHandles.runtime.unregister(stale.ownerToken);
  party.dispose();assert.equal(crowd.npcs.length,0,'group cleanup works after population dispatch stops');
  assert.equal(party.people.read(stale,{}),false);assert.equal(party.spawn(new Vector(),5),false);
  party.dispose();party.update(.05,cart);assert.equal(party.members.length,0);
 }
 {
  const {crowd,party}=fixture(currentPath);crowd.npcs.forEach(n=>n.pos.set(1000,0,1000));
  crowd._despawnDistant({position:new Vector()});assert.equal(crowd.npcs.length,5,'population sweep preserves group membership exemptions');
  party.update(.05,{position:new Vector(),speed:2,seatSlots:[]});assert.equal(crowd.npcs.length,0,'group requests collective distant removal through the population owner');
  party.dispose();
 }
 for(const failure of ['pool','model']){
  let builds=0;
  const {crowd,party}=fixture(currentPath,{spawnParty:false,buildMonk:()=>{if(failure==='model'&&++builds===3)throw Error('model failure');return model();}});
  if(failure==='pool'){const spawn=crowd.spawn;let calls=0;crowd.spawn=function(options){return ++calls===3?null:spawn.call(this,options);};assert.equal(party.spawn(new Vector(),5),false);}
  else assert.throws(()=>party.spawn(new Vector(),5),/model failure/);
  assert.equal(crowd.npcs.length,0);assert.equal(party.root.children.length,0);assert.equal(party.members.length,0);assert.equal(crowd.free.length,40);
  party.dispose();
 }
 console.log('PASS monk boundary: public pose binding, all-or-none contention, stale reservation isolation, person-first/owner-first cleanup, activity precedence, full spawn rollback and replacement-safe commands.');
}
