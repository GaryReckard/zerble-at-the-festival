 assert.equal(f.session.phase,'idle',mode);assert.equal(f.people.activityClaims.current.size,0,mode);assert.equal(f.releases,1,mode);assert(!f.shown,mode);f.session.dispose();
}
{
 const f=sessionFixture();f.people.claimActivity=()=>null;assert(!f.session.start(f.person));assert.equal(f.session.phase,'idle');assert.equal(f.releases,1);assert.equal(f.reservation,null);
}
console.log('PASS flow cancellation on person/place loss, timeout, initial/reacquisition failure and stale authority.');
{
