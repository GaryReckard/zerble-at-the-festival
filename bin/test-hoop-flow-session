// Optional planted-leg channels share the same scratch across activity families.
// This verifies ownership, complete publication and lifecycle, not leg geometry.
{
 const solo=sessionFixture(),classic=sessionFixture({style:'classic'}),paired=activityFixture(),scratch={};solo.start();classic.start();
 const a=paired.spawn(-2,0),b=paired.spawn(2,0),pair=paired.activity.startPair({persons:[a,b],entry:paired.entry});assert(pair);
 try {
  solo.session.update(.05);const sample=solo.session.sampleBodyPose(solo.person,scratch);
  assert(sample.feet,'flow exposes the planted-leg target contract');assert.equal(sample.style,'flow');assert(Number.isFinite(sample.rootY));
  const feet=sample.feet,left=feet.left,right=feet.right,snapshot=structuredClone(feet);
  assert.notEqual(feet,solo.session.flowSample.feet);assert.notEqual(left,solo.session.flowSample.feet.left);assert.notEqual(right,solo.session.flowSample.feet.right);
  assert(solo.session.seekFlow(2));assert.deepEqual(feet,snapshot,'a later cached sample cannot mutate a previous caller copy');
  solo.session.sampleBodyPose(solo.person,scratch);assert.equal(scratch.feet,feet,'caller foot buffer is reused');assert.equal(scratch.feet.left,left);assert.equal(scratch.feet.right,right);assert.deepEqual(scratch.feet,solo.session.flowSample.feet);
  classic.session.sampleBodyPose(classic.person,scratch);assert.equal(scratch.style,'classic');assert.equal(scratch.articulated,true);assert(scratch.feet);assert.deepEqual(scratch.feet,classic.session.classicSample.feet);near(scratch.rootY,classic.session.classicSample.rootY,'classic restores its own compression');assert.equal(scratch.travelX,0);assert.equal(scratch.travelZ,0);assert.equal(scratch.turn,0);
  solo.session.sampleBodyPose(classic.person,scratch);assert.equal(scratch.style,'inactive');assert.equal(scratch.feet,null);assert.equal(scratch.rootY,0);
  scratch.feet=feet;scratch.rootY=9;assert(pair.sampleBodyPose(a,scratch));assert.equal(scratch.style,'flow');assert.equal(scratch.feet,null,'stationary pair cannot inherit solo leg targets');assert.equal(scratch.rootY,0);
  solo.session.sampleBodyPose(solo.person,scratch);assert(scratch.feet);assert.equal(scratch.feet,feet);assert.deepEqual(scratch.feet,solo.session.flowSample.feet);near(scratch.rootY,solo.session.flowSample.rootY,'flow restores its current root displacement');
  for(const foot of [scratch.feet.left,scratch.feet.right]){for(const key of ['x','y','z','qx','qy','qz','qw','plantId'])assert(Number.isFinite(foot[key]),'finite foot field '+key);assert.equal(typeof foot.planted,'boolean');near(Math.hypot(foot.qx,foot.qy,foot.qz,foot.qw),1,'foot orientation is normalized',1e-8);}
 }finally{solo.session.dispose();classic.session.dispose();paired.cleanup();}
}
console.log('PASS planted-leg lifecycle: complete cache publication, copied/reused targets and flow/classic/inactive/pair/flow scratch isolation.');
{
 for(const profile of ['lyrical','playful','aerial']) {
  const a=sessionFixture({duration:22,profile}),b=sessionFixture({duration:22,profile});a.start();b.start();
  const target=12.347,pattern=[.01,.025,.015];
  for(let step=0;a.session.scoreTime<target;step++){assert(step<5000,'bounded moving score advance');assert.equal(a.session.phase,'hooping');a.session.update(Math.min(.05,target-a.session.scoreTime));}
  for(let step=0;b.session.scoreTime<target;step++){assert(step<5000,'bounded partitioned score advance');assert.equal(b.session.phase,'hooping');b.session.update(Math.min(pattern[step%pattern.length],target-b.session.scoreTime));}
  sameNumbers(comparable(a.session.flowSample),comparable(b.session.flowSample),'moving-foot partition '+profile);
  const before=comparable(a.session.flowSample),elapsed=a.session.elapsed,viewA={},viewB={};a.people.readPerson(a.person,viewA);b.people.readPerson(b.person,viewB);
  near(viewA.x,viewB.x,'moving partition world x');near(viewA.y,viewB.y,'moving partition world y');near(viewA.z,viewB.z,'moving partition world z');near(viewA.heading,viewB.heading,'moving partition heading');
  assert(a.session.seekFlow(3.142));assert(a.session.seekFlow(target));assert.deepEqual(comparable(a.session.flowSample),before,'absolute seek restores exact foot/root channels after movement');near(a.session.elapsed,elapsed,'seeking does not alter moving participation');
  const epoch=a.session.scoreEpoch;a.people.activityClaims.removePerson(a.person,'honk');a.session.update(.05,{safe:true});
  for(let step=0;step<200&&a.session.phase==='approaching';step++)a.session.update(.05);
  assert.equal(a.session.phase,'hooping');assert.equal(a.session.scoreEpoch,epoch+1);near(a.session.elapsed,elapsed,'fresh entrance keeps previous participation');near(a.session.scoreTime,0,'fresh entrance foot score starts at zero');
  const copied=a.session.sampleBodyPose(a.person,{});assert(copied.feet);assert.deepEqual(copied.feet,a.session.flowSample.feet);near(copied.rootY,a.session.flowSample.rootY,'reentry root uses fresh score sample');assert.equal(copied.version,a.session.flowSample.version);
  a.session.dispose();b.session.dispose();
 }
}
console.log('PASS planted-foot moving profiles: accepted partitions, seek round-trip and fresh reentry cache without lifetime reset.');

function flowBodyMatrix(session,view,out=new Matrix4()) {
 const sample=session.flowSample,scale=view.scale??1;
 const root=new Vector3(view.x,view.y+sample.rootY*scale,view.z),q=new Quaternion().setFromEuler(new Euler(0,view.heading,0));
 return out.compose(root,q,new Vector3(scale,scale,scale)).multiply(new Matrix4().makeRotationFromEuler(new Euler(sample.leanX,0,sample.leanZ)));
}
{
 const f=sessionFixture({duration:22});f.place.groundAt=(x,z)=>.035*x-.025*z;f.start();
 const previous={left:null,right:null},matrix=new Matrix4(),view={};let plantedComparisons=0,movingGround=false;
 for(let step=0;step<180;step++) {
  f.session.update(.05);assert.equal(f.session.phase,'hooping','mild affine terrain remains reachable');f.people.readPerson(f.person,view);flowBodyMatrix(f.session,view,matrix);
  if(Math.abs(view.y)>1e-5)movingGround=true;
  for(const side of ['left','right']) {
   const foot=f.session.flowSample.feet[side],world=new Vector3(foot.x,foot.y,foot.z).applyMatrix4(matrix),last=previous[side];
   if(foot.planted&&last?.planted&&foot.plantId===last.plantId){assert(world.distanceTo(last.world)<3e-6,'planted '+side+' sole does not drift on affine terrain');plantedComparisons++;}
   previous[side]={plantId:foot.plantId,planted:foot.planted,world};
  }
 }
 assert(plantedComparisons>60,'fixture exercises sustained planted phases');assert(movingGround,'performer moves through changing terrain height');f.session.dispose();
}
{
 const flat=sessionFixture({duration:22,profile:'aerial'}),slope=sessionFixture({duration:22,profile:'aerial'});flat.place.groundAt=()=>0;slope.place.groundAt=(x,z)=>.035*x-.025*z;flat.start();slope.start();
 const toss=flat.session.score.segments.find(segment=>segment.kind==='toss');assert(toss,'aerial score includes an inertial flight');
 const ys=[],view={},world=new Vector3();let samples=0;
 for(const fraction of [.25,.5,.75]) {
  const time=toss.start+toss.duration*fraction;assert(flat.session.seekFlow(time));assert(slope.session.seekFlow(time));
  flat.people.readPerson(flat.person,view);const h=flat.session.flowSample.hoops[0],a=new Vector3(h.x,h.y,h.z).applyMatrix4(flowBodyMatrix(flat.session,view));
  slope.people.readPerson(slope.person,view);const sh=slope.session.flowSample.hoops[0],b=world.set(sh.x,sh.y,sh.z).applyMatrix4(flowBodyMatrix(slope.session,view));
  assert(a.distanceTo(b)<3e-6,'inertial hoop keeps its world flight when the dancer follows a slope');ys.push(b.y);samples++;
 }
 const dt=toss.duration*.25;near((ys[0]-2*ys[1]+ys[2])/(dt*dt),-9.81,'world hoop gravity is stable through moving terrain',2e-5);assert.equal(samples,3);flat.session.dispose();slope.session.dispose();
}
for(const mode of ['nan-root-entry','extreme-foot-entry','nan-foot-entry','nan-update','nan-seek']) {
 const f=sessionFixture();
 if(mode==='nan-root-entry')f.place.groundAt=()=>NaN;
 if(mode==='extreme-foot-entry')f.place.groundAt=x=>x>.01?5:0;
 if(mode==='nan-foot-entry')f.place.groundAt=x=>x>.01?NaN:0;
 assert(f.session.start(f.person));
 if(mode==='nan-update'||mode==='nan-seek'){f.session.update(0);assert.equal(f.session.phase,'hooping');f.place.groundAt=()=>NaN;}
 const published=f.published.length;
 if(mode==='nan-seek')assert.equal(f.session.seekFlow(2),false);else f.session.update(mode==='nan-update'?.05:0);
 assert.equal(f.session.phase,'idle',mode+' safely cancels');assert.equal(f.people.activityClaims.current.size,0,mode);assert.equal(f.reservation,null,mode);assert.equal(f.releases,1,mode);assert(!f.shown,mode);assert.equal(f.published.length,published,mode+' never publishes an invalid cached pose');assert(f.session.events.some(event=>event.type==='obstruction'&&event.detail==='terrain-reach'),mode+' records environmental cancellation');f.session.dispose();
}
console.log('PASS planted-foot terrain lifecycle: stationary world support on mild slopes, inertial gravity and safe cancellation before invalid publication.');
