#!/usr/bin/env node
import assert from 'node:assert/strict';
import {Matrix4,Vector3,Quaternion,Euler} from 'three';
import {makePeopleCrowd,Vector} from './test-support/peopleCrowd.js';
import {HulaSession} from '../src/people/hulaSession.js';
import {HulaActivity} from '../src/people/hulaActivity.js';
import {PeopleRuntime} from '../src/people/runtime.js';
import {registry} from '../src/registry.js';

// Production public Crowd claims/movement/publication over a recording renderer.
// This matrix only records the public pose protocol; it is not the complete
// rendered foot-lift/body geometry. GPU/shader/material acceptance belongs to
// the production browser workshop/game.
function population() {
 const people=makePeopleCrowd(),published=[],matrices=new Map(),scratch={};
 const q=new Quaternion(),e=new Euler(),pos=new Vector3(),scale=new Vector3(),lean=new Matrix4();
 people._writeMatrices=npc=>{
  const owner=people.activityClaims.current.get(npc.personHandle)?.claim.owner;
  const sample=owner?.sampleBodyPose?.(npc.personHandle,scratch);
  const m=matrices.get(npc.idx)??new Matrix4();matrices.set(npc.idx,m);
  let bob=sample?.feet?sample.rootY:(sample?.bob??0);if(npc.frownTimer>0&&!sample?.feet)bob=0;
  pos.set(npc.pos.x,npc.pos.y+bob*(npc.scale??1),npc.pos.z);scale.setScalar(npc.scale??1);
  q.setFromEuler(e.set(0,npc.yaw,0));m.compose(pos,q,scale);
  if(sample)m.multiply(lean.makeRotationFromEuler(e.set(sample.leanX,0,sample.leanZ)));
  if(sample?.articulated) {
   const cached=owner.style==='classic'?owner.classicSample:owner.flowSample;
   assert.equal(sample.version,cached?.version??sample.version,'cache version is complete before synchronous Crowd publication');
   if(cached){near(cached.time,owner.style==='classic'?owner.elapsed:owner.scoreTime,'cached accepted mode time');assert.deepEqual({...sample.arms},{...cached.arms});
    if(cached.feet){assert.deepEqual(sample.feet,cached.feet,'foot targets are complete before synchronous publication');assert.notEqual(sample.feet,cached.feet,'provider copies foot storage into caller scratch');near(sample.rootY,cached.rootY,'published root displacement matches the same cached sample');}
   }
   published.push({handle:npc.personHandle,style:sample.style,generation:sample.generation,version:sample.version,time:owner.style==='classic'?owner.elapsed:owner.scoreTime,arms:{...sample.arms}});
  }
 };
 people.armsMesh.getMatrixAt=(index,out)=>out.copy(matrices.get(index)??new Matrix4());
 const spawn=(x=0,z=0)=>{const handle=people.spawnPerson({pos:new Vector(x,0,z)}),n=people.peopleHandles.resolve(handle);n.scale=1;n.frownTimer=0;return handle;};
 return {people,spawn,published,matrices};
}
function sessionFixture({duration=12,style='flow',profile='lyrical',timeout=30}={}) {
 const p=population(),person=p.spawn(),record=p.people.peopleHandles.resolve(person);
 let reservation=null,releases=0,shown=false;
 const place={
  reserve(){if(reservation)return null;return reservation={};},isLive:r=>r===reservation,
  release(r){if(r===reservation){reservation=null;releases++;}},show(r,on){shown=on;},
  target(r,phase,out){if(r!==reservation)return false;out.x=phase==='leaving'?4:0;out.y=0;out.z=0;return true;},
  canMove:r=>r===reservation,
 };
 const session=new HulaSession({people:p.people,place,eligible:v=>!v.claimed,duration,timeout,speed:4});
 session.configure({style,duration,seed:1977,profile,hoops:1});
 const start=()=>{assert(session.start(person));session.update(0);assert.equal(session.phase,'hooping');};
 return {...p,person,record,place,session,start,get reservation(){return reservation;},get releases(){return releases;},get shown(){return shown;}};
}
const near=(a,b,label,tolerance=1e-10)=>assert(Math.abs(a-b)<=tolerance,label+': '+a+' vs '+b);
function comparable(sample) {return {time:sample.time,segment:sample.segment,bob:sample.bob,leanX:sample.leanX,leanZ:sample.leanZ,rootY:sample.rootY??0,travelX:sample.travelX??0,travelZ:sample.travelZ??0,turn:sample.turn??0,stride:sample.stride??0,headYaw:sample.headYaw??0,headTilt:sample.headTilt??0,feet:sample.feet?structuredClone(sample.feet):null,arms:{...sample.arms},hoops:sample.hoops.map(h=>({...h}))};}
function sameNumbers(a,b,label='sample') {
 if(typeof a==='number'){near(a,b,label,1e-9);return;}
 if(a&&typeof a==='object'){for(const key of Object.keys(a))sameNumbers(a[key],b[key],label+'.'+key);return;}
 assert.equal(a,b,label);
}
{
 const f=sessionFixture();f.start();assert(f.shown);assert.equal(f.session.flowSample.version,f.published.at(-1).version);
 const before=f.session.scoreTime;f.session.update(0);near(f.session.scoreTime,before,'zero accepted time');
 for(let i=0;i<150;i++)f.session.update(.05);
 assert.equal(f.published.at(-1).version,f.session.version);assert(f.session.events.some(e=>e.type==='segment'));
 const elapsed=f.session.elapsed,wait=f.session.wait,events=f.session.events.length;
 assert(f.session.seekFlow(2));near(f.session.scoreTime,2,'isolated score seek');near(f.session.elapsed,elapsed,'seeking cannot rewind participation');near(f.session.wait,wait,'seeking cannot rewind waiting');assert.equal(f.session.events.length,events);assert.equal(f.people.activityCooldown(f.person,'hula'),0);
 assert(!f.session.seekFlow(-1));assert(!f.session.seekFlow(Infinity));assert(!f.session.seekFlow(100));
 for(const dt of [-1,.051,Infinity,NaN])assert.throws(()=>f.session.update(dt),RangeError);
 f.session.dispose();assert.equal(f.people.activityClaims.current.size,0);assert.equal(f.releases,1);assert(!f.shown);
}
console.log('PASS flow session: cache-before-publication, same version, segment boundaries, zero/invalid delta and isolated score seeking.');
{
 const flow=sessionFixture(),classic=sessionFixture({style:'classic'}),scratch={};flow.start();classic.start();
 flow.session.update(.05);assert.equal(flow.session.sampleBodyPose(flow.person,scratch).style,'flow');assert(Object.values(scratch.arms).some(x=>x!==0));
 assert.equal(classic.session.sampleBodyPose(classic.person,scratch).style,'classic');assert.equal(scratch.articulated,true);assert.equal(scratch.hoopCount,0);assert(Object.values(scratch.arms).some(x=>x!==0),'waist mode has its own expressive arms');assert(scratch.feet);assert.equal(scratch.travelX,0);assert.equal(scratch.travelZ,0);assert.equal(scratch.turn,0);
 assert.equal(flow.session.sampleBodyPose(classic.person,scratch),null);assert.equal(scratch.style,'inactive');assert.equal(scratch.hoopCount,0);assert.equal(scratch.arms,null);
 assert.equal(flow.session.sampleBodyPose(flow.person,scratch).style,'flow');assert.equal(scratch.version,flow.session.flowSample.version);
 flow.session.finish();assert.equal(flow.session.sampleBodyPose(flow.person,scratch),null);assert.equal(scratch.style,'inactive');
 assert(flow.session.start(flow.person));flow.session.update(0);assert.equal(flow.session.sampleBodyPose(flow.person,scratch).style,'flow');assert.equal(scratch.generation,2);
 flow.session.dispose();classic.session.dispose();
}
console.log('PASS mixed flow/classic/inactive/flow scratch, explicit discriminators and recycled session generations.');
{
 const a=sessionFixture(),b=sessionFixture();a.start();b.start();
 for(let i=0;i<50;i++)a.session.update(.05);for(let i=0;i<100;i++)b.session.update(.025);
 near(a.session.elapsed,b.session.elapsed,'accepted partition elapsed');sameNumbers(comparable(a.session.flowSample),comparable(b.session.flowSample));
 const unchanged=comparable(a.session.flowSample);for(let i=0;i<20;i++)a.session.sampleBodyPose(a.person,{});assert.deepEqual(comparable(a.session.flowSample),unchanged,'repeated readers never advance state');
 a.session.dispose();b.session.dispose();
}
console.log('PASS flow frame partitions and sample-reader order independence.');
{
 const f=sessionFixture();f.start();
 const interrupt=()=>{
  const elapsed=f.session.elapsed,epoch=f.session.scoreEpoch,claim=f.session.claim;
  f.people.activityClaims.removePerson(f.person,'honk');assert.equal(f.session.phase,'interrupted');assert(!f.shown);assert(!f.people.writeActivityPose(claim,9,0,9));
  f.session.update(.05,{safe:false});near(f.session.elapsed,elapsed,'interrupted wait is not participation');
  f.session.update(.05,{safe:true});assert.equal(f.session.phase,'approaching');
  // A flow phrase can travel away from its anchor. Reacquisition legitimately
  // walks back before the fresh entrance; approach time is not participation.
  f.session.update(0);
  for(let step=0;step<200&&f.session.phase==='approaching';step++){f.session.update(.05);near(f.session.elapsed,elapsed,'return approach is not participation');}
  assert.notEqual(f.session.phase,'approaching','bounded return reaches the anchor or ends safely');
  if(f.session.phase==='hooping'){near(f.session.elapsed,elapsed,'restart preserves lifetime');near(f.session.scoreTime,0,'restart has fresh local score time');assert.equal(f.session.scoreEpoch,epoch+1);}
 };
 for(let cycle=0;cycle<3;cycle++){for(let i=0;i<40;i++)f.session.update(.05);interrupt();}
 assert.equal(f.session.phase,'hooping');assert(f.session.elapsed>5.9);
 for(let step=0;f.session.elapsed<8.1;step++){assert(step<200,'bounded lifetime advance');assert.equal(f.session.phase,'hooping');f.session.update(.05);}interrupt();
 assert.equal(f.session.phase,'idle','remaining time below minimum entrance/resolution ends safely');assert(f.session.elapsed<12);assert.equal(f.releases,1);assert.equal(f.people.activityClaims.current.size,0);assert.equal(f.people.activityCooldown(f.person,'hula'),20);
 f.session.dispose();
}
console.log('PASS repeated flow interruptions preserve participation and use bounded fresh score epochs near completion.');
for(const mode of ['person','place','timeout','reacquire-denied']) {
 const f=sessionFixture({timeout:.1});f.start();f.people.activityClaims.removePerson(f.person,'honk');
 if(mode==='person')f.people.removePerson(f.person);
