 const tick=(dt=.05)=>{runtime.beginFrame(dt);runtime.run('roaming',frame);};
 const cleanup=()=>{try{activity.dispose();}finally{runtime.dispose();registry.remove(id);}};
 return {...p,runtime,activity,id,entry,frame,tick,cleanup};
}
