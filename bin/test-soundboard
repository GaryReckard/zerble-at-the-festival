#!/usr/bin/env node
import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {runInNewContext} from 'node:vm';import {Node,Vector} from './test-support/sceneObjects.mjs';import {MARQUEE_SHAPE} from '../src/festivalShapes.js';
class Geometry{constructor(...args){this.args=args;}setAttribute(){}setIndex(){}computeVertexNormals(){}}
class Mesh extends Node{constructor(geometry,material){super();this.geometry=geometry;this.material=material;}}
class Instances extends Mesh{constructor(g,m,count){super(g,m);this.count=count;this.instanceMatrix={};this.matrices=[];}setMatrixAt(i,m){this.matrices[i]={...m};}}
class Matrix{makeTranslation(x,y,z){Object.assign(this,{x,y,z});return this;}}
const source=readFileSync(new URL('../src/models/tentStage.js',import.meta.url),'utf8').replace(/^import .*;$/gm,'').replace('export function','function');
const build=runInNewContext(source+';buildTentStage',{MARQUEE_SHAPE,THREE:{Group:Node,Mesh,InstancedMesh:Instances,Matrix4:Matrix,Vector3:Vector,BufferGeometry:Geometry,BufferAttribute:class{},BoxGeometry:Geometry,CylinderGeometry:Geometry,SphereGeometry:Geometry,MeshStandardMaterial:class{constructor(options){Object.assign(this,options);}},DoubleSide:2},buildStage:()=>({group:new Node(),deckWidth:12,deckDepth:8,deckHeight:1,scale:1,stageLights:[],stageBeams:[]}),placeBandOnStage:()=>[],buildPerformer:(instrument,rng)=>{assert.equal(instrument,'sound');assert.equal(rng(),.4);return new Node();}});
let draws=0;const stage=build({rng:()=>{draws++;return .4;}}),desk=stage.group.children.find(n=>n.name==='Soundboard'),engineer=stage.group.children.find(n=>n.name==='Sound engineer');assert(desk&&engineer);assert(desk.rotation.x>0);assert(engineer.position.z>desk.position.z);assert.equal(engineer.position.y,.5);assert.equal(engineer.rotation.y,0);assert.equal(stage.performers.at(-1),engineer,'attendant uses existing place-performer update/unload ownership');
assert.equal(draws,36,'adding the attendant consumes no additional tent RNG draws');
const leds=desk.children.filter(n=>n.name==='Mixer control'),faders=desk.children.find(n=>n.name==='Mixer faders');assert.equal(leds.length,12);assert.equal(faders.count,12);assert(faders.instanceMatrix.needsUpdate);assert.equal(faders.matrices.length,12);
const chunks=readFileSync(new URL('../src/chunks.js',import.meta.url),'utf8'),block=chunks.slice(chunks.indexOf('// Soundbooth platform collider'),chunks.indexOf('// Attractor in front',chunks.indexOf('// Soundbooth platform collider')));assert(block.includes("kind: 'soundboard'"));assert(!block.includes("kind: 'tent'"));
const main=readFileSync(new URL('../src/main.js',import.meta.url),'utf8');const a=main.indexOf('function toastForKind('),b=main.indexOf('\n}',a)+2;const toast=runInNewContext(main.slice(a,b)+';toastForKind');assert.equal(toast('soundboard'),'Easy around the soundboard!');
const sound=readFileSync(new URL('../src/sound.js',import.meta.url),'utf8');assert(sound.includes('soundboard:'));console.log('PASS soundboard: production desk orientation, attached controls, engineer platform/heading, place-owned attendance, unchanged RNG count and specific collision toast/sound routing.');
