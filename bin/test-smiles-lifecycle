#!/usr/bin/env node
import { register } from 'node:module';
import assert from 'node:assert/strict';
register('./node-three-shim.mjs', import.meta.url);
globalThis.localStorage = { getItem: () => null };
globalThis.window = { matchMedia: () => ({ matches: false, addEventListener() {} }) };
const { Smiles } = await import('../src/smiles.js');
const { A11y } = await import('../src/a11y.js');
const { Vector3 } = await import('three');
const smiles = new Smiles();
const far = { position: new Vector3(1000, 0, 0) };
const npc = { pos: new Vector3(-1000, 0, 0) };
const geometries = new Set(), materials = new Set();
let collected = 0;
const collect = n => { collected += n; };
for (let cycle = 0; cycle < 10; cycle++) {
  for (let i = 0; i < 20; i++) {
    smiles.spawn(new Vector3());
    smiles.spawnLost(new Vector3(), npc);
  }
  for (const s of smiles.active) {
    geometries.add(s.halo.geometry);
    materials.add(s.halo.material);
    assert.equal(s.halo.material, s.lost ? smiles._lostHaloMat : smiles._haloMat);
    assert.equal(s.halo.material.opacity, 0.5);
    assert.equal(s.halo.material.depthWrite, false);
  }
  smiles.update(15, far, collect);
  assert.equal(smiles.active.length, 0);
  assert.equal(smiles.group.children.length, 0);
}
assert.equal(collected, 0, 'expiry must not award points');
assert.equal(geometries.size, 1, 'lifetime halo geometry count must be bounded');
assert.equal(materials.size, 2, 'each halo color has one session-owned material');
for (const resource of [...geometries, ...materials]) assert.equal(resource.disposeCount, 0);

smiles.spawn(new Vector3());
smiles.update(0, { position: new Vector3() }, collect);
assert.equal(collected, 1);
assert.equal(smiles.active.length, 0);
A11y.setColorblind(true);
smiles.spawnLost(new Vector3(), { pos: new Vector3() });
assert.equal(smiles.active[0].mesh.children.length, 2, 'lost halo retains the colorblind minus marker');
smiles.update(0, far, collect);
assert.equal(collected, 1, 'lost arrival must not award points');
assert.equal(smiles.active.length, 0);

smiles.spawn(new Vector3());
smiles.spawnLost(new Vector3(), npc);
const [earned, lost] = smiles.active;
smiles.update(0.1, far, collect);
assert.equal(earned.mesh.position.y, 1.6 + 2.8 * 0.1 + Math.sin(0.4) * 0.005);
assert.equal(lost.mesh.position.y, 1.4 + 2.8 * 0.1);
const before = lost.mesh.position.clone();
smiles.update(0.2, far, collect);
assert.ok(lost.mesh.position.x < before.x, 'lost smiles still home toward their NPC');
assert.ok(earned.mesh.position.x > 0, 'earned smiles still home toward Zerble');
assert.equal(earned.halo.geometry, lost.halo.geometry);
assert.notEqual(earned.halo.scale, lost.halo.scale, 'pulses are per-mesh, not shared');

const resources = [smiles._geo, smiles._faceGeo, smiles._minusGeo, smiles._haloGeo,
  smiles._mat, smiles._lostMat, smiles._faceMat, smiles._minusMat, smiles._haloMat, smiles._lostHaloMat];
smiles.dispose();
assert.equal(smiles.active.length, 0);
assert.equal(smiles.group.children.length, 0);
for (const resource of resources) assert.equal(resource.disposeCount, 1, 'owner disposes each resource once');
console.log('PASS smiles: bounded resources over 400 pickups, all removal paths, motion, scoring, colorblind marker, owner teardown');
