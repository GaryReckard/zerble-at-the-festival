#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import vm from 'node:vm';
import { registerCampsite, canPlaceCampsite, campSeatApproaches } from '../src/campRegistry.js';
class Position {
  constructor(x=0,y=0,z=0){Object.assign(this,{x,y,z});}
  clone(){return new Position(this.x,this.y,this.z);}
  set(x,y,z){Object.assign(this,{x,y,z});return this;}
}
const camp={group:{position:new Position(10,0,20),rotation:{y:Math.PI/2},scale:{x:2,y:2,z:2}},footprint:10,
 seats:[{x:1,z:2,y:.45,yaw:0}],tents:[{x:-1,z:0,entry:{x:-1,z:3}}],
 childColliders:[{kind:'tent',x:-1,z:0,radius:1.5},{kind:'camp_post',x:2,z:2,radius:.1}]};
const entries=[];const registry={add(e){entries.push(e);return entries.length;}};
assert.deepEqual(registerCampsite(registry,camp,{chunkKey:'4,5'}),[1,2,3]);
const entry=entries[0];assert.equal(entry.collider,undefined);assert.equal(entry.footprint,10);
assert.equal(entry.campSeats[0].x,14);assert.equal(entry.campSeats[0].z,18);
assert.equal(entry.campSeats[0].yaw,Math.PI*1.5);assert.equal(entry.campSeats[0].approachX,15.2);
assert.equal(entry.campSeats[0].y,.9);assert.equal(entry.campBeds[0].doorX,16);
assert.equal(entries[1].collider.radius,3);assert.equal(entries[1].collider.damage,1);assert.equal(entries[1].position.z,22);
assert.ok(entries.every(e=>e.chunkKey==='4,5'));
entries.length=0;registerCampsite(registry,camp);assert.ok(entries.every(e=>!('chunkKey' in e)),'lake solids survive host chunk removal');
console.log('PASS campsite transforms, granular collisions, seat/bed metadata, and owner lifetimes');
const fireCamp = { ...camp, childColliders: [{kind:'campfire', x:2, z:-1, radius:.8}] };
entries.length=0; registerCampsite(registry,fireCamp);
assert.equal(entries[0].campFire.x,8); assert.equal(entries[0].campFire.z,16);
assert(!('campFire' in entry),'a fireless satellite never invents a musical gathering center');
console.log('PASS camp hearth metadata follows actual rotated/scaled fire position');

const loveseat = {};
camp.seats = [{x:1,z:2,y:.45,yaw:0,group:loveseat},{x:1.8,z:2,y:.45,yaw:0,group:loveseat}];
camp.childColliders = [{kind:'camp_chair',x:1.4,z:2,radius:.7,group:loveseat}];
entries.length=0; registerCampsite(registry,camp);
assert.equal(entries[0].campSeats[0].collider,entries[1]);
assert.equal(entries[0].campSeats[1].collider,entries[1]);
entries[0].campSeats[0].occupied=true;
assert.equal(entries[0].campSeats[1].occupied,false,'loveseat occupants reserve independently');
console.log('PASS loveseat slots share the furniture collider while retaining independent reservations');

for (const seat of entries[0].campSeats) assert.ok(Math.hypot(seat.approachX-entries[1].position.x,seat.approachZ-entries[1].position.z)>entries[1].collider.radius+.28,'loveseat approach remains outside its wider collision disc');

const candidate={group:{position:new Position(),rotation:{y:0},scale:{x:1,y:1,z:1}},footprint:5,
 childColliders:[{x:0,z:0,radius:1}],seats:[],tents:[{x:0,z:0,entry:{x:0,z:3}}]};
const owner={kind:'campsite',position:new Position(2,0,0),footprint:5,campNeighborhood:'shared'};
let blockers=[];
const gate={entries:new Map(),byKind:new Map(),footprintsNear(x,z,r,fn){fn(owner);},
 collidersNear(x,z,r,fn){blockers.forEach(fn);}};
assert.equal(canPlaceCampsite(gate,candidate,'shared'),true,'empty reservations can overlap within a household');
assert.equal(canPlaceCampsite(gate,candidate,'another'),false,'separate households retain their reserved grounds');
blockers=[{position:new Position(),collider:{radius:.2}}];
assert.equal(canPlaceCampsite(gate,candidate,'shared'),false,'shared ground does not permit overlapping furniture');
blockers=[{position:new Position(0,0,3),collider:{radius:.2}}];
assert.equal(canPlaceCampsite(gate,candidate,'shared'),false,'tent door remains accessible');
blockers=[];owner.campBeds=[{doorX:0,doorZ:.5}];gate.entries.set(9,owner);gate.byKind.set('campsite',new Set([9]));
assert.equal(canPlaceCampsite(gate,candidate,'shared'),false,'new furniture cannot block an earlier tent door');
assert.equal(gate.entries.size,1,'rejected candidates cause no partial registration');
console.log('PASS compact placement rejects furniture/door conflicts and preserves external reservations without mutation');

const forestEntry={kind:'forest',position:new Position(),footprint:100,chunkKey:'forest-center'};
const forestGate={entries:new Map(),byKind:new Map(),footprintsNear(x,z,r,fn){fn(forestEntry);},
  collidersNear(x,z,r,fn){blockers.forEach(fn);}};
blockers=[];
assert.equal(canPlaceCampsite(forestGate,candidate,'forest:1:0'),false,'ordinary placement respects forest reservation');
assert.equal(canPlaceCampsite(forestGate,candidate,'forest:1:0',{forestOwnerKey:'forest-center'}),true,
  'planned interior campsite can use its own containing forest');
assert.equal(canPlaceCampsite(forestGate,candidate,'forest:1:0',{forestOwnerKey:'another-center'}),false,
  'another forest owner remains reserved');
forestEntry.collider={radius:100};
assert.equal(canPlaceCampsite(forestGate,candidate,'forest:1:0',{forestOwnerKey:'forest-center'}),false,
  'a solid forest boundary is never exempted');
delete forestEntry.collider;
blockers=[{kind:'tree',position:new Position(),collider:{radius:.9}}];
assert.equal(canPlaceCampsite(forestGate,candidate,'forest:1:0',{forestOwnerKey:'forest-center'}),false,
  'own-forest exemption does not permit overlap with tree trunks');
console.log('PASS forest placement distinguishes containing owner reservations, foreign forests and physical tree solids');

const ownChair={};
const approachCamp={group:{position:new Position(),rotation:{y:0},scale:{x:1,y:1,z:1}},footprint:5,
  seats:[{x:0,z:0,y:.4,yaw:0,group:ownChair}],tents:[],
  childColliders:[{x:0,z:0,radius:.4,group:ownChair},{x:0,z:.8,radius:.2,group:{}}]};
const routed=campSeatApproaches(approachCamp)[0];
assert(routed&&Math.abs(routed.x)>.1,'a blocked straight approach selects a clear angled route');
const segmentDistance=(point,a,b)=>{
  const dx=b.x-a.x,dz=b.z-a.z,t=Math.max(0,Math.min(1,((point.x-a.x)*dx+(point.z-a.z)*dz)/(dx*dx+dz*dz)));
  return Math.hypot(point.x-a.x-t*dx,point.z-a.z-t*dz);
};
assert(segmentDistance({x:0,z:.8},{x:0,z:0},routed)>=.55,'the complete route clears other furniture by NPC radius');
approachCamp.childColliders[1].radius=10;
assert.equal(campSeatApproaches(approachCamp)[0],null,'an enclosed seat never receives an invented valid approach');
const unreachable=[];registerCampsite({add(e){unreachable.push(e);return unreachable.length;}},approachCamp);
assert.equal(unreachable[0].campSeats.length,0,'unreachable furniture does not advertise a claim');
approachCamp.childColliders[1].radius=.2;
const routeRegistry={entries:new Map(),byKind:new Map(),footprintsNear(){},collidersNear(){}};
const earlier={kind:'campsite',position:new Position(),footprint:5,campSeats:[{x:0,z:0,approachX:0,approachZ:4}]};
routeRegistry.entries.set(1,earlier);routeRegistry.byKind.set('campsite',new Set([1]));
const crossing={group:{position:new Position(),rotation:{y:0},scale:{x:1,y:1,z:1}},footprint:5,
  seats:[],tents:[],childColliders:[{x:0,z:2,radius:.2}]};
assert.equal(canPlaceCampsite(routeRegistry,crossing,'shared'),false,
  'later furniture cannot cross an existing seat route when both endpoints remain clear');
console.log('PASS chair approaches select a clear full route, omit unreachable claims and protect older routes from later camps');

camp.tents[0].capacity=5;entries.length=0;registerCampsite(registry,camp);
assert.equal(entries[0].campBeds.length,5,'large shelters use their modeled sleeping capacity');
entries[0].campBeds[0].occupied=true;
assert.equal(entries[0].campBeds[1].occupied,false,'sleeping reservations remain independent within one shelter');

const lakeEnvelope={kind:'lake',position:new Position(),footprint:80};
let lakeSolids=[],otherReservations=[];
const lakeGate={entries:new Map(),byKind:new Map(),footprintsNear(x,z,r,fn){[lakeEnvelope,...otherReservations].forEach(fn);},collidersNear(x,z,r,fn){lakeSolids.forEach(fn);}};
assert.equal(canPlaceCampsite(lakeGate,candidate,'woodland'),false,'unchecked callers retain broad lake protection');
assert.equal(canPlaceCampsite(lakeGate,candidate,'woodland',{waterChecked:false}),false,'preview callers retain broad lake protection');
assert.equal(canPlaceCampsite(lakeGate,candidate,'woodland',{waterChecked:true}),true,'exact dry checks authorize bypassing only a non-solid lake envelope');
lakeEnvelope.collider={radius:80};
assert.equal(canPlaceCampsite(lakeGate,candidate,'woodland',{waterChecked:true}),false,'a solid lake entry remains authoritative');
delete lakeEnvelope.collider;
lakeSolids=[{kind:'lake_edge',position:new Position(),collider:{radius:.8}}];
assert.equal(canPlaceCampsite(lakeGate,candidate,'woodland',{waterChecked:true}),false,'shoreline solids remain authoritative after dry checks');
lakeSolids=[];otherReservations=[{kind:'stage',position:new Position(),footprint:6}];
assert.equal(canPlaceCampsite(lakeGate,candidate,'woodland',{waterChecked:true}),false,'dry checks cannot bypass unrelated venue reservations');
console.log('PASS checked-water opt-in preserves unchecked/preview lake protection, shoreline solids and unrelated reservations');

const chunkSource=readFileSync(new URL('../src/chunks.js',import.meta.url),'utf8');
const preflightSource=chunkSource.slice(chunkSource.indexOf('function placeSingleCampsite('),chunkSource.indexOf('// Camp village theme'));
let waterMode='dry',waterQueries=0,buildCount=0;
const waterFlags=[];
const place=vm.runInNewContext(preflightSource+';placeSingleCampsite',{
  campsiteFootprint:()=>5,USE_WORLDGEN_V2:true,ROAD_RIBBON_WIDTH:8,nearestRoad:()=>({dist:Infinity}),THREE:{Vector3:Position},
  isPointInLake:(x,z)=>{waterQueries++;return waterMode==='center'&&x===10&&z===20||waterMode==='rim'&&x===15&&z===20;},
  registry:{},buildCampsite:()=>{buildCount++;return {group:{position:new Position(),rotation:{y:0}},animatables:[]};},
  canPlaceCampsite:(registry,camp,neighborhood,options)=>{waterFlags.push(options.waterChecked);return true;},
  registerCampsite(){},forestAnimatables:[],
});
const liveCtx={rng:()=>.5,group:{add(){}}};
assert(place(liveCtx,10,20,'small',0,{campNeighborhood:'checked'}));
assert.equal(waterQueries,17,'live placement checks actual water at center and sixteen perimeter points');
assert.equal(waterFlags[0],true);
waterQueries=0;
assert(place({...liveCtx,campPreview:true},10,20,'small',0,{campNeighborhood:'preview'}));
assert.equal(waterQueries,0);assert.equal(waterFlags[1],false,'preview cannot claim dry checks it skipped');
waterQueries=0;waterMode='center';
assert.equal(place(liveCtx,10,20,'small',0,{campNeighborhood:'wet'}),null);assert.equal(waterQueries,1);
waterQueries=0;waterMode='rim';
assert.equal(place(liveCtx,10,20,'small',0,{campNeighborhood:'wet-rim'}),null);assert.equal(waterQueries,2);
assert.equal(buildCount,2,'wet center and wet rim return before constructing or authorizing a camp');
assert.equal(waterFlags.length,2,'wet preflights never reach the opt-in placement guard');
console.log('PASS production preflight: seventeen dry checks authorize opt-in; previews stay unchecked and wet center/rim stop before construction.');
