#!/usr/bin/env python3
"""Atomic local export tests. No browser launches."""
import functools,http.server,json,runpy,sys,tempfile,threading,urllib.request,urllib.error
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'tooling'))
from performance_lab.supervisor import Handler
from performance_lab.contract import canonical,digest
fixture=runpy.run_path(str(Path(__file__).with_name('test-performance-lab-contract')))['fixture']
with tempfile.TemporaryDirectory(prefix='zerble-lab-export-') as root:
 server=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(Handler,directory=root));origin=f'http://127.0.0.1:{server.server_port}'
 server.lab=dict(token='token',runId='r',origin=origin,directory=Path(root),lock=threading.Lock());thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
 def post(value,source=origin):
  request=urllib.request.Request(origin+'/__lab/token/r',canonical(value),headers={'Content-Type':'application/json','Origin':source})
  try:
   with urllib.request.urlopen(request,timeout=3) as response:return response.status,json.load(response)
  except urllib.error.HTTPError as error:return error.code,None
 try:
  report=fixture();report['state']='exporting'
  a=post(report);b=post(report);assert a==b;assert a[1]['hash']==digest(report)
  assert json.loads((Path(root)/'capture.json').read_text())==report
  assert post(report,'https://other.example')[0]==403
  changed=fixture();changed['cost']['drawsMax']=3000;assert post(changed)[0]==409
  assert post({'identity':{'runId':'r'}})[0]==422
  for malformed in (None,[],True,{'identity':None},{'identity':{'runId':['r']}}):assert post(malformed)[0]==422
  assert not list(Path(root).glob('*.pending'))
 finally:server.shutdown();server.server_close();thread.join()
print('PASS lab transport: real loopback HTTP atomic persistence, durable hash, idempotent identical retry, conflicting exports, schema/origin checks; no browser launched')
