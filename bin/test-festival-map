#!/usr/bin/env node
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import vm from 'node:vm';
import { cellAddress, emptyBlock, mergeBlock, revealPoints, projectPin, tileView, landmarkId } from '../src/festivalMap/model.js';
assert.deepEqual(cellAddress(-.01, -.01), {key:'-1,-1',index:1023});
assert.deepEqual(cellAddress(-512, 0), {key:'-1,0',index:0});
const a=emptyBlock(), b=emptyBlock(); a.bits[0]=1;b.bits[0]=128;
assert.equal(mergeBlock(a,b).bits[0],129);assert.equal(a.bits[0],1);
const cells=new Set();revealPoints({x:0,z:0},{x:100,z:0},(x,z)=>cells.add(`${x},${z}`));
assert(cells.has('48,0'),'continuous driving reveals the connecting segment');
const jumped=new Set();revealPoints({x:0,z:0},{x:5000,z:0},(x,z)=>jumped.add(`${x},${z}`));
assert(!jumped.has('2496,0'),'teleport never reveals connecting segment');
for(const target of [{x:1e6,z:0},{x:-1e6,z:1e6},{x:0,z:0}]) {
 const pin=projectPin({x:0,z:0},target,200,200,1);assert(pin.x>=20&&pin.x<=180);assert(pin.y>=20&&pin.y<=180);assert(pin.size>=7&&pin.size<=13);
}
assert(projectPin({x:0,z:0},{x:100,z:0},200,200,1).size>projectPin({x:0,z:0},{x:1000,z:0},200,200,1).size);
for(const width of [180,800,2400]) for(const height of [180,900,2400]) for(const scale of [.1,.5,4]) {
 const tiles=tileView({x:-600,z:123},width,height,scale);assert(tiles.length<=36,'working set fits 64 tile cache');
}
// Circular edge pins preserve bearing at cardinal and diagonal angles.
for(let degrees=0;degrees<360;degrees+=15){
 const angle=degrees*Math.PI/180,target={x:Math.cos(angle)*10000,z:Math.sin(angle)*10000};
 const pin=projectPin({x:0,z:0},target,200,200,1,20,'circle');
 assert(pin.edge);assert(Math.abs(Math.hypot(pin.x-100,pin.y-100)-80)<1e-8,'pin sits on circular inset rim');
 assert(Math.abs((pin.x-100)/80-Math.cos(angle))<1e-8,'circular clamp preserves bearing');
}
const insideCircle=projectPin({x:0,z:0},{x:30,z:40},200,200,1,20,'circle');
assert(!insideCircle.edge);assert.equal(insideCircle.x,130);assert.equal(insideCircle.y,140);
const corner=projectPin({x:0,z:0},{x:70,z:70},200,200,1,20,'circle');
assert(corner.edge,'square corners outside the circle must clamp');
assert(!projectPin({x:0,z:0},{x:70,z:70},200,200,1).edge,'expanded rectangle retains its own boundary');
assert.equal(landmarkId('seed','stage',1,2),landmarkId('seed','stage',1,2));
assert.notEqual(landmarkId('seed','stage',1,2),landmarkId('other','stage',1,2));
console.log('Festival map geometry/discovery contracts pass');
const { Discovery } = await import('../src/festivalMap/discovery.js');
const { EpochChanged } = await import('../src/festivalMap/storage.js');
function memoryStorage() {
 const rows=new Map(),epochs=new Map();
 return {epoch:async w=>epochs.get(w)||0,
 read:async(w,k,e)=>{if((epochs.get(w)||0)!==e)throw new EpochChanged();return mergeBlock(rows.get(`${w}:${e}:${k}`));},
 write:async(w,k,v,e)=>{if((epochs.get(w)||0)!==e)throw new EpochChanged();const id=`${w}:${e}:${k}`,r=mergeBlock(rows.get(id),v);rows.set(id,r);return r;},
 reset:async w=>{const e=(epochs.get(w)||0)+1;epochs.set(w,e);return e;},close(){} };
}
const settle=()=>new Promise(r=>setImmediate(r));
const store=memoryStorage(), d=new Discovery('a',store),other=new Discovery('a',store);
await Promise.all([d.ready,other.ready]);d.reveal({x:-20,z:-20});other.reveal({x:200,z:0});await settle();await d.flush();await other.flush();
const restored=new Discovery('a',store);await restored.ready;restored.ensure('-1,-1');restored.ensure('0,0');await settle();
assert(restored.has(-20,-20));assert(restored.has(200,0),'concurrent block unions retain both visits');
const isolated=new Discovery('b',store);await isolated.ready;isolated.ensure('-1,-1');await settle();assert(!isolated.has(-20,-20));
await d.reset();await other.flush();assert.equal(other.blocks.size,0,'another tab adopts reset even without dirty data');
let release;
const delayed={...memoryStorage(),read:()=>new Promise(r=>release=r)};
const late=new Discovery('late',delayed);await late.ready;late.reveal({x:0,z:0});await settle();
const captured=release;await late.reset();captured(mergeBlock(a));await settle();assert.equal(late.blocks.size,0,'old read cannot resurrect reset discovery');
const failed=new Discovery('fail',{...memoryStorage(),epoch:async()=>{throw Error('quota');}});await failed.ready;
for(let i=0;i<150;i++)failed.reveal({x:i*1000,z:0});await settle();assert(failed.blocks.size<=96);assert.equal(failed.storageOK,false);
for(const v of [d,other,restored,isolated,late,failed])v.dispose();
console.log('Festival map persistence/epoch/residency contracts pass');
// Actual worker module with a message-only host: query cost and bytes are real,
// while the test owns an isolated seed context rather than live game state.
const responses=[];globalThis.self={postMessage:m=>responses.push(m)};
await import('../src/festivalMap/geography.worker.js');
self.onmessage({data:{type:'init',seed:1977,mode:'v2',version:(await import('../src/festivalMap/model.js')).VERSION,config:{},identity:'test'}});
assert.equal(responses.at(-1).type,'ready');
for(const size of [256,512,1024]){
 self.onmessage({data:{type:'tile',identity:'test',id:size,tile:{key:String(size),x:0,z:0,size}}});
 const r=responses.at(-1);assert.equal(r.type,'tile',r.message);assert(r.bytes<512000);assert.equal(r.woods.length,144);console.log(`Worker ${size}m: ${r.workerMs.toFixed(2)}ms, ${r.bytes} bytes`);
}
self.onmessage({data:{type:'tile',identity:'bad',id:1,tile:{x:0,z:0,size:256}}});assert.equal(responses.at(-1).type,'error');
const {Geography}=await import('../src/festivalMap/geography.js');
class FakeWorker{postMessage(data){this.sent=data;}terminate(){this.terminated=true;}}
globalThis.Worker=FakeWorker;
const geo=new Geography({seed:1977,mode:'v2',config:{}}),worker=geo.worker;
assert.equal(worker.sent.seed,1977,'numeric canonical seed stays numeric');
geo.worker.onmessage({data:{type:'ready',identity:geo.identity}});
geo.request([{key:'test',x:0,z:0,size:256}]);assert(geo.active);
geo.worker.onmessage({data:{type:'tile',identity:'stale',id:geo.active.id,key:'test'}});assert.equal(geo.tiles.size,0);
geo.fail('forced');assert(worker.terminated);assert.equal(geo.worker,null,'failure never starts synchronous generation');geo.dispose();
console.log('Festival map worker bounds/failure contracts pass');
const { observeMapWorld,refreshMapLive }=await import('../src/festivalMap/markers.js');
const registry={byKind:new Map([['stage_front',new Set([99])],['bubble_jug',new Set([100])]]),entries:new Map([[99,{position:{x:10,z:0}}],[100,{position:{x:20,z:0}}]])};
const remembered=[];const discovery={has:()=>true,remember:m=>remembered.push(m)};
const actor={position:{x:30,z:0}},env={registry,player:{x:0,z:0},lurleen:actor,nutWagon:null,star:null,discovery,namespace:'test'};
const observed=observeMapWorld(env);assert.equal(remembered.length,1);assert.equal(observed.length,2);
registry.entries.delete(100);actor.position.x=500;
assert.equal(refreshMapLive(observed,env).length,0,'collected jug and out-of-range friend disappear without a poll');
console.log('Festival map actual-world marker contracts pass');

// Exercise the actual Canvas arrow renderer against the cart's actual forward
// formula, so an accidental half-turn cannot pass a helper-only test.
const viewSource=readFileSync(new URL('../src/festivalMap/view.js',import.meta.url),'utf8');
const arrowMethod=viewSource.slice(viewSource.indexOf('  drawMarkers(){'),viewSource.indexOf('  snapshot(){'));
const cartSource=readFileSync(new URL('../src/zerble.js',import.meta.url),'utf8');
const forwardFormula=cartSource.match(/const fx = [^;]+;\s*const fz = [^;]+;/)?.[0];
assert(forwardFormula,'cart forward formula is present');
for(const heading of [0,Math.PI/4,Math.PI/2,Math.PI,Math.PI*1.5,-Math.PI/2])for(const expanded of [false,true]){
 const angles=[];const ctx=new Proxy({}, {get:(_,key)=>key==='rotate'?angle=>angles.push(angle):()=>{},set:()=>true});
 const view={overlay:{width:200,height:200,getContext:()=>ctx},ratio:1,width:200,height:200,markers:[],heading,expanded};
 vm.runInNewContext(`({${arrowMethod}}).drawMarkers.call(view)`,{view,Math});
 assert.equal(angles.length,1);
 const expected=vm.runInNewContext(`(function(){${forwardFormula}return {x:fx,z:fz};}).call({heading})`,{heading,Math});
 const angle=angles[0],tip={x:Math.sin(angle),z:-Math.cos(angle)};
 assert(Math.abs(tip.x-expected.x)<1e-9&&Math.abs(tip.z-expected.z)<1e-9,`arrow must face cart travel direction at heading ${heading} (expanded=${expanded})`);
}
console.log('Festival map actual arrow follows cart forward direction');

// Changing shape must move a far pin continuously along its bearing.
let previousX=Infinity;
for(let i=0;i<=20;i++){
 const pin=projectPin({x:0,z:0},{x:1000,z:1000},200,200,1,20,i/20);
 assert(pin.x<=previousX+1e-9);assert(Math.abs(pin.x-pin.y)<1e-9);previousX=pin.x;
}
// Exercise the real layout methods with a changing CSS rectangle. Backings
// stay full-sized during collapse and shrink only after settling.
const layoutMethods=viewSource.slice(viewSource.indexOf('  measure(){'),viewSource.indexOf('  toggle(){'));
const layoutContext={innerWidth:1200,innerHeight:800,devicePixelRatio:2,performance:{now:()=>0},matchMedia:()=>({matches:false}),document:{body:{classList:{contains:()=>false,toggle(){}}},activeElement:null},Math};
const layout=vm.runInNewContext(`new (class {${layoutMethods}})()`,layoutContext);
let rect={width:1200,height:800},allocations=0;
const backing=()=>{let w=0,h=0;return {get width(){return w},set width(v){w=v;allocations++},get height(){return h},set height(v){h=v;allocations++}};};
Object.assign(layout,{tier:'mid',background:backing(),overlay:backing(),expanded:true,compact:true,pointers:new Map(),backdrop:{hidden:false,classList:{toggle(){}}},host:{classList:{toggle(){},remove(){}},getBoundingClientRect:()=>rect,querySelector:()=>({setAttribute(){}}),contains:()=>false}});
layout.measure();const fullBacking=layout.background.width;
layout.setExpanded(false);
assert.equal(layout.background.width,fullBacking,'closing retains the expanded backing');
const startAllocations=allocations;
for(const size of [900,600,300]){rect={width:size,height:size*.7};layout.readViewport();assert.equal(layout.width,size);assert.equal(layout.background.width,fullBacking);}
assert.equal(allocations,startAllocations,'intermediate frames allocate no backing stores');
rect={width:190,height:190};layout.finishTransition();assert.equal(layout.background.width,190);assert.equal(layout.roundness,1);
layout.setExpanded(true);rect={width:500,height:350};layout.readViewport();layout.setExpanded(false);layout.setExpanded(true);
assert(layout.expanded&&layout.transitioning,'rapid reversal keeps latest requested state');
layoutContext.matchMedia=()=>({matches:true});rect={width:190,height:190};layout.setExpanded(false);
assert(!layout.transitioning,'reduced motion settles without an animated backing');
assert.equal(layout.background.width,190);
console.log('Festival map transition layout/backing contracts pass');

// The moving geographic layer must not repaint a full-panel dark rectangle.
const backgroundMethod=viewSource.slice(viewSource.indexOf('  drawBackground(){'),viewSource.indexOf('  drawMarkers(){'));
const backgroundCalls=[];
const clearCtx=new Proxy({}, {get:(_,key)=>(...args)=>backgroundCalls.push(key),set:()=>true});
const transparentView={background:{width:1024,height:640,getContext:()=>clearCtx},width:1200,height:800,player:{x:0,z:0},geography:{desired:[]},rasters:new Map()};
vm.runInNewContext(`({${backgroundMethod}}).drawBackground.call(view)`,{view:transparentView});
assert(backgroundCalls.includes('clearRect'));
assert(!backgroundCalls.includes('fillRect'),'full-screen dimming belongs to the independent backdrop, not the shrinking map');
console.log('Festival map independent backdrop contract passes');
// Direct pointer pin selection toggles, and empty space remains an exit on touch.
const pinMethods=viewSource.slice(viewSource.indexOf('  togglePin('),viewSource.indexOf('  suspend('));
const pinView=vm.runInNewContext(`new (class {${pinMethods}})()`,{projectPin,Math});
Object.assign(pinView,{player:{x:0,z:0},width:200,height:200,scale:1,roundness:1,markers:[{id:'stage',kind:'stage_front',label:'Stage',x:0,z:0}],overlay:{getBoundingClientRect:()=>({left:0,top:0})},expanded:true,setExpanded(on){this.expanded=on;}});
pinView.pick(100,100);assert.equal(pinView.selected,'stage');pinView.pick(100,100);assert.equal(pinView.selected,null);
pinView.pick(5,5);assert.equal(pinView.expanded,false);
// Modified map/music shortcuts must not swallow the cart's Ctrl slow mode.
const keyHandlers={};const touchFixture={state:{throttle:0,slow:false},_consumeMusic:()=>true};
const inputCode=readFileSync(new URL('../src/input.js',import.meta.url),'utf8').replace(/^import .*;$/gm,'').replace('export const Input =','const Input =');
const keyContext={window:{addEventListener:(name,fn)=>keyHandlers[name]=fn},Touch:touchFixture};
vm.runInNewContext(inputCode+'\nglobalThis.fixtureInput=Input;',keyContext);
const sendKey=(type,key,extra={})=>keyHandlers[type]({key,preventDefault(){},...extra});
sendKey('keydown','Control',{ctrlKey:true});assert(keyContext.fixtureInput.slow);
sendKey('keydown','w',{ctrlKey:true});assert.equal(keyContext.fixtureInput.throttle,1);
sendKey('keyup','w');sendKey('keyup','Control');
sendKey('keydown','m',{ctrlKey:true});assert(!keyContext.fixtureInput.consumePressed('M'));
sendKey('keydown','m');assert(keyContext.fixtureInput.consumePressed('M'));
assert(keyContext.fixtureInput.consumePressed('J'),'touch music retains its own action');
console.log('Festival map direct pin controls and Ctrl slow driving pass');
