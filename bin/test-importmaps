#!/usr/bin/env node
'use strict';

const assert = require('node:assert/strict');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { checkImportmaps } = require('./check-importmaps');

const root = fs.mkdtempSync(path.join(os.tmpdir(), 'zerble-importmaps-'));
const pages = ['index.html', 'sandbox.html', 'hub-sandbox.html', 'terrain-sandbox.html', 'map-sandbox.html'];
const modules = ['rng', 'kid', 'models/kid', 'worldgen/lint', 'people/runtime', 'people/activities/borrow'];
const files = [];
const dirs = new Set([root]);
function write(relative, content) {
  const file = path.join(root, relative);
  for (let dir = path.dirname(file); dir !== root; dir = path.dirname(dir)) dirs.add(dir);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  if (!files.includes(file)) files.push(file);
  fs.writeFileSync(file, content);
}
function html(page, entries = modules) {
  if (page === 'map-sandbox.html') return `const wg = ${JSON.stringify(entries)};`;
  const mods = entries.filter(name => !name.startsWith('models/'));
  const models = entries.filter(name => name.startsWith('models/')).map(name => name.slice(7));
  return `const mods = ${JSON.stringify(mods)}; const models = ${JSON.stringify(models)};`;
}

try {
  for (const module of modules) write(`src/${module}.js`, 'export const fixture = true;');
  write('src/people/notes.md', 'Non-module source documentation.');
  write('src/.private/ignored.js', 'Ignored private fixture.');
  for (const page of pages) write(page, html(page));
  assert.deepEqual(checkImportmaps(root), { problems: [], moduleCount: modules.length, pageCount: pages.length });

  let omissions = 0;
  for (const page of pages) {
    for (const module of modules) {
      write(page, html(page, modules.filter(name => name !== module)));
      assert.deepEqual(checkImportmaps(root).problems, [`${page}: missing '${module}'`], `${page}: ${module}`);
      omissions++;
    }
    write(page, html(page));
  }

  let stale = 0;
  for (const page of pages) {
    for (const module of ['people/removed', 'people/activities/removed', 'models/removed', 'worldgen/removed', 'removed']) {
      write(page, html(page, [...modules, module]));
      assert.deepEqual(checkImportmaps(root).problems,
        [`${page}: lists '${module}' but src/${module}.js does not exist`]);
      stale++;
    }
    write(page, html(page));
  }

  // A top-level name must not accidentally satisfy a same-named model mapping.
  write('index.html', `const mods = ${JSON.stringify(modules.filter(name => name !== 'models/kid'))};`);
  assert.deepEqual(checkImportmaps(root).problems, ["index.html: missing 'models/kid'"]);
  write('index.html', html('index.html'));

  write('index.html', html('index.html', modules.filter(name => name !== 'people/runtime'))
    .replace('const mods = [', 'const mods = [/* "people/runtime" */ // "people/runtime"\n'));
  assert.deepEqual(checkImportmaps(root).problems, ["index.html: missing 'people/runtime'"]);
  write('index.html', html('index.html'));

  write('sandbox.html', '<html>No module declaration arrays.</html>');
  assert.deepEqual(checkImportmaps(root).problems, ['sandbox.html: no mods/models/wg array found']);
  write('sandbox.html', html('sandbox.html'));
  fs.unlinkSync(path.join(root, 'terrain-sandbox.html'));
  assert.deepEqual(checkImportmaps(root).problems, ['terrain-sandbox.html: MISSING file']);
  write('terrain-sandbox.html', html('terrain-sandbox.html'));

  // Discovery must include modules added after a prior check, at arbitrary depth.
  write('src/people/activities/deep/new.js', 'export const newFixture = true;');
  assert.deepEqual(checkImportmaps(root).problems, pages.map(page => `${page}: missing 'people/activities/deep/new'`));
  for (const page of pages) write(page, html(page, [...modules, 'people/activities/deep/new']));
  assert.deepEqual(checkImportmaps(root).problems, []);
  console.log(`PASS importmap coverage: ${omissions} page/module omissions, ${stale} stale mappings, nested discovery, distinct model namespace, missing pages/arrays, and live tree changes.`);
} finally {
  // Remove only the files and directories this fixture created.
  for (const file of files) if (fs.existsSync(file)) fs.unlinkSync(file);
  for (const dir of [...dirs].sort((a, b) => b.length - a.length)) fs.rmdirSync(dir);
}
