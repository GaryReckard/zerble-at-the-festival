#!/usr/bin/env node
/*
 * bin/test-far-field — gate for src/farField.js (festival-horizon change).
 *
 * Group 1 (pure core): ownerCellCoord fixtures + a chunk-box cross-check,
 * deterministic descriptor copying off the REAL worldgen (setSeed(1234)),
 * immutability of the shared worldgen inputs FarField reads from,
 * fixed-capacity nearest selection, the versioned SnapshotPlanner's
 * boundary-only rebuild + rapid-teleport supersession, the enablement gate's
 * truth table (perf.js's resolveFarField), the reduced-motion handoff policy,
 * palette stability, and the disabled shell's zero-allocation semantics.
 *
 * Group 2 (renderer): instance expansion determinism, a real-worldgen drive
 * of the pools (fixed caps respected, deterministic contents, road buffer
 * within capacity), owner-maintained bounds ENCLOSURE after a second distant
 * rewrite, night-marker visibility gating, and owner-only disposal
 * idempotence (each geometry/material/pool disposed exactly once).
 *
 * farField.js imports `three`, so the node-three-shim resolve hook is
 * registered BEFORE any src import — everything below uses dynamic import.
 *
 * Run: node bin/test-far-field          (exit 0 = pass, 1 = fail)
 */

import { register } from 'node:module';
register('./node-three-shim.mjs', import.meta.url);

// perf.js reads `window`/`navigator` at module load (DETECTED_TIER) even
// though resolveFarField itself is pure — shim the minimal browser globals a
// plain node process lacks so the import doesn't throw.
if (typeof globalThis.window === 'undefined') globalThis.window = { innerWidth: 1024, innerHeight: 768 };
if (typeof globalThis.navigator === 'undefined') globalThis.navigator = { hardwareConcurrency: 8, deviceMemory: 8 };

const { ownerCellCoord } = await import('../src/worldgen/placement.js');
const { setSeed } = await import('../src/worldgen/index.js');
const { heartsInBounds } = await import('../src/worldgen/hearts.js');
const { festivalPlan } = await import('../src/worldgen/festival.js');
const { roadsInBounds } = await import('../src/worldgen/roads.js');
const {
  HANDOFF_ENVELOPE_S,
  ROAD_UNDERLAY_Y,
  COARSE_CELL,
  NIGHT_MARKER_THRESHOLD,
  handoffMode,
  coarseCellsFor,
  copyHeartRecords,
  copyPolyline,
  selectNearest,
  paletteIndex,
  instHash,
  expandFarInstances,
  SnapshotPlanner,
  FarField,
} = await import('../src/farField.js');

function assert(condition, message) {
  if (!condition) {
    process.stderr.write(`FAIL: ${message}\n`);
    process.exit(1);
  }
}

// ---------- A. Owner-cell fixtures (positive/negative/edge/corner) ----------

const OWNER_FIXTURES = [
  [0, 0], [39.999, 0], [-40, 0], [40, 1], [-40.0001, -1],
  [-120, -1], [119.999, 1], [120, 2], [80000, 1000],
];
for (const [v, expected] of OWNER_FIXTURES) {
  assert(ownerCellCoord(v) === expected, `ownerCellCoord(${v}) should be ${expected}, got ${ownerCellCoord(v)}`);
}
assert(Object.is(ownerCellCoord(-1), 0), 'ownerCellCoord(-1) must fold to +0, not -0 (Object.is check)');

// Corner: a 2D point sitting on both the -x edge and the +z edge, owned by
// the cell whose axes independently resolve each coordinate.
assert(ownerCellCoord(-40) === 0 && ownerCellCoord(40) === 1,
  'the corner point (x=-40, z=40) must resolve to owner cell (0, 1)');

// Cross-check against the chunk-box rule directly: for a sweep of cells and
// offsets straddling every +/-40 boundary, "this cell owns x" (by
// ownerCellCoord) must exactly agree with "x falls in this cell's box".
const BOUNDARY_OFFSETS = [-41, -40.5, -40, -39.999, -20, -0.5, 0, 0.5, 20, 39.999, 40, 40.5, 41];
for (let c = -3; c <= 3; c++) {
  for (const off of BOUNDARY_OFFSETS) {
    const x = c * 80 + off;
    const boxSaysC = x >= c * 80 - 40 && x < c * 80 + 40;
    const ownerSaysC = ownerCellCoord(x) === c;
    assert(boxSaysC === ownerSaysC,
      `chunk-box rule disagrees with ownerCellCoord at x=${x} for cell ${c} (box=${boxSaysC}, owner=${ownerSaysC})`);
  }
}

// ---------- B. Deterministic descriptor selection ----------

setSeed(1234);
const heartsSeed1234 = heartsInBounds(-1200, -1200, 1200, 1200)
  .slice()
  .sort((a, b) => a.cx - b.cx || a.cz - b.cz);
let heart = null, heartPlan = null;
for (const h of heartsSeed1234) {
  const plan = festivalPlan(h);
  if (plan.length) { heart = h; heartPlan = plan; break; }
}
assert(heart, 'seed 1234 should produce at least one heart with a non-empty festivalPlan');

const recordsA = copyHeartRecords(heart, heartPlan, 3);
const recordsB = copyHeartRecords(heart, heartPlan, 3);
assert(JSON.stringify(recordsA) === JSON.stringify(recordsB),
  'copyHeartRecords must be byte-identical across repeated calls on the same plan');

const STAGE_KINDS = new Set(['main_stage', 'tent_stage', 'side_stage']);
let stageCount = 0, vendorRowCount = 0;
for (const r of recordsA) {
  assert(Number.isFinite(r.x) && Number.isFinite(r.z) && Number.isFinite(r.yaw)
    && Number.isFinite(r.scale) && Number.isFinite(r.footprint),
    `record x/z/yaw/scale/footprint must all be finite: ${JSON.stringify(r)}`);
  assert(Number.isInteger(r.rank) && Number.isInteger(r.ownerCx) && Number.isInteger(r.ownerCz)
    && Number.isInteger(r.heartCx) && Number.isInteger(r.heartCz),
    `record rank/ownerCx/ownerCz/heartCx/heartCz must all be integers: ${JSON.stringify(r)}`);
  assert((r.clusterSeed >>> 0) === r.clusterSeed, `record clusterSeed must already be an unsigned int32: ${r.clusterSeed}`);
  assert(r.ownerCx === ownerCellCoord(r.x) && r.ownerCz === ownerCellCoord(r.z),
    `record ownerCx/ownerCz must equal ownerCellCoord(x)/ownerCellCoord(z): ${JSON.stringify(r)}`);
  if (STAGE_KINDS.has(r.kind)) stageCount++;
  else if (r.kind === 'vendor_row') vendorRowCount++;
}
assert(stageCount === 1, `copyHeartRecords should keep exactly one stage record, got ${stageCount}`);
assert(vendorRowCount <= 3, `copyHeartRecords should cap vendor rows at 3, got ${vendorRowCount}`);

// ---------- C. Immutability of shared worldgen inputs ----------

const roadsSeed1234 = roadsInBounds(-1200, -1200, 1200, 1200);
const planHashBefore = JSON.stringify(heartPlan);
const roadsHashBefore = JSON.stringify(roadsSeed1234);

const copiedRecords = copyHeartRecords(heart, heartPlan, 3);
const copiedPolylines = roadsSeed1234.map((r) => copyPolyline(r.points));
const nearestResult = selectNearest(copiedRecords, heart.x, heart.z, Math.max(1, copiedRecords.length - 1));

assert(JSON.stringify(heartPlan) === planHashBefore,
  'festivalPlan(heart) must be untouched after copyHeartRecords/selectNearest');
assert(JSON.stringify(roadsSeed1234) === roadsHashBefore,
  'roadsInBounds(...) must be untouched after copyPolyline');
assert(copiedPolylines.every((flat) => flat instanceof Float64Array),
  'copyPolyline must return a Float64Array per road');
assert(nearestResult.kept.length > 0, 'sanity: selectNearest should keep at least one record here');

// Mutating a RETURNED record must not perturb the shared plan it was copied
// from — no shared object identity leaked through.
copiedRecords[0].x = 999999;
copiedRecords[0].kind = 'mutated';
assert(JSON.stringify(heartPlan) === planHashBefore,
  'mutating a copied record must not change the shared festivalPlan hash');

// ---------- D. Fixed-capacity nearest selection ----------

const synthetic = [];
for (let i = 0; i < 10; i++) synthetic.push({ id: i, x: i, z: 0 });
const syntheticHashBefore = JSON.stringify(synthetic);
const near = selectNearest(synthetic, 0, 0, 4);
assert(near.kept.length === 4, `selectNearest cap=4 should keep 4 records, got ${near.kept.length}`);
assert(near.overflow === 6, `selectNearest cap=4 over 10 records should report overflow=6, got ${near.overflow}`);
assert(near.kept.map((r) => r.id).join(',') === '0,1,2,3',
  `selectNearest should keep the 4 nearest ids 0,1,2,3, got ${near.kept.map((r) => r.id).join(',')}`);
assert(JSON.stringify(synthetic) === syntheticHashBefore, 'selectNearest must not reorder its input array');

// Tie-break determinism: two records at identical distance (d2=25), only ONE
// of which fits under the cap — which one survives must be deterministic
// (ascending x: 'left' beats 'right') and identical across repeated runs.
const tieSet = [
  { id: 'right', x: 5, z: 0 }, { id: 'left', x: -5, z: 0 },
  { id: 'a', x: 1, z: 0 }, { id: 'b', x: 2, z: 0 }, { id: 'c', x: 3, z: 0 },
];
const tieRun1 = selectNearest(tieSet, 0, 0, 4);
const tieRun2 = selectNearest(tieSet, 0, 0, 4);
assert(JSON.stringify(tieRun1.kept.map((r) => r.id)) === JSON.stringify(tieRun2.kept.map((r) => r.id)),
  'selectNearest tie-break order must be identical across repeated runs on the same input');
const tieIds1 = tieRun1.kept.map((r) => r.id);
assert(tieIds1.includes('left') && !tieIds1.includes('right'),
  `selectNearest should tie-break equal distances by ascending x, keeping 'left' (x=-5) over 'right' (x=5); got ${tieIds1.join(',')}`);

// cap >= length: returns all, overflow 0, and a fresh copy (not the same array).
const capAll = selectNearest(synthetic, 0, 0, synthetic.length);
assert(capAll.overflow === 0, 'selectNearest with cap >= length should report overflow 0');
assert(JSON.stringify(capAll.kept) === JSON.stringify(synthetic), 'selectNearest with cap >= length should keep every record');
assert(capAll.kept !== synthetic, 'selectNearest must return a copy, never the same array reference, even when cap >= length');

// ---------- E. Boundary-only rebuild + rapid-teleport supersession ----------

// Scenario A: begin() idempotence while pending, then idempotence once committed.
{
  const plannerA = new SnapshotPlanner();
  const callsA = [];
  const planCellA = (cx, cz) => { callsA.push(`${cx},${cz}`); return [{ cx, cz, tag: 'A' }]; };
  const cellsA = [{ cx: 0, cz: 0 }];

  plannerA.begin('0,0', cellsA);
  const pendingRef1 = plannerA.pending;
  plannerA.begin('0,0', cellsA);
  assert(plannerA.pending === pendingRef1, 'begin() with the version already pending must be a no-op (same pending object)');
  assert(plannerA.superseded === 0, 'a no-op begin() must not increment superseded');

  const doneA = plannerA.step(planCellA);
  assert(doneA === true, 'step() over a single-cell pending snapshot should complete and commit on the first call');
  assert(plannerA.pending === null, 'a committed planner must clear pending');
  assert(plannerA.committed.version === '0,0', 'the committed snapshot must carry the version it was begun with');
  assert(callsA.length === 1, `planCell should be called exactly once for a single-cell plan, got ${callsA.length}`);

  plannerA.begin('0,0', cellsA);
  assert(plannerA.pending === null, 'begin() with the version already committed must be a no-op (no new pending)');
  assert(callsA.length === 1, 'begin() with the version already committed must not invoke planCell again');
}

// Scenario B: a rapid teleport mid-plan supersedes the stale pending work,
// and the discarded partial cell's records never reach committed.
{
  const plannerB = new SnapshotPlanner();
  const callsB = [];
  const planCellB = (cx, cz) => { callsB.push(`${cx},${cz}`); return [{ cx, cz, tag: 'B' }]; };
  const cellsStale = [{ cx: 0, cz: 0 }, { cx: 1, cz: 0 }]; // 2 cells so one step() leaves it partial
  const cellsFresh = [{ cx: 5, cz: 5 }];

  plannerB.begin('0,0', cellsStale);
  const partialDone = plannerB.step(planCellB); // processes only cellsStale[0]
  assert(partialDone === false, 'step() over a 2-cell plan should not complete after a single-cell step');
  assert(callsB.length === 1 && callsB[0] === '0,0', 'the partial step should have planned exactly the first stale cell');

  plannerB.begin('5,5', cellsFresh);
  assert(plannerB.superseded === 1, 'begin() with a new version while a plan is pending must increment superseded');
  assert(plannerB.pending.version === '5,5', 'begin() must replace pending with the new version');

  const doneB = plannerB.step(planCellB);
  assert(doneB === true, 'stepping the fresh snapshot to completion should commit');
  assert(plannerB.committed.version === '5,5', 'the committed snapshot must be the fresh version, not the superseded one');
  assert(plannerB.committed.records.length === 1 && plannerB.committed.records[0].cx === 5,
    'committed records must come only from the fresh plan, never the discarded stale partial');
  assert(!plannerB.committed.records.some((r) => r.tag === 'B' && r.cx === 0),
    'the stale (0,0) partial record must never appear in committed');
}

// coarseCellsFor determinism: repeat calls agree, first cell is the player's
// own cell, and the list is sorted nearest-first (non-decreasing d2).
{
  const cellsRun1 = coarseCellsFor(123.4, -56.7, 500);
  const cellsRun2 = coarseCellsFor(123.4, -56.7, 500);
  assert(JSON.stringify(cellsRun1) === JSON.stringify(cellsRun2), 'coarseCellsFor must be deterministic across repeated calls');
  assert(cellsRun1[0].cx === ownerCellCoord(123.4, COARSE_CELL) && cellsRun1[0].cz === ownerCellCoord(-56.7, COARSE_CELL),
    'coarseCellsFor\'s first cell must be the player\'s own coarse cell');
  for (let i = 1; i < cellsRun1.length; i++) {
    assert(cellsRun1[i].d2 >= cellsRun1[i - 1].d2, 'coarseCellsFor must be sorted nearest-first (non-decreasing d2)');
  }
}

// ---------- F. Zero-allocation no-op + resolveFarField truth table ----------

const noop = new FarField({ enabled: false });
assert(Object.keys(noop).sort().join(',') === 'disposed,enabled',
  `a disabled FarField must have exactly the own keys enabled+disposed, got ${Object.keys(noop).sort().join(',')}`);
noop.update();
noop.dispose();
noop.dispose();
assert(noop.disposed === false,
  'dispose() on a disabled FarField bails before setting disposed (it never toggles true for a no-op instance)');

const { resolveFarField } = await import('../src/perf.js');

const TRUTH_TABLE = [
  ['', true, true],            // promoted default (2026-08-28): on with v2 worldgen
  ['', false, false],          // ...but still killed by ?worldgen=0
  ['?farField=1', true, true],
  ['?farField=1', false, false],
  ['?farField=0', true, false],
  ['?farField=0', false, false],
  [null, true, true],
  [undefined, true, true],
];
for (const [search, useWorldgenV2, expected] of TRUTH_TABLE) {
  const got = resolveFarField(search, useWorldgenV2);
  assert(got === expected, `resolveFarField(${JSON.stringify(search)}, ${useWorldgenV2}) should be ${expected}, got ${got}`);
}

const gatedNoop = new FarField({ enabled: resolveFarField('?farField=1', false) });
assert(Object.keys(gatedNoop).sort().join(',') === 'disposed,enabled',
  'FarField gated by a false resolveFarField (worldgen=0 kill) must produce the no-op shape');

// ---------- G. Reduced-motion handoff policy ----------

assert(handoffMode(true) === 'snap', 'reduced motion must select the snap handoff');
assert(handoffMode(false) === 'envelope', 'normal motion must select the envelope handoff');
assert(HANDOFF_ENVELOPE_S === 0.3, `HANDOFF_ENVELOPE_S should be 0.3, got ${HANDOFF_ENVELOPE_S}`);
assert(ROAD_UNDERLAY_Y > 0 && ROAD_UNDERLAY_Y < 0.06,
  `ROAD_UNDERLAY_Y must sit strictly between the ground (0) and the road ribbon (0.06), got ${ROAD_UNDERLAY_Y}`);

// ---------- H. Palette stability ----------

const paletteRecord = { clusterSeed: 3521908037, rank: 4 };
const idx1 = paletteIndex(paletteRecord, 6);
const idx2 = paletteIndex(paletteRecord, 6);
assert(Number.isInteger(idx1) && idx1 >= 0 && idx1 < 6, `paletteIndex must return an integer in [0,6), got ${idx1}`);
assert(idx1 === idx2, 'paletteIndex must be identical across repeated calls on the same record');
const paletteRecordCopy = JSON.parse(JSON.stringify(paletteRecord));
assert(paletteIndex(paletteRecordCopy, 6) === idx1, 'paletteIndex must agree for a structurally-identical copied record');

// instHash: pure integer mapping in [0,1), stable, index-sensitive.
assert(instHash(12345, 0) === instHash(12345, 0), 'instHash must be stable for the same (seed, i)');
assert(instHash(12345, 0) !== instHash(12345, 1), 'instHash must vary with the index');
for (let i = 0; i < 32; i++) {
  const h = instHash(3521908037, i);
  assert(h >= 0 && h < 1, `instHash must stay in [0,1), got ${h}`);
}

// ---------- I. Instance expansion (pure, group 2) ----------

const EXPAND_FIXTURE = [
  { kind: 'main_stage', x: 100, z: -60, yaw: 0.7, scale: 1.2, footprint: 11, rank: 1, clusterSeed: 987654321, ownerCx: 1, ownerCz: -1 },
  { kind: 'vendor_row', x: 130, z: -40, yaw: 1.9, scale: 1.0, footprint: 12, rank: 0, clusterSeed: 123456789, ownerCx: 2, ownerCz: 0 },
  { kind: '__road', flat: new Float64Array([0, 0, 50, 0, 100, 20]) },
];
const exp1 = expandFarInstances(EXPAND_FIXTURE, 1);
const exp2 = expandFarInstances(EXPAND_FIXTURE, 1);
assert(JSON.stringify(exp1.canopy) === JSON.stringify(exp2.canopy)
  && JSON.stringify(exp1.peak) === JSON.stringify(exp2.peak)
  && JSON.stringify(exp1.warm) === JSON.stringify(exp2.warm),
  'expandFarInstances must be byte-identical across repeated calls');
assert(exp1.canopy.length === 1, `one stage should expand to one canopy, got ${exp1.canopy.length}`);
assert(exp1.truss.length === 3, `one stage should expand to two posts + one beam, got ${exp1.truss.length}`);
assert(exp1.beacon.length === 1, `one stage should expand to one beacon, got ${exp1.beacon.length}`);
assert(exp1.peak.length === 4, `a footprint-12 vendor row at density 1 should expand to 4 peaks, got ${exp1.peak.length}`);
assert(exp1.warm.length === 2, `4 peaks should carry 2 warm markers (every other peak), got ${exp1.warm.length}`);
assert(exp1.roads.length === 1 && exp1.roads[0] instanceof Float64Array,
  'road records must pass through as flat polylines');
for (const name of ['canopy', 'truss', 'peak', 'warm', 'beacon']) {
  for (const inst of exp1[name]) {
    const rec = name === 'peak' || name === 'warm' ? EXPAND_FIXTURE[1] : EXPAND_FIXTURE[0];
    assert(inst.ownerCx === rec.ownerCx && inst.ownerCz === rec.ownerCz,
      `${name} instances must inherit the OWNING RECORD's chunk cell (cluster-level handoff)`);
    assert([inst.x, inst.y, inst.z, inst.sx, inst.sy, inst.sz].every(Number.isFinite),
      `${name} instance transform fields must be finite: ${JSON.stringify(inst)}`);
  }
}
// Density thins supporting silhouettes (peaks), never the stage anchor.
const expThin = expandFarInstances(EXPAND_FIXTURE, 0.6);
assert(expThin.canopy.length === 1, 'densityMul must never drop the stage canopy anchor');
assert(expThin.peak.length < exp1.peak.length, 'densityMul < 1 should thin the vendor-row peaks');

// ---------- J. Renderer drive on real worldgen (group 2) ----------

const TEST_TIER = {
  radius: 300,
  densityMul: 1,
  caps: { canopy: 8, truss: 24, peak: 40, warm: 24, beacon: 8, roadVerts: 512, roadIndices: 768 },
};
const POOL_NAMES = ['canopy', 'truss', 'peak', 'warm', 'beacon'];

// Immutability hashes of the shared inputs the drive will consume.
const driveHearts = heartsInBounds(-600, -600, 600, 600);
const drivePlansBefore = JSON.stringify(driveHearts.map((h) => festivalPlan(h)));
const driveRoadsBefore = JSON.stringify(roadsInBounds(-600, -600, 600, 600));

const ff = new FarField({ enabled: true, tier: TEST_TIER });
assert(ff.planner instanceof SnapshotPlanner, 'an enabled FarField must construct a SnapshotPlanner');
assert(JSON.stringify(ff.stats) === JSON.stringify({
  active: 0, overflow: 0, rebuilds: 0, superseded: 0,
  roadVertsUsed: 0, roadsClipped: 0, maxColdStepMs: 0, handoffs: 0,
}), 'an enabled FarField must start with a zeroed stats object');
for (const name of POOL_NAMES) {
  assert(ff._pools[name].mesh.count === 0 && ff._pools[name].mesh.visible === false,
    `pool ${name} must start empty and hidden`);
  assert(ff._pools[name].mesh.frustumCulled === false,
    `pool ${name} must deliberately disable per-batch frustum culling (design D2 alternative)`);
}

ff.update(0, 0, { budgetMs: 60000 });
assert(ff.stats.rebuilds === 1, `first update at a fresh cell should plan + commit one rebuild, got ${ff.stats.rebuilds}`);
assert(ff.stats.active > 0, 'seed 1234 around the origin should produce at least one far-field instance');
assert(ff.stats.roadVertsUsed > 0, 'seed 1234 around the origin should produce road underlay geometry');

// Steady state: same cell, no pending plan → no further rebuilds.
ff.update(1, 1, { budgetMs: 60000 });
assert(ff.stats.rebuilds === 1, 'an update within the same player cell must not rebuild');

const checkPools = (label, anchorX, anchorZ) => {
  for (const name of POOL_NAMES) {
    const pool = ff._pools[name];
    const kept = ff._active[name];
    assert(pool.mesh.count === kept.length, `${label}: pool ${name} count must match its kept set`);
    assert(kept.length <= TEST_TIER.caps[name], `${label}: pool ${name} must respect its cap`);
    if (kept.length === 0) continue;
    assert(pool.mesh.instanceMatrix.needsUpdate === true, `${label}: pool ${name} must flip instanceMatrix.needsUpdate`);
    const bs = pool.mesh.boundingSphere;
    for (const inst of kept) {
      const dx = inst.x - bs.center.x, dy = inst.y - bs.center.y, dz = inst.z - bs.center.z;
      assert(Math.sqrt(dx * dx + dy * dy + dz * dz) <= bs.radius + 1e-6,
        `${label}: pool ${name} bounding sphere must enclose every kept instance`);
    }
    const cdx = bs.center.x - anchorX, cdz = bs.center.z - anchorZ;
    assert(Math.hypot(cdx, cdz) < TEST_TIER.radius + 4 * COARSE_CELL,
      `${label}: pool ${name} bounds center must track the plan anchor (stale-bounds guard)`);
  }
  // Road buffer: draw range within caps, active verts enclosed by the sphere.
  const road = ff._road;
  assert(road.geo.drawRange.count <= TEST_TIER.caps.roadIndices, `${label}: road draw range must respect the index cap`);
  assert(ff.stats.roadVertsUsed <= TEST_TIER.caps.roadVerts, `${label}: road verts must respect the vertex cap`);
  const rs = road.geo.boundingSphere;
  for (let i = 0; i < ff.stats.roadVertsUsed; i++) {
    const x = road.posAttr.array[i * 3], z = road.posAttr.array[i * 3 + 2];
    assert(Math.hypot(x - rs.center.x, z - rs.center.z) <= rs.radius + 1e-6,
      `${label}: road bounding sphere must enclose every active vertex`);
  }
};
checkPools('first rewrite', 0, 0);

// Shared worldgen inputs untouched by the whole drive.
assert(JSON.stringify(driveHearts.map((h) => festivalPlan(h))) === drivePlansBefore,
  'driving FarField must not mutate any memoized festivalPlan array');
assert(JSON.stringify(roadsInBounds(-600, -600, 600, 600)) === driveRoadsBefore,
  'driving FarField must not mutate cached road polylines');

// Determinism: a second instance planned at the same cell commits identical
// pool contents (records AND kept order), byte-for-byte.
const ff2 = new FarField({ enabled: true, tier: TEST_TIER });
ff2.update(0, 0, { budgetMs: 60000 });
for (const name of POOL_NAMES) {
  assert(JSON.stringify(ff2._active[name]) === JSON.stringify(ff._active[name]),
    `pool ${name} contents must be byte-identical across independent instances at the same player cell`);
}
ff2.dispose();

// Second DISTANT rewrite (the deferred 1.2 bounds-enclosure case): teleport
// ~2.4km away, replan, and require the owner-maintained bounds to have moved
// with the instances — the exact stale-bounds failure three r160 would
// otherwise hide until a specific camera angle.
ff.update(2400, 2400, { budgetMs: 60000 });
assert(ff.stats.rebuilds === 2, `a distant teleport must trigger a second rebuild, got ${ff.stats.rebuilds}`);
checkPools('distant rewrite', 2400, 2400);

// Night-marker gating (task 2.4): hidden by day, shown at night iff populated.
ff.update(2400, 2400, { nightness: 0 });
for (const name of ['warm', 'beacon']) {
  assert(ff._pools[name].mesh.visible === false, `${name} markers must be hidden at nightness 0`);
}
ff.update(2400, 2400, { nightness: 0.8 });
for (const name of ['warm', 'beacon']) {
  const pool = ff._pools[name];
  assert(pool.mesh.visible === (pool.mesh.count > 0),
    `${name} markers at nightness 0.8 must be visible exactly when populated`);
}
assert(NIGHT_MARKER_THRESHOLD > 0 && NIGHT_MARKER_THRESHOLD < 1, 'night threshold sanity');

// ---------- K2. Completion handoff + shared budget + dither (group 3) ----------

{
  const loadedCells = new Set();
  const ff3 = new FarField({
    enabled: true, tier: TEST_TIER,
    isLoaded: (cx, cz) => loadedCells.has(cx + ',' + cz),
  });

  // Static shader test (design D4 risk "onBeforeCompile drift"): the five
  // proxy materials inject aFade/vFade/Bayer discard through documented
  // chunks under ONE stable cache key; the road underlay stays clean.
  for (const name of POOL_NAMES) {
    const mat = ff3._mats[name];
    assert(typeof mat.onBeforeCompile === 'function' && typeof mat.customProgramCacheKey === 'function',
      `${name} material must carry the dither injection + a stable cache key`);
    assert(mat.customProgramCacheKey() === ff3._mats.canopy.customProgramCacheKey(),
      'all proxy materials must share one program cache key');
    const shader = {
      vertexShader: 'void main() {\n#include <begin_vertex>\n}',
      fragmentShader: 'void main() {\n#include <clipping_planes_fragment>\n}',
    };
    mat.onBeforeCompile(shader);
    assert(shader.vertexShader.includes('attribute float aFade') && shader.vertexShader.includes('vFade = aFade'),
      `${name} vertex shader must wire the per-instance fade attribute`);
    assert(shader.fragmentShader.includes('ffBayer') && shader.fragmentShader.includes('discard'),
      `${name} fragment shader must carry the Bayer screen-door discard`);
    assert(!shader.fragmentShader.includes('transparent'), 'the dither path must not introduce transparency');
    assert(ff3._geos[name].attributes.aFade.array.length === TEST_TIER.caps[name],
      `${name} fade attribute must be sized to the pool cap`);
  }
  assert(ff3._mats.road.onBeforeCompile === undefined,
    'the road underlay material must NOT get the dither (real road covers it by Δy alone)');

  // First plan with nothing loaded: every fade snaps to 1 (proxy shown).
  ff3.update(0, 0, { budgetMs: 60000 });
  assert(ff3.stats.rebuilds === 1, 'handoff instance: first plan should commit');
  const pool3 = ff3._pools.canopy;
  assert(ff3._active.canopy.length > 0, 'handoff test needs at least one canopy instance');
  for (let i = 0; i < ff3._active.canopy.length; i++) {
    assert(pool3.fade.array[i] === 1, 'with nothing loaded, initial fades must snap to 1 (no envelope)');
  }

  // Shared-deadline contract (design D3): a zero remainder plans NOTHING.
  ff3.update(2400, 2400, { budgetMs: 0 });
  assert(ff3.stats.rebuilds === 1 && ff3.planner.pending !== null,
    'a zero streaming remainder must leave the pending plan untouched (no second wall)');
  ff3.update(2400, 2400, { budgetMs: 60000 });
  assert(ff3.stats.rebuilds === 2, 'the next frame with remainder should finish the plan');

  // Owner chunk completes → 0.3s envelope dissolves the whole cluster.
  const inst = ff3._active.canopy[0];
  loadedCells.add(inst.ownerCx + ',' + inst.ownerCz);
  ff3.update(2400, 2400, { dt: 0.1 });
  const mid = pool3.fade.array[0];
  assert(mid > 0 && mid < 1, `a loaded owner cell must start a dissolve envelope, got fade ${mid}`);
  assert(ff3.stats.handoffs === 1, 'the ownership flip must count one handoff');
  ff3.update(2400, 2400, { dt: 0.1 });
  ff3.update(2400, 2400, { dt: 0.15 });
  assert(pool3.fade.array[0] === 0, `the envelope must reach 0 within ~0.3s, got ${pool3.fade.array[0]}`);
  assert(ff3._handoffs.length === 0, 'completed envelopes must leave the active list');

  // Steady state: no ownership change → no envelope work, fades stable.
  ff3.update(2400, 2400, { dt: 0.1 });
  assert(pool3.fade.array[0] === 0 && ff3._handoffs.length === 0, 'steady state must not restart handoffs');

  // Chunk unloads → proxy reappears; reduced motion (read live) snaps it.
  loadedCells.delete(inst.ownerCx + ',' + inst.ownerCz);
  ff3.update(2400, 2400, { dt: 0.016, reducedMotion: true });
  assert(pool3.fade.array[0] === 1, 'reduced motion must snap the reappearing proxy to fade 1 immediately');
  assert(ff3._handoffs.length === 0, 'a snap must not leave an active envelope behind');

  ff3.dispose();
}

// ---------- K3. Off-on identity, resource plateaus, contracts (group 4) ----------

{
  const { registry } = await import('../src/registry.js');
  const registryBefore = registry.entries.size;

  // Long-travel plateau: 12 successive coarse-cell crossings, each a full
  // replan on real worldgen. Fixed pools must be REWRITTEN, never replaced —
  // same mesh/attribute/array references throughout, zero disposals, counts
  // always within caps.
  const ff4 = new FarField({ enabled: true, tier: TEST_TIER });
  const meshRefs0 = POOL_NAMES.map((n) => ff4._pools[n].mesh);
  const fadeArr0 = POOL_NAMES.map((n) => ff4._pools[n].fade.array);
  const roadArr0 = ff4._road.posAttr.array;
  for (let stepI = 0; stepI < 12; stepI++) {
    ff4.update(stepI * 240, 0, { budgetMs: 60000 });
    for (let p = 0; p < POOL_NAMES.length; p++) {
      const pool = ff4._pools[POOL_NAMES[p]];
      assert(pool.mesh === meshRefs0[p], 'travel must never replace a pool mesh');
      assert(pool.fade.array === fadeArr0[p], 'travel must never reallocate a fade buffer');
      assert(pool.mesh.count <= TEST_TIER.caps[POOL_NAMES[p]], 'travel must keep every pool within its cap');
      assert(pool.mesh.geometry.disposeCount === 0, 'travel must never dispose pool geometry');
    }
    assert(ff4._road.posAttr.array === roadArr0, 'travel must never reallocate the road vertex buffer');
    assert(ff4.stats.roadVertsUsed <= TEST_TIER.caps.roadVerts, 'travel must keep the road buffer within cap');
  }
  assert(ff4.stats.rebuilds === 12, `12 coarse crossings should commit 12 rebuilds, got ${ff4.stats.rebuilds}`);

  // Registry/worldgen off-on identity: the drive owns no registry entries and
  // leaves the shared worldgen caches byte-identical (hashes checked above).
  assert(registry.entries.size === registryBefore,
    'FarField must never add or remove a registry entry');

  // Deterministic forcing controls (4.2): overrides snap, live returns to the
  // predicate, forceReplan replans byte-identically at the same cell.
  ff4.setOwnershipOverride('real');
  for (const name of POOL_NAMES) {
    for (let i = 0; i < ff4._pools[name].mesh.count; i++) {
      assert(ff4._pools[name].fade.array[i] === 0, `override 'real' must snap every ${name} fade to 0`);
    }
  }
  ff4.setOwnershipOverride('proxy');
  for (const name of POOL_NAMES) {
    for (let i = 0; i < ff4._pools[name].mesh.count; i++) {
      assert(ff4._pools[name].fade.array[i] === 1, `override 'proxy' must snap every ${name} fade to 1`);
    }
  }
  const activeBefore = JSON.stringify(ff4._active);
  ff4.forceReplan();
  ff4.update(11 * 240, 0, { budgetMs: 60000 });
  assert(ff4.stats.rebuilds === 13, 'forceReplan must trigger exactly one fresh rebuild at the same cell');
  assert(JSON.stringify(ff4._active) === activeBefore,
    'a forced replan at the same player cell must commit byte-identical pool contents');

  // Material invariants: opaque + depth-writing everywhere (no transparent
  // sort), the road underlay never loses depthWrite.
  for (const name of [...POOL_NAMES, 'road']) {
    const mat = ff4._mats[name];
    assert(mat.transparent !== true, `${name} material must stay opaque (no transparent sort)`);
    assert(mat.depthWrite !== false, `${name} material must keep depthWrite`);
  }
  ff4.dispose();

  // No-builder / no-light / no-shadow contract, enforced at the SOURCE level
  // (the node three-shim exports no Light classes, so a light would also fail
  // at import — this pins the contract even if the stub grows).
  const { readFile } = await import('node:fs/promises');
  const src = await readFile(new URL('../src/farField.js', import.meta.url), 'utf8');
  assert(!/from '\.\/chunks\.js'/.test(src), 'farField.js must never import chunks.js (no real builders)');
  assert(!/from '\.\/models\//.test(src), 'farField.js must never import a model builder');
  assert(!/\b(Point|Spot|Directional|Hemisphere|Rect(Area)?)Light\b/.test(src), 'farField.js must construct no Light objects');
  assert(!/castShadow\s*=\s*true/.test(src), 'farField.js must never enable a shadow caster');
  assert(!/MeshStandardMaterial|MeshLambertMaterial|MeshPhongMaterial|MeshPhysicalMaterial/.test(src),
    'farField.js materials must stay unlit (MeshBasicMaterial only)');
  assert(!/registry/i.test(src.replace(/\/\/[^\n]*/g, '')), 'farField.js must not touch the registry');
}

// ---------- K. Owner-only disposal idempotence (group 2) ----------

const geoRefs = Object.values(ff._geos).concat([ff._road.geo]);
const matRefs = Object.values(ff._mats);
const meshRefs = POOL_NAMES.map((n) => ff._pools[n].mesh);
ff.dispose();
assert(ff.disposed === true, 'dispose() on an enabled FarField must set disposed = true');
assert(ff.planner === null, 'dispose() on an enabled FarField must null out the planner');
for (const g of geoRefs) assert(g.disposeCount === 1, 'each owned geometry must be disposed exactly once');
for (const m of matRefs) assert(m.disposeCount === 1, 'each owned material must be disposed exactly once');
for (const im of meshRefs) assert(im.disposeCount === 1, 'each owned InstancedMesh must be disposed exactly once');
ff.dispose(); // second call must be a safe no-op
for (const g of geoRefs) assert(g.disposeCount === 1, 'a second dispose() must not re-dispose geometries');
for (const m of matRefs) assert(m.disposeCount === 1, 'a second dispose() must not re-dispose materials');
ff.update(0, 0); // must not throw after dispose

process.stdout.write(
  'PASS  far-field owner-cell fixtures, deterministic descriptor copying, worldgen-input immutability, ' +
  'fixed-capacity nearest selection, snapshot-planner supersession, the enablement truth table, ' +
  'handoff policy, palette + instHash stability, instance expansion, the real-worldgen pool drive ' +
  '(caps, determinism, bounds enclosure after a distant rewrite, night gating), the completion ' +
  'handoff (dither wiring, snap-then-envelope, shared-deadline remainder, reduced-motion snap, ' +
  'unload reappearance), long-travel resource plateaus + registry off-on identity + forcing ' +
  'controls + the no-builder/no-light/no-shadow source contract, and owner-only disposal idempotence\n'
);
