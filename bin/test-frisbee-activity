#!/usr/bin/env node
import assert from 'node:assert/strict';
import {register} from 'node:module';
import * as actualThree from 'three';
import {makePeopleCrowd,Vector} from './test-support/peopleCrowd.js';
import {PeopleRuntime} from '../src/people/runtime.js';
globalThis.window={innerWidth:1280,innerHeight:720};
register('./node-three-shim.mjs',import.meta.url);
// Addon imports use complete real Three math/buffers, while this ownership
// fixture retains recording scene nodes. This is a CPU module-boundary check.
const recordingThree=await import('three');
const {mergeGeometries}=await import('three/addons/utils/BufferGeometryUtils.js');
assert.notEqual(recordingThree.Vector3,actualThree.Vector3);
const partA=new actualThree.BoxGeometry(),partB=new actualThree.BoxGeometry(),merged=mergeGeometries([partA,partB]);
assert(merged instanceof actualThree.BufferGeometry);
assert.equal(merged.attributes.position.count,partA.attributes.position.count+partB.attributes.position.count);
assert.equal(merged.index.count,partA.index.count+partB.index.count);
partA.dispose();partB.dispose();merged.dispose();

const {FrisbeeActivity}=await import('../src/people/frisbeeActivity.js');
const crowd=makePeopleCrowd(),a=crowd.spawnPerson({pos:new Vector(0,0,0)}),b=crowd.spawnPerson({pos:new Vector(10,0,0)});
for(const n of crowd.npcs)n.scale=1;
const previousRandom=Math.random;let randomDraws=0;Math.random=()=>{randomDraws++;return .5;};
const runtime=new PeopleRuntime(),activity=new FrisbeeActivity({people:crowd,runtime}),cart={position:new Vector(0,0,40),forwardWorld:{x:0,z:1},speed:0},frame={zerble:cart,nightness:0};
function tick(){runtime.beginFrame(.05);runtime.run('roaming',frame);}
tick();const slot=activity.slots.find(p=>p.session.phase==='playing');assert(slot,'two eligible Crowd adults form an open-ground session');
const initialHand=new Vector();assert(crowd.readActivityHand(slot.session.claims[slot.holder],initialHand));assert.equal(slot.disc.position.x,initialHand.x);assert.equal(slot.disc.position.y,initialHand.y);assert.equal(slot.disc.position.z,initialHand.z);
for(let i=0;i<100&&slot.session.discState!=='flying';i++)tick();assert.equal(slot.session.discState,'flying');
assert(crowd.npcs.every(n=>n._activityArmPose),'both existing players use articulated poses');const claims=[...slot.session.claims];crowd._abandonSeat=()=>true;const n=crowd.peopleHandles.resolve(a);cart.position.set(n.pos.x,0,n.pos.z-8);cart.speed=12;
assert(crowd._interruptActivityForCart(n,cart));assert.equal(slot.session.phase,'interrupted');assert(crowd.npcs.every(n=>!n._activityArmPose),'interruption clears both articulated bindings');assert(claims.every(c=>!crowd.writeActivityArmPose(c,'throw',.5)));assert.equal(slot.session.discState,'landed');assert(claims.every(c=>!crowd.writeActivityPose(c,99,0,99)));
activity.dispose();assert(crowd.readPerson(a,{})&&crowd.readPerson(b,{}));assert.equal(crowd.activityClaims.current.size,0);runtime.dispose();
console.log('PASS production frisbee manager: explicit paired selection, real disc flight, coordinated interruption and teardown.');
