#!/usr/bin/env node
import assert from 'node:assert/strict';
import {makeWagonRoute, sampleWagonRoute, wagonRoutes, NUT_WAGON_TUNING as T, wagonOverlapsCircle, wagonTouchesWater} from '../src/nutWagonRoute.js';
const route = makeWagonRoute([{x:0,z:0},{x:0,z:0},{x:0,z:30},{x:40,z:30}]);
assert.equal(route.length,70);
assert.deepEqual(sampleWagonRoute(route,50,{}),{x:20,z:30,heading:Math.PI/2});
assert.equal(sampleWagonRoute(route,-5,{}).z,0);
assert.equal(sampleWagonRoute(route,500,{}).x,40);
const split = wagonRoutes([[{x:-60,z:0},{x:60,z:0}]],{x:0,z:0},x=>Math.abs(x)>5);
assert.equal(split.length,2);
assert(split.every(r=>r.points.every(p=>Math.abs(p.x)>5)));
assert.equal(wagonRoutes([[{x:0,z:0},{x:20,z:0}]],{x:0,z:0},()=>true).length,0);
assert.equal(wagonRoutes([[{x:0,z:0},{x:100,z:0}]],{x:0,z:0},()=>false).length,0);
assert.equal(T.tripChance/T.normalChance,10);
assert(T.speed<1 && T.stopSeconds>7);
console.log('Nut Wagon: route interpolation, dense obstacle splitting, short/blocked rejection, 10× trip chance passed');

assert(wagonOverlapsCircle(0,0,0,0,5,1), 'front platform overlaps the reviewer’s formerly accepted prop');
assert(wagonOverlapsCircle(0,0,Math.PI/2,5,0,1), 'footprint rotates with heading');
assert(wagonOverlapsCircle(0,0,0,0,-4.6,.2), 'open hatch is included');
assert(!wagonOverlapsCircle(0,0,0,4,0,.5), 'clear roadside space is not falsely blocked');
assert(wagonTouchesWater(0,0,0,(x,z)=>x<-.5 && z>4.5), 'water under platform is sampled');
assert(wagonTouchesWater(0,0,0,(x,z)=>x>1.3 && z>3), 'diagonal body corner is sampled');
assert(!wagonTouchesWater(0,0,0,()=>false));
console.log('Nut Wagon: full rotated footprint covers front platform, hatch and shoreline corners');

assert(!wagonOverlapsCircle(0,0,0,3.5,0,.5));
assert(wagonOverlapsCircle(0,0,Math.PI/2,3.5,0,.5), 'a safe forward corridor need not allow a U-turn');
