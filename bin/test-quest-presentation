#!/usr/bin/env node
// Real map and presentation lifecycle with DOM/render boundaries stubbed.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import vm from 'node:vm';
import { pathToFileURL } from 'node:url';
const base=path.resolve(new URL('..', import.meta.url).pathname);
const read=p=>fs.readFileSync(path.join(base,p),'utf8');
const sourceImport=p=>import(pathToFileURL(path.join(base,p)).href);
const el=()=>({children:[],listeners:{},dataset:{},classList:{toggle(){},add(){},remove(){},contains(){return false}},style:{setProperty(){}},append(...nodes){for(const node of nodes){node.parentElement=this;this.children.push(node)}},setAttribute(k,v){this[k]=v},remove(){if(this.parentElement?.children)this.parentElement.children=this.parentElement.children.filter(node=>node!==this)},addEventListener(type,fn){this.listeners[type]=fn},removeEventListener(type,fn){if(this.listeners[type]===fn)delete this.listeners[type]}});

// Evaluate the complete unmodified class bodies, avoiding CSS/Three.js imports.
// The constructors are bypassed; only DOM, drawing, discovery and geography
// boundaries are supplied. Selection and lifecycle logic are the real methods.
const model=await sourceImport('src/festivalMap/model.js');
let now=1000;
const env={...model,Math,Map,performance:{now:()=>now},document:{body:el()},textDistance:n=>`${Math.round(n)} m`};
const mapSource=read('src/festivalMap/view.js');
const FestivalMap=vm.runInNewContext('('+mapSource.slice(mapSource.indexOf('export class FestivalMap')).replace('export class','class')+')',env);
const presentationSource=read('src/quests/presentation.js');
const QuestPresentation=vm.runInNewContext('('+presentationSource.slice(presentationSource.indexOf('export class QuestPresentation')).replace('export class','class')+')',{Math});
const map=Object.assign(Object.create(FestivalMap.prototype),{
  objectives:new Map(),compact:false,expanded:false,touchLayout:false,
  backdrop:{hidden:true},host:{hidden:true},player:{x:0,z:0},width:190,height:190,zoom:1,
  discovery:{previous:true,token:1,storageOK:true,reveal(){},flush(){},loadBounds(){},landmarks(){return []}},
  geography:{status:'ready',suspend(){},request(){}},rasters:new Map(),stats:{},samples:[],sampleIndex:0,
  selectionText:{textContent:''},statusText:{textContent:''},drawBackground(){},drawMarkers(){},updatePinOptions(){},
});
const tick=()=>{now+=250;map.tick({player:{x:0,z:0},dt:.016});};
map.setObjectives([{id:'quest:1',x:100,z:0,label:'Old ride'}]);
map.track('quest:1');
map.selectedMarker={...map.objectives.get('quest:1')};
map.setObjectives([]); // Completion emits dirty pins, which presentation removes.
tick();
assert.equal(map.selected,null,'removed objective clears even while hidden');
const view=Object.assign(Object.create(QuestPresentation.prototype),{
  time:0,runtime:{active:[{id:2,type:'summit',riderId:'rider',x:900,z:0,short:'Mountaintop'}],hails:[]},
  reducedMotion:()=>false,crowd:{riderInfo:()=>false},compass:null,festivalMap:map,
  _pinsDirty:true,_track:'quest:2',_rider:{},
});
view.update(.016);
assert.equal(map.selected,'quest:2');
assert.equal(view._track,null);
assert.equal(map.objectives.has('quest:2'),true);
tick();
assert.equal(map.selected,'quest:2');
map.compact=true; // Reopen the compact map and run its entire real tick method.
tick();
assert.equal(map.selected,'quest:2','visible tick preserves the new summit');
view.update(.016);tick();
assert.equal(map.selected,'quest:2','summit remains tracked');
map.track('known-landmark');map.setObjectives([]);assert.equal(map.selected,'known-landmark');
map.setObjectives([{id:'quest:3',x:5,z:5}]);map.track('quest:3');map.setObjectives([{id:'quest:3',x:6,z:6}]);assert.equal(map.selected,'quest:3');
view.runtime.active[0].arrivalTarget={x:20,z:30,radius:10};
view.update(.016);
assert.equal(map.objectives.get('quest:2').x,20);
assert.equal(map.objectives.get('quest:2').z,30);
console.log('PASS: real map reconciliation preserves valid targets and tracks summit after hidden objective removal; alternate pin updates.');

const {QuestCompass}=await sourceImport('src/questHud.js');
globalThis.document={createElement:el,createElementNS:el};
const root=el();let picked=null;
const compass=new QuestCompass(root,{onPick(id){picked=id}});
assert.equal(root.children[0].textContent,'Passenger rides');
let stopped=false;
root.listeners.keydown({key:' ',target:{closest:()=>true},stopPropagation(){stopped=true}});
assert.equal(stopped,true,'Space preserves native button activation without honking');
root.listeners.click({target:{closest:()=>({dataset:{quest:'7'}})}});
assert.equal(picked,7);
const q={id:1,x:0,z:100,dist:100,radius:25,short:'Main stage',warmth:0,type:'ride'};
const sync=heading=>{compass.sync([q],{x:0,z:0,heading,speed:0});return compass.chips.get(1).shown;};
let last=sync(.1),max=0;
for(let i=1;i<=4000;i++){const next=sync(.1+i*.05);max=Math.max(max,Math.abs(next-last));last=next;}
assert(max<=6);
assert.match(compass.chips.get(1).el['aria-label'], /Main stage: (Ahead|Right|Behind|Left), 75 m/);
compass.sync([],{x:0,z:0});assert.equal(compass.chips.size,0);
compass.sync([q],{x:0,z:0});
compass.dispose();
assert.equal(root.listeners.click,undefined,'disposed compass releases its map tracking listener');
assert.equal(root.listeners.keydown,undefined,'disposed compass releases its keyboard listener');
assert.equal(root.children.length,0,'disposed compass removes only its owned DOM');
assert.equal(compass.chips.size,0);
const replacementCompass=new QuestCompass(root,{onPick(id){picked=id+1}});
replacementCompass.sync([q],{x:0,z:0});
assert.equal(root.children.length,3,'remount has one heading, help and card container');
root.listeners.click({target:{closest:()=>({dataset:{quest:'7'}})}});
assert.equal(picked,8,'remount uses the replacement tracking callback');
replacementCompass.dispose();
console.log(`PASS: actual QuestCompass, 4000 bearings, maximum turn ${max} degrees, label and cleanup.`);

const hudSource=read('src/hud.js');
const method=hudSource.slice(hudSource.indexOf('  toast(msg,'),hudSource.indexOf('\n  flashHit()'));
let time=0,id=0;const pending=new Map(),toast=el();
const context={performance:{now:()=>time},toastUntil:0,toastLow:false,toastTimer:0,toastTapHandler:null,$toast:toast,clearToastTap(){},setTimeout(fn){pending.set(++id,fn);return id},clearTimeout(i){pending.delete(i)}};
const hud=vm.runInNewContext('({'+method+'})',context);
hud.toast('warning',1000);time=100;hud.toast('chatter',3000,{low:true});
assert.equal(toast.textContent,'warning');assert.equal(pending.size,1);
time=1000;hud.toast('chatter',3000,{low:true});assert.equal(toast.textContent,'chatter');assert.equal(pending.size,1);
hud.toast('new warning',1000);assert.equal(toast.textContent,'new warning');assert.equal(pending.size,1);
console.log('PASS: actual HUD.toast priority, expiry boundary, and replacement timer.');

const {chipState}=await sourceImport('src/quests/compassMath.js');
const flexible={...q,kind:'hammock',arrivalTarget:{x:0,z:8,radius:10}};
assert.equal(chipState(flexible,{x:0,z:0,speed:3}).text,'Slow down!');
assert.equal(chipState(flexible,{x:0,z:0,speed:0}).text,'Stop here!');
assert.equal(chipState(flexible,{x:0,z:0,speed:0}).help,'Any free hammock works');
assert.equal(chipState({...q,kind:'porta_potty'},{x:0,z:0}).help,'Any free porta-potty works');
assert.equal(chipState({...q,kind:'main_stage'},{x:0,z:0}).help,'This destination');
console.log('PASS: flexible stop guidance uses accepted target, speed and facility copy.');

assert.equal(chipState({...q,kind:'hammock',dist:0},{x:0,z:0}).text,'Find a hammock');
assert.equal(chipState({...q,kind:'porta_potty',dist:0},{x:0,z:0,speed:4}).text,'Find a potty');
assert.equal(chipState({...flexible,arrivalBlocked:'unsafe_exit'},{x:0,z:0}).text,'Pull over nearby');
assert.equal(chipState(flexible,{x:0,z:0}).label,'Any hammock');
console.log('PASS: missing built facility and unsafe exit have actionable guidance.');

const {relativeBearing, relativeDirection}=await sourceImport('src/quests/compassMath.js');
for (const heading of [0, Math.PI / 2, Math.PI, 3 * Math.PI / 2, 17 * Math.PI]) {
  for (const [degrees,word] of [[0,'Ahead'],[90,'Right'],[180,'Behind'],[-90,'Left']]) {
    const bearing=heading-degrees*Math.PI/180;
    const target={x:-Math.sin(bearing)*100,z:-Math.cos(bearing)*100};
    assert.equal(relativeDirection(relativeBearing({x:0,z:0,heading},target)*180/Math.PI),word);
  }
}
for (const blocked of ['unsafe_exit','occupied','unreachable','activity_unavailable']) {
  const state=chipState({...flexible,arrivalBlocked:blocked},{x:0,z:0});
  assert.equal(state.showArrow,false); assert.equal(state.direction,'');
}
const pendingState=chipState({...q,phase:'handoff'},{x:0,z:0,speed:5});
assert.equal(pendingState.showArrow,false);assert.equal(pendingState.direction,'');
assert.equal(pendingState.text,'Passenger walking in');
let observed,disconnected=false,resizeHandler,removedHandler,measurements=0,toastTop;
globalThis.ResizeObserver=class {constructor(fn){this.fn=fn}observe(root){observed=root;this.fn()}disconnect(){disconnected=true}};
globalThis.addEventListener=(event,fn)=>{resizeHandler=fn};
globalThis.removeEventListener=(event,fn)=>{removedHandler=fn};
const measuredRoot=el();measuredRoot.parentElement={style:{setProperty(key,value){toastTop=value}}};
measuredRoot.getBoundingClientRect=()=>{measurements++;return {bottom:186}};
const measuredCompass=new QuestCompass(measuredRoot);
assert.equal(observed,measuredRoot);
measuredCompass.sync([q],{x:0,z:0});
resizeHandler();assert.equal(toastTop,'194px');
const reads=measurements;
for(let i=0;i<20;i++)measuredCompass.sync([q],{x:0,z:0,heading:i});
assert.equal(measurements,reads,'frame updates do not measure layout');
measuredCompass.setVisible(false);assert.equal(toastTop,'0px');
measuredCompass.dispose();assert.equal(disconnected,true);assert.equal(removedHandler,resizeHandler);
console.log('PASS: cardinal text at rotated headings, arrival/handoff suppression, measured toast offset and observer teardown.');

const occupiedAlternate={...q,kind:'hammock',x:500,z:500,dist:700,arrivalBlocked:'occupied',blockedTarget:{x:8,z:0,radius:10}};
const occupiedState=chipState(occupiedAlternate,{x:0,z:0});
assert.equal(occupiedState.text,'Occupied · try nearby');
assert.equal(occupiedState.inside,true);assert.equal(occupiedState.showArrow,false);
const distantOccupied=chipState(occupiedAlternate,{x:-30,z:0});
assert.equal(distantOccupied.direction,'Right');assert.equal(distantOccupied.text,'30 m');
let bubblePosition,hiddenBubble,shownBubble;
view.runtime.active=[{...q,id:9,riderId:'walker',phase:'handoff'}];
view.bubbles={has(){return false},show(id){shownBubble=id},hide(id){hiddenBubble=id},place(id,x,y,z){bubblePosition={id,x,y,z}}};
view.crowd.readPerson=(handle,out)=>{assert.equal(handle,'walker');Object.assign(out,{x:20,y:3,z:40,scale:1.2,hidden:false});return true};
view.update(.016);
assert.equal(shownBubble,9);assert.deepEqual(bubblePosition,{id:9,x:20,y:3+1.9*1.2,z:40});
view.crowd.readPerson=(handle,out)=>{out.hidden=true;return true};view.update(.016);assert.equal(hiddenBubble,9);
view.crowd.readPerson=()=>false;view.update(.016);assert.equal(hiddenBubble,9);
console.log('PASS: occupied alternate geometry and production handoff bubble follows passenger, hides for hidden/unavailable person.');

view.runtime.active=[occupiedAlternate];view.update(.016);
assert.equal(map.objectives.get('quest:1').x,8);assert.equal(map.objectives.get('quest:1').z,0);
console.log('PASS: occupied alternate map pin matches the compass target.');
