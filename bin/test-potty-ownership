#!/usr/bin/env node
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {runInNewContext} from 'node:vm';
import {Vector} from './test-support/sceneObjects.mjs';
import {makePeopleCrowd} from './test-support/peopleCrowd.js';
const activitySource=readFileSync(new URL('../src/people/pottyActivity.js',import.meta.url),'utf8').replace(/import[\s\S]*?from ['"][^'"]+['"];?/,'').replace('export class','class');
const PottyActivity=runInNewContext(activitySource+';PottyActivity',{POTTY_DOOR_STAND:2.4,POTTY_SEAT_BACK:.6,POTTY_SEAT_Y:.92,STINK_DUR:1.7});
const legacy=readFileSync(new URL('../verification/people/2026-10-26/legacy-potty-methods.js',import.meta.url),'utf8').replace('export class','class');
function fixture(scenario,old=true){
 let seed=1977,draws=0,writes=0,hides=0;
 const math=Object.assign(Object.create(Math),{random(){draws++;seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/2**32;}});
 const makeEntry=(id,x)=>({id,position:new Vector(x,0,0),potty:{outX:0,outZ:1,occupied:false,occupantId:null,locked:false,doorTarget:0,doorOpen:0,stinkTimer:0}});
 const first=makeEntry(1,0),second=makeEntry(2,6),entries=[first,second];
 if(scenario==='locked'){first.potty.occupied=true;first.potty.locked=true;first.potty.occupantId=77;}
 if(scenario==='peek'){first.potty.occupied=true;first.potty.occupantId=1;}
 const registry={entries:new Map(entries.map(e=>[e.id,e])),byKind:new Map([['porta_potty',new Set(entries.map(e=>e.id))]])};
 const Class=runInNewContext(legacy+';PottyOracle',{Math:math,registry,THREE:{MathUtils:{lerp:(a,b,t)=>(1-t)*a+t*b}},POTTY_SEARCH_R2:90*90,POTTY_LOCK_CHANCE:.7,POTTY_USE_MIN:6,POTTY_USE_MAX:13,POTTY_DOOR_STAND:2.4,POTTY_SEAT_BACK:.6,POTTY_SEAT_Y:.92,STINK_DUR:1.7,wrapAngle:a=>{while(a>Math.PI)a-=Math.PI*2;while(a< -Math.PI)a+=Math.PI*2;return a;}});
 let owner=new Class(),npc={idx:0,pos:new Vector(0,0,6),vel:new Vector(),target:new Vector(),yaw:0,energy:.8,state:'seeking_potty',stateTimer:30,pottyEntry:first,pottyTried:[1],pottyWait:0,useTimer:0,pottyPeeked:0,pottySitting:false,cheerTimer:0,exitPhase:0};
 let occupant={idx:1,state:'using_potty',pottyEntry:first,pottyPeeked:0};owner.npcs=[npc,occupant];
 let motion=npc,occupantMotion=occupant;
 if(!old){
  owner=makePeopleCrowd();const person=owner.spawn({pos:new Vector(0,0,6)});Object.assign(person,npc);npc=person;npc.state='idle';
  owner.bathrooms=new PottyActivity(owner,registry,{random:math.random});owner._inlineActivities=new Set([owner.bathrooms]);
  assert(owner.bathrooms.tryClaim(npc.personHandle));motion=owner.bathrooms.records.get(npc.personHandle).motion;
  if(scenario==='peek'){
   first.potty.occupied=false;first.potty.occupantId=null;
   occupant=owner.spawn({pos:new Vector()});Object.assign(occupant,{energy:.8,state:'idle'});
   assert(owner.bathrooms.tryClaim(occupant.personHandle));occupantMotion=owner.bathrooms.records.get(occupant.personHandle).motion;
   assert(owner.bathrooms._claimOccupancy(occupantMotion));occupantMotion.state='using_potty';occupantMotion.useTimer=10;owner.commitPottyMotion(occupantMotion.claim,occupantMotion);
  }
 }

 owner._writeMatrices=()=>writes++;owner._hideNpc=()=>hides++;
 return {owner,npc,occupant,motion,occupantMotion,entries,registry,get draws(){return draws;},get writes(){return writes;},get hides(){return hides;}};
}
for(const scenario of ['normal','locked','peek','unload','hit']){
 const before=fixture(scenario),after=fixture(scenario,process.argv.includes('--baseline')),phases=new Set();let triggered=false;
 const snapshot=f=>[f.npc.state,f.npc.stateTimer,f.npc.pos.x,f.npc.pos.z,f.npc.vel.x,f.npc.vel.y,f.npc.vel.z,f.npc.target.x,f.npc.target.z,f.npc.yaw,f.motion.pottyEntry?.id,Array.from(f.motion.pottyTried??[]),f.motion.pottyWait,f.npc.pottySitting,f.npc.cheerTimer,f.npc.seatY,f.occupantMotion.pottyPeeked,...f.entries.flatMap(e=>[e.potty.occupied,e.potty.occupantId,e.potty.locked,e.potty.doorTarget,e.potty.stinkTimer]),f.draws,f.writes,f.hides];
 for(let frame=0;frame<900;frame++){
  const trigger=!triggered&&before.npc.state==='using_potty'&&(scenario==='unload'||scenario==='hit');if(trigger)triggered=true;
  for(const f of [before,after]){
   // Identical place-side door inputs make the actor transition/publication
   // comparison independent of model rendering and its animation driver.
   for(const e of f.entries)e.potty.doorOpen=e.potty.doorTarget;
   if(trigger){if(scenario==='unload')f.registry.entries.delete(f.motion.pottyEntry.id);else f.owner.onPottyHit(f.motion.pottyEntry);}
   const n=f.npc;n.stateTimer-=.05;
   const method={seeking_potty:'_tickSeekingPotty',entering_potty:'_tickEnteringPotty',using_potty:'_tickUsingPotty',exiting_potty:'_tickExitingPotty',surprised_potty:'_tickSurprisedPotty'}[n.state];
   if(method)f.owner[method](.05,n);
  }
  phases.add(after.npc.state);assert.deepEqual(snapshot(after),snapshot(before));
 }
 if(scenario==='normal')for(const phase of ['seeking_potty','entering_potty','using_potty','exiting_potty','walking'])assert(phases.has(phase),phase);
 if(scenario==='peek'){assert(phases.has('surprised_potty'));assert.equal(after.occupantMotion.pottyPeeked,1.2);}
 if(scenario==='unload')assert(phases.has('idle'));if(scenario==='hit')assert(phases.has('fleeing'));
 console.log('PASS potty '+scenario+': 900 exact actor/resource/timer/publication/RNG frames against recorded place inputs.');
}
if(!process.argv.includes('--baseline')){
 const arrive=f=>{for(let i=0;i<400&&f.npc.state!=='using_potty';i++){for(const e of f.entries)e.potty.doorOpen=e.potty.doorTarget;f.npc.stateTimer-=.05;f.owner.bathrooms.tick(.05,f.npc.personHandle);}assert.equal(f.npc.state,'using_potty');};
 for(let cycle=0;cycle<2;cycle++){
  const f=fixture('normal',false),h=f.npc.personHandle;arrive(f);
  const record=f.owner.bathrooms.records.get(h),old=f.entries[0],replacement={...old,potty:{...old.potty,occupied:false,occupantId:null}};
  f.registry.entries.set(old.id,replacement);f.owner.bathrooms.tick(.05,h);
  assert(!old.potty.occupied);assert.equal(f.npc.state,'idle');assert.equal(f.owner.bathrooms.records.size,0);
  assert.equal(f.owner.commitPottyMotion(record.claim,{}),false);
  assert(f.owner.bathrooms.tryClaim(h));f.entries[0]=replacement;arrive(f);
  assert.equal(f.owner.bathrooms.onHit(old),false);assert(replacement.potty.occupied);
  f.owner.removePerson(h);assert(!replacement.potty.occupied);assert.equal(f.owner.bathrooms.records.size,0);
  const fresh=f.owner.spawn({pos:new Vector()});assert.notEqual(fresh.personHandle,h);assert.equal(f.owner.bathrooms.tryClaim(h),false);
  assert.equal(f.owner.commitPottyMotion(record.claim,{}),false);
 }
 {
  const f=fixture('normal',false);arrive(f);const h=f.npc.personHandle,record=f.owner.bathrooms.records.get(h);
  f.owner._releaseMarket=()=>{};f.owner._releaseCamp=()=>{};
  f.owner._abandonSeat(f.npc);assert(!f.entries[0].potty.occupied);assert(!f.owner.bathrooms.has(h));
  f.npc.state='idle';assert(f.owner.bathrooms.tryClaim(h));f.owner.bathrooms.dispose();assert.equal(f.owner.activityClaims.current.size,0);assert(!f.entries[0].potty.occupied);
  const draws=f.draws;assert.equal(f.owner.bathrooms.tick(.05,h),false);assert.equal(f.draws,draws);assert.equal(f.owner.commitPottyMotion(record.claim,{}),false);
 }
 console.log('PASS bathroom ownership: two exact-resource replacement/revisit cycles, stale movement/hit/slot rejection, interruption cleanup, person-first and activity-first teardown, inert stale ticks.');
}
