#!/usr/bin/env node
import assert from 'node:assert/strict';
import { Scene,Group,Vector3 } from 'three';
import { setSessionSeed } from '../src/rng.js';
import { setLandscapeVersion,landscapeCandidateInCell } from '../src/worldgen/landscapeCandidates.js';
import { setTerrainEnabled } from '../src/worldgen/terrain.js';
import { landscapeContextFor } from '../src/worldgen/landscapeContext.js';
import { createLandscapeAdmission } from '../src/worldgen/landscape.js';
globalThis.window={addEventListener(){},innerWidth:1280,innerHeight:800,__perfProfile:'low'};
globalThis.document={addEventListener(){},createElement:()=>({getContext:()=>new Proxy({createLinearGradient:()=>({addColorStop(){}})},{get:(o,k)=>k in o?o[k]:()=>{}})})};
const {registry}=await import('../src/registry.js'),{createMountainDistrictBuild}=await import('../src/landscape/districtBuild.js'),{forestDrumCircles,forestDrumMusic}=await import('../src/forests.js'),lights=await import('../src/contextLights.js');
const scene=new Scene(),baseline={entries:registry.entries.size,circles:forestDrumCircles.length,music:forestDrumMusic.length,lights:lights._debugRegistrySize()};
setSessionSeed(1977);setLandscapeVersion(2);setTerrainEnabled(true);
const candidate=landscapeCandidateInCell(-1,-1),context=landscapeContextFor(candidate),admit=createLandscapeAdmission(candidate,context);
while(!admit.done)admit.step({maxSteps:128,deadline:Infinity});assert.ok(admit.result.valid);
const options={plan:admit.result.plan,admission:admit.result.receipt};
function unpublished(){assert.equal(scene.children.length,0);assert.equal(registry.entries.size,baseline.entries);assert.equal(forestDrumCircles.length,baseline.circles);assert.equal(forestDrumMusic.length,baseline.music);assert.equal(lights._debugRegistrySize(),baseline.lights);}
try {
  assert.throws(()=>createMountainDistrictBuild(scene,context.surface,{...options,admission:{}}),/admission/);
  for(const stopAfter of [1,5,30,90,200]) {
    const job=createMountainDistrictBuild(scene,context.surface,options);
    for(let i=0;i<stopAfter&&!job.done;i++){job.step({maxSteps:1,deadline:Infinity});if(!job.done)unpublished();}
    if(job.done&&job.result.valid)job.result.owner.dispose();else job.cancel();unpublished();assert.equal(job.stats().done,true);
  }
  const stale=createMountainDistrictBuild(scene,context.surface,options);stale.step({maxSteps:8,deadline:Infinity});unpublished();setSessionSeed(42);assert.equal(stale.step().result.reason,'world-changed');unpublished();setSessionSeed(1977);
  const refreshedContext=landscapeContextFor(landscapeCandidateInCell(-1,-1)),refresh=createLandscapeAdmission(landscapeCandidateInCell(-1,-1),refreshedContext);while(!refresh.done)refresh.step({maxSteps:128,deadline:Infinity});assert.ok(refresh.result.valid);
  const current={plan:refresh.result.plan,admission:refresh.result.receipt},job=createMountainDistrictBuild(scene,refreshedContext.surface,current);
  assert.equal(job.step({deadline:0}).steps,0);let calls=0;
  while(!job.done){const slice=job.step({maxSteps:3,deadline:Infinity});assert.ok(slice.steps<=3);if(!job.done)unpublished();assert.ok(++calls<2000);}
  assert.ok(job.result.valid,job.result.message);assert.equal(scene.children.length,1);assert.ok(registry.entries.size>baseline.entries);assert.ok(forestDrumCircles.length>baseline.circles);
  for(const entry of registry.byChunk(current.plan.id))if(entry.kind==='campsite')for(const slot of entry.campSeats)if(slot.collider)assert.equal(registry.entries.get(slot.collider.id),slot.collider,'transferred seat claims keep the actual live collider object');
  const physicalEntries=[...registry.byChunk(current.plan.id)].filter(entry=>entry.physicalProp);
  assert.ok(physicalEntries.length>0,'published district has physical furniture');
  for(const entry of physicalEntries){
    const origin=registry.entries.get(entry.physicalProp.originRegistryId);
    assert.equal(origin?.kind,'campsite','every physical descriptor resolves its published live origin');
    assert.ok(origin.physicalProps.includes(entry.physicalProp),'parent and child keep the same descriptor reference');
  }
  const {createLivePhysics}=await import('../src/physics/liveWorld.js');
  const target=physicalEntries[0],cart={position:target.position.clone().add(new Vector3(0,0,5)),root:new Group(),heading:0,speed:0};
  const physics=await createLivePhysics({scene,registry,cart});
  try{
    for(let i=0;i<30&&!physics.owns(target);i++)physics.prepare(performance.now()+10000);
    assert.ok(physics.owns(target),`published district furniture enters main physics: ${JSON.stringify(physics.stats().lastReject)}`);
  }finally{physics.dispose();}
  assert.ok(job.result.owner.dispose());unpublished();
  // A failed/cancelled staged owner must not poison duplicate-owner admission.
  const failed=createMountainDistrictBuild(scene,refreshedContext.surface,{...current,failAfter:1});while(!failed.done)failed.step({maxSteps:4,deadline:Infinity});assert.equal(failed.result.reason,'build-rejected');unpublished();
  console.log('PASS staged production construction: current admission required, bounded steps/deadline, no partial scene/collider/light/audio publication, five cancellation depths, world-change cleanup, exact live seat/collider references, completed owner teardown and injected build rejection.',JSON.stringify(job.stats()));
} finally {setLandscapeVersion(1);setTerrainEnabled(false);}
