#!/usr/bin/env node
// Offline client diagnostics: node bin/test-leaderboard-client (Node 18+).
import assert from 'node:assert/strict';
import { test } from 'node:test';

const DIAGNOSTIC_KEY = 'zerble-board-diagnostics';
const LOCAL_KEY = 'zerble-leaderboard-local';
const ORIGIN = 'https://leaderboard.invalid';
const REQUEST_ID = '12345678-1234-4123-8123-123456789abc';
const TOKEN = { runId: 'private-run-id', startTs: 1720000000000, sig: 'private-signature' };
const NAME = 'Private Player';
const CAUSE = 'private-cause';
const NativeDate = Date;
let importId = 0;

function storage() {
  const values = new Map([['zerble-board-url', `${ORIGIN}///`]]);
  return {
    values,
    blocked: false,
    failedKeys: new Set(),
    getItem(key) {
      if (this.blocked) throw new Error('private-storage-error');
      return values.get(key) ?? null;
    },
    setItem(key, value) {
      if (this.blocked || this.failedKeys.has(key)) throw new Error('private-storage-error');
      values.set(key, String(value));
    },
  };
}

function response({ status = 204, outcome, id = REQUEST_ID, body } = {}) {
  const headers = new Headers();
  if (outcome) headers.set('X-Leaderboard-Outcome', outcome);
  if (id) headers.set('X-Leaderboard-Request-Id', id);
  return new Response(body === undefined ? null : JSON.stringify(body), { status, headers });
}

function deferred() {
  let resolve;
  const promise = new Promise((done) => { resolve = done; });
  return { promise, resolve };
}

// Drain fetch, Response.json(), and the client's unreturned .then() chain,
// without waiting for wall-clock timers or depending on a microtask count.
const settle = () => new Promise((resolve) => setImmediate(resolve));

async function browser(t, localStorage = storage()) {
  let now = TOKEN.startTs;
  let nextTimer = 0;
  const timers = new Map();
  const replies = [];
  const requests = [];
  const beacons = [];
  const unexpectedRequests = [];
  const window = new EventTarget();
  const document = new EventTarget();
  document.visibilityState = 'visible';
  const navigator = {
    sendBeacon(url, body) { beacons.push({ url, body: JSON.parse(body) }); return true; },
  };
  const globals = {
    localStorage, location: { hostname: 'localhost' }, window, document, navigator,
    Date: class extends NativeDate {
      constructor(...args) { super(...(args.length ? args : [now])); }
      static now() { return now; }
    },
    setTimeout(callback, delay) {
      const id = ++nextTimer;
      timers.set(id, { callback, at: now + delay });
      return id;
    },
    clearTimeout(id) { timers.delete(id); },
    async fetch(url, options = {}) {
      const request = { url, ...options, body: options.body ? JSON.parse(options.body) : undefined };
      requests.push(request);
      if (!replies.length) {
        unexpectedRequests.push(request);
        throw new Error(`Unexpected mocked fetch: ${url}`);
      }
      const reply = replies.shift();
      return typeof reply === 'function' ? reply(request) : reply;
    },
  };
  const originals = new Map(Object.keys(globals).map((key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)]));
  for (const [key, value] of Object.entries(globals)) {
    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
  }
  t.after(() => {
    for (const [key, descriptor] of originals) {
      if (descriptor) Object.defineProperty(globalThis, key, descriptor);
      else delete globalThis[key];
    }
    assert.deepEqual(unexpectedRequests, [], 'every request must have an explicit offline reply');
    assert.equal(replies.length, 0, 'all expected requests must be made');
    assert.equal(timers.size, 0, 'completed operations must clear their timeout');
  });
  const { Leaderboard: board } = await import(`../src/leaderboard.js?client-test=${++importId}`);
  return {
    board, localStorage, requests, beacons, replies, timers, window, document, navigator,
    events(event) { return board.diagnostics().events.filter((entry) => entry.event === event); },
    async advance(ms) {
      const target = now + ms;
      while (true) {
        const next = [...timers].filter(([, timer]) => timer.at <= target)
          .sort((a, b) => a[1].at - b[1].at)[0];
        if (!next) break;
        now = next[1].at;
        timers.delete(next[0]);
        next[1].callback();
        await settle();
      }
      now = target;
      await settle();
    },
    async start() {
      replies.push(response({ status: 200, outcome: 'started', body: TOKEN }));
      board.noteGameStart('festival');
      board.globalRunStart();
      await settle();
      assert.equal(board.diagnostics().tokenPresent, true);
    },
    assertPrivate() {
      const diagnosticCopies = [JSON.stringify(board.diagnostics()), localStorage.values.get(DIAGNOSTIC_KEY) || ''];
      for (const copy of diagnosticCopies) {
        for (const secret of [TOKEN.runId, TOKEN.sig, NAME, CAUSE, 'private-storage-error', 'private-network-error']) {
          assert.ok(!copy.includes(secret), `diagnostics must not contain ${secret}`);
        }
        for (const key of ['runId', 'sig', 'name', 'cause', 'body']) {
          assert.ok(!copy.includes(`"${key}":`), `diagnostics must not expose ${key}`);
        }
      }
    },
  };
}

function hangingFetch({ signal }) {
  return new Promise((resolve, reject) => {
    signal.addEventListener('abort', () => reject(new DOMException('Aborted', 'AbortError')), { once: true });
  });
}

test('leaderboard client diagnostics (offline, isolated browser globals)', async (t) => {
  // These subtests deliberately run serially because they replace browser globals.
  await t.test('Cruising start note and idle lifecycle events create no requests', async (t) => {
    const h = await browser(t);
    h.board.noteGameStart('cruising', true);
    h.board.globalHeartbeat({ score: 20, name: NAME });
    h.window.dispatchEvent(new Event('pagehide'));
    await h.advance(120000);
    assert.deepEqual(h.requests, []);
    assert.deepEqual(h.beacons, []);
    assert.deepEqual(h.events('game_started'), [{
      at: new NativeDate(TOKEN.startTs).toISOString(), event: 'game_started',
      mode: 'cruising', resumed: true, submitsScores: false,
    }]);
    assert.equal(h.board.diagnostics().tokenPresent, false);
  });

  await t.test('Festival start obtains a token without exposing it or player identity', async (t) => {
    const h = await browser(t);
    await h.start();
    assert.equal(h.board.diagnostics().endpoint, ORIGIN);
    assert.equal(h.board.diagnostics().version, 1);
    assert.equal(h.events('game_started')[0].submitsScores, true);
    assert.equal(h.events('token_received').length, 1);
    assert.equal(h.requests[0].url, `${ORIGIN}/run/start`);
    assert.equal(h.requests[0].method, 'POST');
    assert.equal(h.requests[0].headers['Content-Type'], 'application/json');
    assert.deepEqual(h.requests[0].body, {});
    assert.deepEqual(h.events('request_finished')[0], {
      at: new NativeDate(TOKEN.startTs).toISOString(), event: 'request_finished',
      path: '/run/start', status: 200, elapsedMs: 0, outcome: 'started', requestId: REQUEST_ID,
    });
    h.replies.push(response({ outcome: 'boards_written' }));
    h.board.globalFinal({ score: 42.9, day: 2, name: NAME, cause: CAUSE });
    await settle();
    assert.deepEqual(h.requests[1].body, { ...TOKEN, score: 42, day: 2, name: NAME, cause: CAUSE });
    assert.equal(h.board.diagnostics().finalAttempted, true);
    h.assertPrivate();
  });

  for (const outcome of ['boards_written', 'run_persisted', 'skipped_cadence', 'skipped_no_change', 'quarantined']) {
    await t.test(`heartbeat preserves Worker outcome ${outcome} and request ID`, async (t) => {
      const h = await browser(t);
      await h.start();
      h.replies.push(response({ outcome }));
      h.board.globalHeartbeat({ score: 23.8, day: 1, name: NAME });
      await settle();
      assert.deepEqual(h.requests[1].body, { ...TOKEN, score: 23, day: 1, name: NAME });
      const event = h.events('request_finished').at(-1);
      assert.equal(event.path, '/run/beat');
      assert.equal(event.status, 204);
      assert.equal(event.outcome, outcome);
      assert.equal(event.requestId, REQUEST_ID);
      h.board.globalHeartbeat({ score: 24, day: 1, name: NAME });
      await settle();
      assert.equal(h.requests.length, 2, 'client cadence suppression must not invent a server acknowledgement');
      assert.equal(h.events('request_finished').length, 2);
      h.assertPrivate();
    });
  }

  for (const [status, outcome, error, reason] of [
    [400, 'rejected', 'bad_sig', 'bad_sig'],
    [400, 'rejected', 'implausible_rate', 'implausible_rate'],
    [500, 'storage_error', 'storage_error', 'storage_error'],
    [500, 'internal_error', 'internal_error', 'internal_error'],
    [400, 'private-network-error', 'private-network-error', 'unspecified'],
  ]) {
    await t.test(`HTTP ${status} records sanitized outcome/reason (${error})`, async (t) => {
      const h = await browser(t);
      await h.start();
      h.replies.push(response({ status, outcome, body: { error } }));
      h.board.globalHeartbeat({ score: 10, day: 1, name: NAME });
      await settle();
      const event = h.events('request_finished').at(-1);
      assert.equal(event.status, status);
      assert.equal(event.outcome, outcome === 'private-network-error' ? 'rejected' : outcome);
      assert.equal(event.reason, reason);
      assert.equal(event.requestId, REQUEST_ID);
      assert.equal(h.events('request_failed').length, 0, 'HTTP errors are responses, not network failures');
      h.assertPrivate();
    });
  }

  await t.test('unreadable rejection body and invalid request ID are sanitized', async (t) => {
    const h = await browser(t);
    h.replies.push(new Response('private-network-error', {
      status: 500, headers: { 'X-Leaderboard-Request-Id': 'private-network-error' },
    }));
    h.board.globalRunStart();
    await settle();
    const event = h.events('request_finished')[0];
    assert.equal(event.reason, 'unreadable_response');
    assert.equal(event.outcome, 'rejected');
    assert.ok(!Object.hasOwn(event, 'requestId'));
    assert.equal(h.board.diagnostics().tokenPresent, false);
    h.assertPrivate();
  });

  for (const operation of ['start', 'heartbeat', 'final']) {
    for (const failure of ['network', 'timeout']) {
      await t.test(`${operation} ${failure} is swallowed and diagnosed`, async (t) => {
        const h = await browser(t);
        if (operation !== 'start') await h.start();
        h.replies.push(failure === 'timeout' ? hangingFetch : () => { throw new Error('private-network-error'); });
        const before = h.events('request_failed').length;
        if (operation === 'start') h.board.globalRunStart();
        else if (operation === 'heartbeat') h.board.globalHeartbeat({ score: 10, name: NAME });
        else h.board.globalFinal({ score: 10, name: NAME, cause: CAUSE });
        if (failure === 'timeout') {
          await h.advance(3999);
          assert.equal(h.events('request_failed').length, before);
          assert.equal(h.requests.at(-1).signal.aborted, false);
          await h.advance(1);
          assert.equal(h.requests.at(-1).signal.aborted, true);
        } else await settle();
        const event = h.events('request_failed').at(-1);
        assert.equal(event.path, `/run/${operation === 'heartbeat' ? 'beat' : operation === 'final' ? 'end' : 'start'}`);
        assert.equal(event.reason, failure === 'timeout' ? 'timeout' : 'network_or_cors');
        assert.equal(event.elapsedMs, failure === 'timeout' ? 4000 : 0);
        assert.equal(h.board.diagnostics().finalAttempted, operation === 'final');
        h.assertPrivate();
      });
    }
  }

  await t.test('old Worker without diagnostic headers is acknowledged_unverified, not proof of a write', async (t) => {
    const h = await browser(t);
    await h.start();
    h.replies.push(response({ id: null }));
    h.board.globalHeartbeat({ score: 20, name: NAME });
    await settle();
    const event = h.events('request_finished').at(-1);
    assert.equal(event.outcome, 'acknowledged_unverified');
    assert.ok(!Object.hasOwn(event, 'requestId'));
  });

  await t.test('a final before the token waits, then flushes once with the original score', async (t) => {
    const h = await browser(t);
    const start = deferred();
    h.replies.push(start.promise);
    h.board.globalRunStart();
    h.board.globalFinal({ score: 87.9, day: 3, name: NAME, cause: CAUSE });
    assert.equal(h.board.diagnostics().finalWaitingForToken, true);
    assert.equal(h.board.diagnostics().finalAttempted, false);
    assert.equal(h.events('final_waiting_for_token')[0].score, 87);
    assert.equal(h.requests.length, 1);
    h.replies.push(response({ outcome: 'boards_written' }));
    start.resolve(response({ status: 200, outcome: 'started', body: TOKEN }));
    await settle();
    assert.equal(h.requests.length, 2);
    assert.equal(h.requests[1].url, `${ORIGIN}/run/end`);
    assert.deepEqual(h.requests[1].body, { ...TOKEN, score: 87, day: 3, name: NAME, cause: CAUSE });
    assert.equal(h.board.diagnostics().finalWaitingForToken, false);
    assert.equal(h.board.diagnostics().finalAttempted, true);
    h.board.globalFinal({ score: 999 });
    h.board.globalHeartbeat({ score: 999 });
    assert.equal(h.requests.length, 2);
    h.assertPrivate();
  });

  for (const queued of [true, false, 'throws']) {
    await t.test(`beacon ${queued} records queueing only, never acknowledgement`, async (t) => {
      const h = await browser(t);
      await h.start();
      h.replies.push(response({ outcome: 'boards_written' }));
      h.board.globalHeartbeat({ score: 12, name: NAME });
      await settle();
      h.board.globalHeartbeat({ score: 13, name: NAME });
      const send = h.navigator.sendBeacon;
      h.navigator.sendBeacon = (...args) => {
        send(...args);
        if (queued === 'throws') throw new Error('private-network-error');
        return queued;
      };
      h.document.visibilityState = 'hidden';
      h.document.dispatchEvent(new Event('visibilitychange'));
      h.window.dispatchEvent(new Event('pagehide'));
      assert.equal(h.beacons.length, 1, 'visibility/pagehide burst must be deduplicated');
      assert.equal(h.beacons[0].url, `${ORIGIN}/run/beat`);
      assert.equal(h.beacons[0].body.score, 13, 'beacon uses the latest state even inside heartbeat cadence');
      assert.equal(h.events('beacon')[0].outcome, queued === true ? 'queued_unacknowledged' : 'not_queued');
      assert.ok(!Object.hasOwn(h.events('beacon')[0], 'requestId'));
      assert.equal(h.events('request_finished').length, 2, 'beacon must not fabricate a response');
      assert.equal(h.board.diagnostics().finalAttempted, false);
      await h.advance(10000);
      h.window.dispatchEvent(new Event('pagehide'));
      assert.equal(h.beacons.length, 2);
      h.assertPrivate();
    });
  }

  await t.test('failed local save is distinct from successful diagnostic persistence', async (t) => {
    const h = await browser(t);
    h.localStorage.failedKeys.add(LOCAL_KEY);
    assert.equal(h.board.recordLocal({ score: 42.9, days: 2, name: NAME }), 1);
    assert.deepEqual(h.board.localTop(), []);
    assert.equal(h.events('local_result')[0].persisted, false);
    assert.equal(h.events('local_result')[0].score, 42);
    assert.equal(h.events('local_result')[0].day, 2);
    assert.equal(h.board.diagnostics().historyPersisted, true);
    h.assertPrivate();
  });

  for (const range of ['daily', 'all', 'invalid-range']) {
    await t.test(`board read success normalizes range ${range} and keeps names out of diagnostics`, async (t) => {
      const h = await browser(t);
      h.replies.push(response({ status: 200, outcome: 'read', body: {
        entries: [{ name: NAME, score: 12.8, days: 2, date: '2026-10-10' }],
      } }));
      const rows = await h.board.fetchGlobal(range);
      assert.deepEqual(rows, [{ name: NAME, score: 12, days: 2, date: '2026-10-10' }]);
      const normalized = range === 'daily' ? 'daily' : 'all';
      assert.equal(h.requests[0].url, `${ORIGIN}/board?range=${normalized}`);
      assert.equal(h.events('board_read_started')[0].range, normalized);
      assert.deepEqual(h.events('board_read_finished')[0], {
        at: new NativeDate(TOKEN.startTs).toISOString(), event: 'board_read_finished',
        range: normalized, status: 200, entries: 1,
      });
      h.assertPrivate();
    });
  }

  for (const failure of ['http500', 'network', 'timeout', 'invalid-json', 'invalid-entries']) {
    await t.test(`board read ${failure} falls back to null with diagnostics`, async (t) => {
      const h = await browser(t);
      const replies = {
        http500: () => response({ status: 500, body: { error: 'storage_error' } }),
        network: () => { throw new Error('private-network-error'); },
        timeout: hangingFetch,
        'invalid-json': () => new Response('private-network-error'),
        'invalid-entries': () => response({ status: 200, body: { entries: null } }),
      };
      h.replies.push(replies[failure]);
      const pending = h.board.fetchGlobal('daily');
      if (failure === 'timeout') {
        await h.advance(3999);
        assert.equal(h.events('board_read_failed').length, 0);
        await h.advance(1);
      }
      assert.equal(await pending, null);
      const event = h.events(failure === 'invalid-entries' ? 'board_read_invalid' : 'board_read_failed')[0];
      assert.equal(event.range, 'daily');
      if (failure === 'http500') assert.equal(event.status, 500);
      else if (failure === 'invalid-entries') assert.equal(event.entries, 0);
      else assert.equal(event.reason, failure === 'timeout' ? 'timeout' : 'network_or_invalid_response');
      h.assertPrivate();
    });
  }

  const persistedStorage = storage();
  let retained;
  await t.test('history caps at the newest 100 events and returns defensive copies', async (t) => {
    const h = await browser(t, persistedStorage);
    for (let i = 0; i < 110; i++) {
      await h.advance(1);
      h.board.noteGameStart('cruising');
    }
    const events = h.board.diagnostics().events;
    assert.equal(events.length, 100);
    assert.equal(events[0].at, new NativeDate(TOKEN.startTs + 11).toISOString());
    retained = JSON.parse(persistedStorage.getItem(DIAGNOSTIC_KEY));
    assert.deepEqual(events, retained);
    events[0].event = 'mutated';
    events.push({ event: 'injected' });
    assert.deepEqual(h.board.diagnostics().events, retained);
  });

  await t.test('reload retains history, appends page_loaded, and still caps at 100', async (t) => {
    const h = await browser(t, persistedStorage);
    const events = h.board.diagnostics().events;
    assert.equal(events.length, 100);
    assert.deepEqual(events.slice(0, -1), retained.slice(1));
    assert.equal(events.at(-1).event, 'page_loaded');
    assert.equal(h.board.diagnostics().historyPersisted, true);
    assert.deepEqual(JSON.parse(persistedStorage.getItem(DIAGNOSTIC_KEY)), events);
    h.board.clearDiagnostics();
    assert.deepEqual(h.board.diagnostics().events.map((entry) => entry.event), ['history_cleared']);
    assert.deepEqual(JSON.parse(persistedStorage.getItem(DIAGNOSTIC_KEY)), h.board.diagnostics().events);
  });

  for (const saved of ['{broken-json', '{}', JSON.stringify(Array.from({ length: 150 }, (_, i) => ({ event: `old-${i}` })))]) {
    await t.test(`reload tolerates ${saved.startsWith('[') ? 'oversized' : 'invalid'} stored history`, async (t) => {
      const store = storage();
      store.setItem(DIAGNOSTIC_KEY, saved);
      const h = await browser(t, store);
      const events = h.board.diagnostics().events;
      assert.equal(events.length, saved.startsWith('[') ? 100 : 1);
      if (saved.startsWith('[')) assert.equal(events[0].event, 'old-51');
      assert.equal(events.at(-1).event, 'page_loaded');
    });
  }

  await t.test('blocked storage keeps a capped memory history and recovers on later writes', async (t) => {
    const store = storage();
    store.blocked = true;
    const h = await browser(t, store);
    assert.equal(h.board.diagnostics().historyPersisted, false);
    for (let i = 0; i < 110; i++) h.board.noteGameStart('cruising');
    h.board.recordLocal({ name: NAME, score: 4, days: 1 });
    assert.equal(h.board.diagnostics().events.length, 100);
    assert.equal(h.events('local_result')[0].persisted, false);
    assert.deepEqual(h.board.localTop(), []);
    assert.deepEqual(h.requests, []);
    store.blocked = false;
    h.board.noteGameStart('cruising');
    assert.equal(h.board.diagnostics().historyPersisted, true);
    assert.deepEqual(JSON.parse(store.getItem(DIAGNOSTIC_KEY)), h.board.diagnostics().events);
    h.assertPrivate();
  });

  await t.test('start timeout covers a stalled token response body', async (t) => {
    const h = await browser(t);
    h.replies.push(({ signal }) => {
      const res = response({ status: 200, outcome: 'started', body: TOKEN });
      res.json = () => hangingFetch({ signal });
      return res;
    });
    h.board.globalRunStart();
    h.board.globalFinal({ score: 20, name: NAME });
    await settle();
    await h.advance(4000);
    assert.equal(h.board.diagnostics().tokenPresent, false);
    assert.equal(h.board.diagnostics().finalWaitingForToken, true);
    assert.equal(h.events('request_failed').at(-1)?.reason, 'timeout',
      'a hung token body must time out instead of leaving the final waiting forever');
  });
});
